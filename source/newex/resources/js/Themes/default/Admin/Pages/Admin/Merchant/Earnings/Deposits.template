<admin-layout>
    <Head>
        <title>{{ $t('商户充值') }}</title>
    </Head>

    <div class="container mx-auto px-4 py-6">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">{{ $t('商户充值') }}</h1>
            <Link :href="route('admin.merchant.earnings')" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
                {{ $t('返回收益') }}
            </Link>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 border-blue-500">
                <p class="text-gray-500 text-sm">{{ $t('总充值笔数') }}</p>
                <p class="text-2xl font-bold text-blue-600">{{ stats.total_deposits }}</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 border-green-500">
                <p class="text-gray-500 text-sm">{{ $t('已确认') }}</p>
                <p class="text-2xl font-bold text-green-600">{{ stats.confirmed_deposits }}</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 border-purple-500">
                <p class="text-gray-500 text-sm">{{ $t('总金额') }}</p>
                <p class="text-2xl font-bold text-purple-600">{{ formatCurrency(stats.total_volume_usd) }}</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 border-yellow-500">
                <p class="text-gray-500 text-sm">{{ $t('待处理') }}</p>
                <p class="text-2xl font-bold text-yellow-600">{{ stats.pending_deposits }}</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-xl shadow-sm p-4 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('商户') }}</label>
                    <themed-select v-model="localFilters.merchant_id" class="w-full border rounded-lg px-3 py-2">
                        <option value="">{{ $t('全部商户') }}</option>
                        <option v-for="m in merchants" :key="m.id" :value="m.id">{{ m.business_name }}</option>
                    </themed-select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('状态') }}</label>
                    <themed-select v-model="localFilters.status" class="w-full border rounded-lg px-3 py-2">
                        <option value="">{{ $t('全部状态') }}</option>
                        <option value="detecting">{{ $t('检测中') }}</option>
                        <option value="confirming">{{ $t('确认中') }}</option>
                        <option value="confirmed">{{ $t('已确认') }}</option>
                        <option value="failed">{{ $t('失败') }}</option>
                        <option value="orphaned">{{ $t('孤块') }}</option>
                    </themed-select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('开始日期') }}</label>
                    <input type="date" v-model="localFilters.date_from" class="w-full border rounded-lg px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('结束日期') }}</label>
                    <input type="date" v-model="localFilters.date_to" class="w-full border rounded-lg px-3 py-2" />
                </div>
                <div class="flex items-end space-x-2">
                    <button @click="applyFilters" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                        {{ $t('筛选') }}
                    </button>
                    <button @click="clearFilters" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
                        {{ $t('清空') }}
                    </button>
                </div>
            </div>
        </div>

        <!-- Deposits Table -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('交易哈希') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('商户') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('金额') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('币种') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('地址') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('确认数') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('状态') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('归集') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('日期') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('操作') }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        <tr v-for="deposit in deposits.data" :key="deposit.id" class="hover:bg-gray-50">
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-1">
                                    <span class="font-mono text-xs truncate max-w-[100px]" :title="deposit.txn_hash">
                                        {{ deposit.txn_hash ? deposit.txn_hash.substring(0, 8) + '...' + deposit.txn_hash.slice(-6) : '-' }}
                                    </span>
                                    <button v-if="deposit.txn_hash" @click="doCopy(deposit.txn_hash)" class="text-gray-400 hover:text-gray-600">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                        </svg>
                                    </button>
                                    <a v-if="deposit.explorer_url" :href="deposit.explorer_url" target="_blank" class="text-blue-500 hover:text-blue-600">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                                        </svg>
                                    </a>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <Link v-if="deposit.merchant" :href="route('admin.merchant.merchants.show', deposit.merchant_id)" class="text-blue-600 hover:text-blue-700">
                                    {{ deposit.merchant.business_name }}
                                </Link>
                                <span v-else class="text-gray-400">-</span>
                            </td>
                            <td class="px-6 py-4">
                                <div>
                                    <span class="font-medium">{{ formatCrypto(deposit.amount_crypto, deposit.currency ? deposit.currency.symbol : '') }}</span>
                                    <span class="text-gray-400 text-sm block">{{ formatCurrency(deposit.amount_usd) }}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div v-if="deposit.currency" class="flex items-center space-x-1">
                                    <img v-if="deposit.currency.icon" :src="deposit.currency.icon" class="w-5 h-5 rounded-full" :alt="deposit.currency.symbol" />
                                    <span class="font-medium text-sm">{{ deposit.currency.symbol }}</span>
                                </div>
                                <span v-else class="text-gray-400">-</span>
                                <span v-if="deposit.deposit_address && deposit.deposit_address.network" class="text-gray-400 text-xs block">
                                    {{ deposit.deposit_address.network.name }}
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-1">
                                    <span class="font-mono text-xs truncate max-w-[100px]" :title="deposit.to_address">
                                        {{ deposit.to_address ? deposit.to_address.substring(0, 8) + '...' + deposit.to_address.slice(-6) : '-' }}
                                    </span>
                                    <button v-if="deposit.to_address" @click="doCopy(deposit.to_address)" class="text-gray-400 hover:text-gray-600">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-2">
                                    <span class="text-sm">{{ deposit.confirmations }}/{{ deposit.required_confirmations }}</span>
                                    <div class="w-16 bg-gray-200 rounded-full h-2">
                                        <div class="bg-blue-600 h-2 rounded-full" :style="{ width: Math.min(100, (deposit.confirmations / deposit.required_confirmations) * 100) + '%' }"></div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <span :class="['px-2 py-1 rounded-full text-xs font-medium', getStatusClass(deposit.status)]">
                                    {{ deposit.status }}
                                </span>
                                <div v-if="deposit.classification" class="mt-1">
                                    <span class="text-xs text-gray-500">{{ deposit.classification }}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div v-if="deposit.deposit_address">
                                    <span :class="['px-2 py-1 rounded-full text-xs font-medium', getSweepStatusClass(deposit)]">
                                        {{ getSweepStatusText(deposit) }}
                                    </span>
                                    <div v-if="deposit.deposit_address.swept_at" class="mt-1">
                                        <span class="text-xs text-gray-400">{{ formatDate(deposit.deposit_address.swept_at) }}</span>
                                    </div>
                                    <div v-if="deposit.deposit_address.sweep_txn_hash" class="mt-1">
                                        <span class="font-mono text-xs text-gray-400 truncate max-w-[80px] block" :title="deposit.deposit_address.sweep_txn_hash">
                                            {{ $t("TX:") }} {{ deposit.deposit_address.sweep_txn_hash.substring(0, 6) }}...
                                        </span>
                                    </div>
                                </div>
                                <span v-else class="text-gray-400">-</span>
                            </td>
                            <td class="px-6 py-4 text-gray-500 text-sm">
                                {{ formatDate(deposit.detected_at) }}
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-2">
                                    <Link v-if="deposit.invoice_id" :href="route('admin.merchant.invoices.show', deposit.invoice_id)" class="text-blue-600 hover:text-blue-700 text-sm">
                                        {{ $t('账单') }}
                                    </Link>
                                    <button 
                                        v-if="canRetrySweep(deposit)" 
                                        @click="retrySweep(deposit)" 
                                        :disabled="processing"
                                        :class="[
                                            'text-sm font-medium px-2 py-1 rounded',
                                            isRetryingAddress(deposit) 
                                                ? 'bg-gray-100 text-gray-400 cursor-not-allowed' 
                                                : processing 
                                                    ? 'bg-gray-100 text-gray-400 cursor-not-allowed'
                                                    : 'bg-orange-100 text-orange-600 hover:bg-orange-200'
                                        ]"
                                    >
                                        <span v-if="isRetryingAddress(deposit)">{{ $t('重试中...') }}</span>
                                        <span v-else>{{ $t('重试归集') }}</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr v-if="!deposits.data || deposits.data.length === 0">
                            <td colspan="10" class="px-6 py-8 text-center text-gray-500">{{ $t('未找到充值记录') }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div v-if="deposits.data && deposits.data.length > 0" class="px-6 py-4 border-t">
                <pagination :links="deposits.links" />
            </div>
        </div>
    </div>
</admin-layout>