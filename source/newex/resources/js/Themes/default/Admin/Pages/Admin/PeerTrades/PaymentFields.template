<app-layout>
    <h1 class="mb-8 font-bold text-3xl">{{ $t("支付字段 -") }} <Link class="text-indigo-500" :href="route('admin.peerPaymentMethods')">{{ paymentMethod.title }}</Link></h1>
    <div class="mb-6 flex justify-between items-center">
        <nav-button-link :href="route('admin.peerPaymentFields.create', paymentMethod.id)">
            <span>{{ $t("添加") }}</span>
            <span class="hidden md:inline">{{ $t(" 新字段") }}</span>
        </nav-button-link>
    </div>
    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full whitespace-no-wrap">
            <tr class="text-left font-bold">
                <th class="px-6 pt-6 pb-4">{{ $t("名称") }}</th>
                <th class="px-6 pt-6 pb-4">{{ $t("规则") }}</th>
                <th class="px-6 pt-6 pb-4">{{ $t("操作") }}</th>
            </tr>
            <tr v-for="paymentField in paymentFields.data" :key="paymentField.id" class="hover:bg-gray-100 focus-within:bg-gray-100">
                <td class="border-t">
                    <Link :href="route('admin.peerPaymentFields.edit', {'paymentMethod': paymentMethod.id, 'paymentField': paymentField.id})" class="px-6 py-4 flex items-center text-indigo-500">
                        {{ paymentField.title }}
                    </Link>
                </td>
                <td class="border-t">
                    <span class="px-6 py-4 flex items-center focus:text-indigo-500">
                        <badge class="mr-2" :type="paymentField.required ? 'green' : 'gray'">
                            {{ paymentField.required ? $t("必填") : $t("可选") }}
                        </badge>
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-6 py-4 flex items-center focus:text-indigo-500">
                        <nav-button-link class="mr-2" type="red" :href="route('admin.peerPaymentFields.edit', {'paymentMethod': paymentMethod.id, 'paymentField': paymentField.id})">
                            <span>{{ $t("编辑支付字段") }}</span>
                        </nav-button-link>
                    </span>
                </td>
            </tr>
            <tr v-if="paymentFields.data.length === 0">
                <td class="border-t px-6 py-2" colspan="100">{{ $t("没有找到支付字段。") }}</td>
            </tr>
        </table>
    </div>
    <pagination :links="paymentFields.links" />
</app-layout>
