<app-layout>
    <Head>
        <title>{{ $t('全部账单') }}</title>
    </Head>

    <div class="p-6">
        <h1 class="text-2xl font-bold text-gray-800 mb-6">{{ $t('全部账单') }}</h1>

        <!-- Filters -->
        <div class="bg-white rounded-xl shadow-sm p-4 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                <input v-model="form.search" type="text" :placeholder="$t('搜索 ID、邮箱、地址...')" class="px-4 py-2 border rounded-lg" @keyup.enter="applyFilters" />
                <themed-select v-model="form.status" class="px-4 py-2 border rounded-lg" @change="applyFilters">
                    <option value="">{{ $t('全部状态') }}</option>
                    <option v-for="status in statuses" :key="status.value" :value="status.value">{{ status.label }}</option>
                </themed-select>
                <input v-model="form.date_from" type="date" class="px-4 py-2 border rounded-lg" />
                <input v-model="form.date_to" type="date" class="px-4 py-2 border rounded-lg" />
                <div class="flex space-x-2">
                    <button @click="applyFilters" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">{{ $t('筛选') }}</button>
                    <button @click="resetFilters" class="px-4 py-2 border rounded-lg hover:bg-gray-50">{{ $t('重置') }}</button>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-lg p-4 text-center">
                <p class="text-2xl font-bold text-gray-800">{{ stats.total }}</p>
                <p class="text-sm text-gray-500">{{ $t('总数') }}</p>
            </div>
            <div class="bg-white rounded-lg p-4 text-center">
                <p class="text-2xl font-bold text-green-600">{{ stats.paid_today }}</p>
                <p class="text-sm text-gray-500">{{ $t('今日已支付') }}</p>
            </div>
            <div class="bg-white rounded-lg p-4 text-center">
                <p class="text-2xl font-bold text-blue-600">${{ Number(stats.volume_today_usd || 0).toLocaleString() }}</p>
                <p class="text-sm text-gray-500">{{ $t('今日金额') }}</p>
            </div>
            <div class="bg-white rounded-lg p-4 text-center">
                <p class="text-2xl font-bold text-yellow-600">{{ stats.pending }}</p>
                <p class="text-sm text-gray-500">{{ $t('待处理') }}</p>
            </div>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('账单') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('商户') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('金额') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('状态') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('创建时间') }}</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">{{ $t('操作') }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <tr v-for="invoice in invoices.data" :key="invoice.id" class="hover:bg-gray-50">
                        <td class="px-6 py-4">
                            <div class="font-mono text-sm">{{ invoice.id.substring(0, 8) }}...</div>
                            <div class="text-sm text-gray-500" v-if="invoice.external_id">{{ invoice.external_id }}</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="font-medium">{{ invoice.merchant.business_name }}</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="font-medium">${{ Number(invoice.amount_usd).toFixed(2) }}</div>
                            <div class="text-sm text-gray-500" v-if="invoice.supported_asset">{{ invoice.amount_crypto }} {{ invoice.supported_asset.currency.code }}</div>
                        </td>
                        <td class="px-6 py-4">
                            <span :class="['px-2 py-1 rounded-full text-xs font-medium', getStatusBadge(invoice.status)]">{{ invoice.status }}</span>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-500">{{ new Date(invoice.created_at).toLocaleString() }}</td>
                        <td class="px-6 py-4 text-right">
                            <a :href="route('admin.merchant.invoices.show', invoice.id)" class="text-blue-600 hover:text-blue-800">{{ $t('查看') }}</a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="mt-4 flex justify-center" v-if="invoices.links">
            <nav class="flex space-x-2">
                <a v-for="link in invoices.links" :key="link.label" :href="link.url" v-html="link.label" :class="['px-3 py-2 rounded', link.active ? 'bg-blue-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100']"></a>
            </nav>
        </div>
    </div>
</app-layout>