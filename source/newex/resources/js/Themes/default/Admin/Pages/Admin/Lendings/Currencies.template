<app-layout>
    <h1 class="mb-8 font-bold text-3xl">{{ $t("借贷中的抵押资产") }} <Link class="text-indigo-500" :href="route('admin.lendings')">{{ $t("借贷") }}</Link></h1>
    <div class="mb-6 flex justify-between items-center">
        <nav-button-link :href="route('admin.lendings.collateral.create', lending.id)">
            <span>{{ $t("添加") }}</span>
            <span class="hidden md:inline">{{ $t(" 新抵押资产") }}</span>
        </nav-button-link>
    </div>
    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full whitespace-no-wrap">
            <tr class="text-left font-bold">
                <th class="px-6 pt-6 pb-4">{{ $t("货币") }}</th>
                <th class="px-6 pt-6 pb-4">{{ $t("操作") }}</th>
            </tr>
            <tr v-for="collateral in currencies" :key="collateral.id" class="hover:bg-gray-100 focus-within:bg-gray-100">
                <td class="border-t">
                    <Link :href="route('admin.lendings.collateral.edit', {'lending': lending.id, 'currency': collateral.id})" class="px-6 py-4 flex items-center text-indigo-500">
                        {{ collateral.currency.name }} ({{ collateral.currency.symbol }})
                    </Link>
                </td>
                <td class="border-t">
                    <span class="px-6 py-4 flex items-center focus:text-indigo-500">
                        <nav-button-link class="mr-2" type="red" :href="route('admin.lendings.collateral.edit', {'lending': lending.id, 'currency': collateral.id})">
                            <span>{{ $t("编辑") }}</span>
                        </nav-button-link>
                    </span>
                </td>
            </tr>
            <tr v-if="currencies.length === 0">
                <td class="border-t px-6 py-2" colspan="100">{{ $t("没有找到抵押资产。") }}</td>
            </tr>
        </table>
    </div>
</app-layout>