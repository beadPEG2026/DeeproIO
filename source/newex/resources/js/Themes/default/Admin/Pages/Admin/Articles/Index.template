<app-layout>
    <h1 class="mb-8 font-bold text-3xl">{{ $t("文章") }}</h1>

    <div class="mb-6 flex justify-between items-center">
        <search-filter :filter="false" v-model="form.search" class="w-full max-w-md mr-4 focus:outline-none" @reset="reset">
            <label class="block text-gray-700">{{ $t("回收站：") }}</label>
            <themed-select v-model="form.trashed" class="mt-1 w-full form-select rounded">
                <option :value="null" />
                <option value="with">{{ $t("包含已删除") }}</option>
                <option value="only">{{ $t("仅显示已删除") }}</option>
            </themed-select>
        </search-filter>

        <nav-button-link :href="route('admin.articles.create')">
            <span>{{ $t("添加") }}</span>
            <span class="hidden md:inline">{{ $t(" 新文章") }}</span>
        </nav-button-link>
    </div>

    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full whitespace-no-wrap">
            <thead>
                <tr class="text-left font-bold">
                    <th class="px-6 pt-6 pb-4">{{ $t("标题") }}</th>
                    <th class="px-6 pt-6 pb-4">{{ $t("IP 可见范围") }}</th>
                    <th class="px-6 pt-6 pb-4">{{ $t("首页弹窗") }}</th>
                    <th class="px-6 pt-6 pb-4">{{ $t("状态") }}</th>
                    <th class="px-6 pt-6 pb-4">{{ $t("创建时间") }}</th>
                    <th class="px-6 pt-6 pb-4">{{ $t("修改时间") }}</th>
                </tr>
            </thead>

            <tbody>
                <tr
                    v-for="article in articles.data"
                    :key="article.id"
                    class="hover:bg-gray-100 focus-within:bg-gray-100"
                >
                    <td class="border-t">
                        <Link
                            :href="route('admin.articles.edit', article.id)"
                            class="px-6 py-4 flex items-center text-indigo-500"
                        >
                            {{ article.title }}
                        </Link>
                    </td>

                    <td class="border-t">
                        <span class="px-6 py-4 flex items-center text-gray-700">
                            {{ visibilityLabel(article) }}
                        </span>
                    </td>

                    <td class="border-t">
                        <span v-if="article.homepage_popup_enabled" class="px-6 py-4 flex flex-col text-gray-700">
                            <span class="text-green-600">{{ $t("已启用") }}</span>
                            <span v-if="popupExcludedCountries(article)" class="text-xs text-gray-500 mt-1">
                                {{ $t("排除：") }}{{ popupExcludedCountries(article) }}
                            </span>
                        </span>
                        <span v-else class="px-6 py-4 flex items-center text-gray-400">{{ $t("未启用") }}</span>
                    </td>

                    <td class="border-t">
                        <span class="px-6 py-4 flex items-center focus:text-indigo-500">
                            <badge class="mr-2" v-if="article.deleted_at" type="red">
                                {{ $t("已删除") }}
                            </badge>

                            <badge class="mr-2" v-if="!article.deleted_at" :type="article.status ? 'green' : 'gray'">
                                {{ article.status ? $t("启用") : $t("隐藏") }}
                            </badge>
                        </span>
                    </td>

                    <td class="border-t">
                        <span class="px-6 py-4 flex items-center text-gray-700">
                            {{ formatDate(article.created_at) }}
                        </span>
                    </td>

                    <td class="border-t">
                        <span class="px-6 py-4 flex items-center text-gray-700">
                            {{ formatDate(article.updated_at) }}
                        </span>
                    </td>
                </tr>

                <tr v-if="articles.data.length === 0">
                    <td class="border-t px-6 py-2" colspan="100">
                        {{ $t("未找到文章。") }}
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <pagination :links="articles.links" />
</app-layout>
