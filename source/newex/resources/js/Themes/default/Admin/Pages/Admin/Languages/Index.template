<app-layout>
    <h1 class="mb-8 font-bold text-3xl">{{ $t("语言") }}</h1>
    <div class="mb-6 flex justify-between items-center">
        <nav-button-link :href="route('admin.languages.create')">
            <span>{{ $t("添加") }}</span>
            <span class="hidden md:inline">{{ $t(" 新语言") }}</span>
        </nav-button-link>
    </div>
    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full whitespace-no-wrap">
            <tr class="text-left font-bold">
                <th class="px-6 pt-6 pb-4">{{ $t("名称") }}</th>
                <th class="px-6 pt-6 pb-4">{{ $t("语言标识") }}</th>
                <th class="px-6 pt-6 pb-4">{{ $t("状态") }}</th>
                <th class="px-6 pt-6 pb-4">{{ $t("默认站点语言") }}</th>
            </tr>
            <tr v-for="language in languages.data" :key="language.id" class="hover:bg-gray-100 focus-within:bg-gray-100">
                <td class="border-t">
                    <Link :href="route('admin.languages.edit', language.id)" class="px-6 py-4 flex items-center text-indigo-500">
                        {{ language.name }}
                    </Link>
                </td>
                <td class="border-t">
                    <Link :href="route('admin.languages.edit', language.id)" class="px-6 py-4 flex items-center">
                        {{ language.slug }}
                    </Link>
                </td>
                <td class="border-t">
                    <span class="px-6 py-4 flex items-center focus:text-indigo-500">
                        <badge class="mr-2" :type="language.status ? 'green' : 'gray'">
                            {{ language.status ? $t("启用") : $t("隐藏") }}
                        </badge>
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-6 py-4 flex items-center focus:text-indigo-500">
                        <badge v-if="language.is_default" class="mr-2" type="green">
                            {{ $t("默认") }}
                        </badge>
                    </span>
                </td>
            </tr>
            <tr v-if="languages.data.length === 0">
                <td class="border-t px-6 py-2" colspan="100">{{ $t("没有找到语言。") }}</td>
            </tr>
        </table>
    </div>
    <pagination :links="languages.links" />
</app-layout>