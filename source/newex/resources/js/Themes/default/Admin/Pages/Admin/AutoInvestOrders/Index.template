<app-layout>
    <admin-reports-tab section="auto_invest_orders"></admin-reports-tab>
    <h1 class="mt-10 mb-8 font-bold text-3xl">{{ $t("量化订单") }}</h1>

    <div class="mb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-8 gap-4 items-end">
            <div>
                <label class="block text-gray-700 mb-2">{{ $t("搜索") }}</label>
                <input
                    v-model="form.search"
                    class="w-full form-input rounded"
                    placeholder="用户邮箱/邀请码"
                />
            </div>

            <div>
                <label class="block text-gray-700 mb-2">{{ $t("类型") }}</label>
                <themed-select v-model="form.investment_type" class="w-full form-select rounded">
                    <option value="all">{{ $t("全部") }}</option>
                    <option value="fixed">{{ $t("定期") }}</option>
                    <option value="flexible">{{ $t("活期") }}</option>
                </themed-select>
            </div>

            <div>
                <label class="block text-gray-700 mb-2">{{ $t("状态") }}</label>
                <themed-select v-model="form.status" class="w-full form-select rounded">
                    <option value="all">{{ $t("全部") }}</option>
                    <option value="active">{{ $t("进行中") }}</option>
                    <option value="closed">{{ $t("已关闭") }}</option>
                    <option value="redeemed">{{ $t("已赎回") }}</option>
                </themed-select>
            </div>

            <div>
                <label class="block text-gray-700 mb-2">{{ $t("代币") }}</label>
                <input
                    v-model="form.currency"
                    class="w-full form-input rounded"
                    placeholder="USDT/BTC"
                />
            </div>

            <div>
                <label class="block text-gray-700 mb-2">{{ $t("用户ID") }}</label>
                <input
                    v-model="form.user_id"
                    class="w-full form-input rounded"
                    placeholder="用户ID"
                />
            </div>

            <div>
                <label class="block text-gray-700 mb-2">{{ $t("上级") }}</label>
                <input
                    v-model="form.superior"
                    class="w-full form-input rounded"
                    placeholder="上级邮箱/邀请码"
                />
            </div>

            <div>
                <label class="block text-gray-700 mb-2">{{ $t("订单号") }}</label>
                <input
                    v-model="form.order"
                    class="w-full form-input rounded"
                    placeholder="订单号"
                />
            </div>

            <div>
                <label class="block text-gray-700 mb-2">{{ $t("时间") }}</label>
                <div class="grid grid-cols-2 gap-2">
                    <input v-model="form.date_from" class="w-full form-input rounded" type="date" />
                    <input v-model="form.date_to" class="w-full form-input rounded" type="date" />
                </div>
            </div>
        </div>

        <button
            class="mt-4 text-sm text-gray-500 hover:text-gray-700 focus:text-indigo-500"
            type="button"
            @click="reset"
        >
            {{ $t("重置") }}
        </button>
    </div>
    <div class="bg-white rounded shadow overflow-x-auto">
        <table class="w-full whitespace-no-wrap">
            <tr class="text-left font-bold">
                <th class="px-3 pt-6 pb-4">{{ $t("订单") }}</th>
                <th class="px-3 pt-6 pb-4">{{ $t("用户") }}</th>
                <th class="px-3 pt-6 pb-4">{{ $t("上级") }}</th>
                <th class="px-3 pt-6 pb-4">{{ $t("类型") }}</th>
                <th class="px-3 pt-6 pb-4">{{ $t("本金/当前金额") }}</th>
                <th class="px-3 pt-6 pb-4">{{ $t("当前收益") }}</th>
                <th class="px-3 pt-6 pb-4">{{ $t("占用保证金") }}</th>
                <th class="px-3 pt-6 pb-4">{{ $t("周期/到期") }}</th>
                <th class="px-3 pt-6 pb-4">{{ $t("状态") }}</th>
                <th class="px-3 pt-6 pb-4">{{ $t("创建时间") }}</th>
                <th v-if="canManageAutoInvestOrders" class="px-3 pt-6 pb-4">{{ $t("操作") }}</th>
            </tr>

            <tr v-for="order in orders.data" :key="order.id" class="hover:bg-gray-100 focus-within:bg-gray-100">
                <td class="border-t">
                    <span class="px-3 py-2 flex flex-col">
                        <span>{{ order.order_no || order.order_id || order.id }}</span>
                        <span class="text-xs text-gray-500">{{ $t("ID:") }} {{ order.id }}</span>
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-3 py-2 flex flex-col">
                        <span>{{ showAccount(getOrderUserName(order)) }}</span>
                        <span class="text-xs text-gray-500">{{ $t("UID:") }} {{ order.user_id }}</span>
                        <span v-if="order.user_referral_code" class="text-xs text-gray-500">{{ $t("推荐码:") }} {{ order.user_referral_code }}</span>
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-3 py-2 flex flex-col">
                        <button
                            v-if="order.superior_count > 0"
                            type="button"
                            class="text-left text-indigo-500 hover:text-indigo-700 focus:outline-none"
                            @click="openSuperiorModal(order)"
                        >
                            {{ showAccount(getUserDisplayName(order.direct_superior)) }}
                        </button>
                        <span v-else>-</span>
                        <span v-if="order.superior_count > 0" class="text-xs text-gray-500">
                            {{ $t("共") }} {{ order.superior_count }} {{ $t("级，点击查看全部") }}
                        </span>
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-3 py-2 flex flex-col">
                        <span>{{ getTypeLabel(order) }}</span>
                        <span class="text-xs text-gray-500">{{ $t("利率:") }} {{ order.rate }}%</span>
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-3 py-2 flex flex-col">
                        <span>{{ formatAmount(order.principal_amount, order.currency_symbol) }}</span>
                        <span class="text-xs text-gray-500">{{ $t("当前:") }} {{ formatAmount(order.amount, order.currency_symbol) }}</span>
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-3 py-2 flex items-center">
                        {{ formatAmount(order.current_profit, order.currency_symbol) }}
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-3 py-2 flex flex-col">
                        <span>{{ formatAmount(order.used_margin, order.currency_symbol) }}</span>
                        <span class="text-xs text-gray-500">{{ $t("可返还:") }} {{ formatAmount(order.available_amount, order.currency_symbol) }}</span>
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-3 py-2 flex flex-col">
                        <span>{{ order.days }} {{ $t("天") }}</span>
                        <span class="text-xs text-gray-500">{{ order.matured_at || '-' }}</span>
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-3 py-2 flex items-center">
                        {{ getStatusLabel(order) }}
                    </span>
                </td>
                <td class="border-t">
                    <span class="px-3 py-2 flex items-center">
                        {{ order.created_at }}
                    </span>
                </td>
                <td v-if="canManageAutoInvestOrders" class="border-t">
                    <span class="px-3 py-2 flex flex-col gap-2">
                        <button
                            v-if="canManageAutoInvestOrders && order.can_release_margin"
                            type="button"
                            class="px-3 py-2 rounded bg-yellow-500 text-white hover:bg-yellow-600"
                            :class="{ 'opacity-75': isReleasingMargin(order) }"
                            :disabled="isReleasingMargin(order)"
                            @click="releaseMargin(order)"
                        >
                            {{ isReleasingMargin(order) ? $t("解除中...") : $t("解除占用") }}
                        </button>
                        <button
                            v-if="canManageAutoInvestOrders && order.can_close"
                            type="button"
                            class="px-3 py-2 rounded bg-red-500 text-white hover:bg-red-600"
                            :class="{ 'opacity-75': isClosing(order) }"
                            :disabled="isClosing(order)"
                            @click="closeOrder(order)"
                        >
                            {{ isClosing(order) ? $t("关闭中...") : $t("关闭订单") }}
                        </button>
                        <span v-if="!order.can_release_margin && !order.can_close" class="text-xs text-gray-500">
                            {{ order.release_margin_block_reason || order.close_block_reason || '-' }}
                        </span>
                    </span>
                </td>
            </tr>

            <tr v-if="orders.data.length === 0">
                <td class="border-t px-3 py-2" colspan="100">{{ $t("未找到量化订单。") }}</td>
            </tr>
        </table>
    </div>

    <pagination :links="orders.links" />

    <div v-if="selectedSuperiorOrder" class="fixed inset-0 z-50 flex items-center justify-center px-4">
        <div class="absolute inset-0 bg-black opacity-50" @click="closeSuperiorModal"></div>
        <div class="relative bg-white rounded shadow-xl w-full max-w-2xl max-h-screen overflow-y-auto">
            <div class="flex items-center justify-between border-b px-6 py-4">
                <div>
                    <h2 class="text-xl font-bold">{{ $t("全部上级") }}</h2>
                    <div class="text-sm text-gray-500 mt-1">
                        {{ $t("用户：") }}{{ showAccount(getOrderUserName(selectedSuperiorOrder)) }} {{ $t("/ UID:") }} {{ selectedSuperiorOrder.user_id }}
                    </div>
                </div>
                <button type="button" class="text-gray-500 hover:text-gray-700 text-2xl leading-none" @click="closeSuperiorModal">×</button>
            </div>

            <div class="p-6">
                <div v-for="superior in selectedSuperiorOrder.superiors" :key="superior.level + '-' + superior.id" class="border rounded p-4 mb-3">
                    <div class="flex items-start justify-between">
                        <div>
                            <div class="font-bold text-gray-800">
                                {{ $t("第") }} {{ superior.level }} {{ $t("级上级：") }}{{ showAccount(getUserDisplayName(superior)) }}
                            </div>
                            <div class="text-sm text-gray-600 mt-2">{{ $t("UID:") }} {{ superior.id }}</div>
                            <div class="text-sm text-gray-600">{{ $t("账号:") }} {{ showAccount(getUserAccount(superior)) }}</div>
                            <div v-if="superior.referral_code" class="text-sm text-gray-600">{{ $t("推荐码:") }} {{ superior.referral_code }}</div>
                            <div v-if="superior.leader_nickname" class="text-sm text-gray-600">{{ $t("组长昵称:") }} {{ superior.leader_nickname }}</div>
                            <div v-if="superior.created_at" class="text-sm text-gray-500">{{ $t("注册时间:") }} {{ superior.created_at }}</div>
                        </div>
                        <a
                            class="text-indigo-500 hover:text-indigo-700 text-sm"
                            :href="'/exchange-control-panel/users/' + superior.id + '/edit'"
                            target="_blank"
                        >
                            {{ $t("查看用户") }}
                        </a>
                    </div>
                </div>

                <div v-if="selectedSuperiorOrder.superiors.length === 0" class="text-gray-500">
                    {{ $t("该用户暂无上级。") }}
                </div>
            </div>
        </div>
    </div>
</app-layout>
