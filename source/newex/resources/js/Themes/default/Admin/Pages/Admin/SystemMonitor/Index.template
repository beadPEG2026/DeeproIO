<app-layout>
    <div class="overflow-x-auto">
        <!-- Header Section -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8">
            <div>
                <h1 class="font-bold text-3xl text-gray-800">
                    <font-awesome-icon icon="heartbeat" class="mr-2 text-indigo-500" />
                    {{ $t("系统监控") }}
                </h1>
                <p class="text-gray-500 mt-1">{{ $t("Deepro 平台运行状态与检查时间") }}</p>
            </div>
            <div class="flex items-center space-x-2 mt-4 md:mt-0">
                <a href="/exchange-control-panel/system-monitor/wallets" class="text-green-700">{{ $t("钱包运行检查 →") }}</a><span class="text-sm text-gray-500">v{{ version }}</span>
            </div>
        </div>

        <!-- Readonly Mode Banner -->
        <div v-if="summary.readonly_mode" class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6 rounded-r-lg shadow-sm">
            <div class="flex items-center">
                <font-awesome-icon icon="info-circle" class="text-blue-500 text-xl mr-3" />
                <div>
                    <span class="font-bold text-blue-700">{{ $t("演示模式已启用") }}</span>
                    <span class="text-blue-600 ml-2">{{ $t("- 所有服务均显示为在线。真实健康检查已禁用。") }}</span>
                </div>
            </div>
        </div>

        <operations-health :report="operationsHealth" />
        <h2 class="text-xl mb-3">{{ $t('Service checks') }} · {{ $t('Unknown') }}: {{ summary.not_checked || 0 }}</h2>
        <!-- Overall Status Banner -->
        <div :class="{
            'bg-green-50 border-green-400': statusColor === 'green',
            'bg-yellow-50 border-yellow-400': statusColor === 'yellow',
            'bg-orange-50 border-orange-400': statusColor === 'orange',
            'bg-red-50 border-red-400': statusColor === 'red'
        }" class="border-l-4 p-4 mb-6 rounded-r-lg shadow-sm">
            <div class="flex items-center justify-between flex-wrap gap-4">
                <div class="flex items-center">
                    <div :class="{
                        'bg-green-500': statusColor === 'green',
                        'bg-yellow-500': statusColor === 'yellow',
                        'bg-orange-500': statusColor === 'orange',
                        'bg-red-500': statusColor === 'red'
                    }" class="w-4 h-4 rounded-full mr-3 animate-pulse"></div>
                    <div>
                        <span class="font-bold text-lg" :class="{
                            'text-green-700': statusColor === 'green',
                            'text-yellow-700': statusColor === 'yellow',
                            'text-orange-700': statusColor === 'orange',
                            'text-red-700': statusColor === 'red'
                        }">{{ $t(overallStatus) }}</span>
                        <span class="text-gray-600 ml-2">- {{ onlinePercentage }}{{ $t("% 服务在线") }}</span>
                    </div>
                </div>
                <div class="text-sm text-gray-500">
                    {{ $t("最后检查时间：") }}<strong>{{ summary.last_checked || $t("从未") }}</strong>
                    <span v-if="summary.response_time" class="ml-2">({{ summary.response_time }}{{ $t("ms)") }}</span>
                </div>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
            <div class="bg-white rounded-lg shadow-sm p-4 border-t-4 border-blue-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-2xl font-bold text-gray-800">{{ summary.total }}</p>
                        <p class="text-sm text-gray-500">{{ $t("服务总数") }}</p>
                    </div>
                    <font-awesome-icon icon="layer-group" class="text-2xl text-blue-400" />
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm p-4 border-t-4 border-green-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-2xl font-bold text-green-600">{{ summary.online }}</p>
                        <p class="text-sm text-gray-500">{{ $t("在线") }}</p>
                    </div>
                    <font-awesome-icon icon="check-circle" class="text-2xl text-green-400" />
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm p-4 border-t-4 border-red-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-2xl font-bold text-red-600">{{ summary.offline }}</p>
                        <p class="text-sm text-gray-500">{{ $t("离线") }}</p>
                    </div>
                    <font-awesome-icon icon="times-circle" class="text-2xl text-red-400" />
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm p-4 border-t-4 border-orange-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-2xl font-bold text-orange-600">{{ summary.maintenance }}</p>
                        <p class="text-sm text-gray-500">{{ $t("维护中") }}</p>
                    </div>
                    <font-awesome-icon icon="wrench" class="text-2xl text-orange-400" />
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm p-4 border-t-4 border-yellow-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-2xl font-bold text-yellow-600">{{ summary.degraded }}</p>
                        <p class="text-sm text-gray-500">{{ $t("性能下降") }}</p>
                    </div>
                    <font-awesome-icon icon="exclamation-triangle" class="text-2xl text-yellow-400" />
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm p-4 border-t-4 border-purple-500">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-2xl font-bold text-purple-600">{{ summary.critical_offline }}</p>
                        <p class="text-sm text-gray-500">{{ $t("严重问题") }}</p>
                    </div>
                    <font-awesome-icon icon="exclamation-circle" class="text-2xl text-purple-400" />
                </div>
            </div>
        </div>

        <!-- Control Panel -->
        <div class="bg-white rounded-lg shadow-sm p-4 mb-6">
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
                <div class="flex flex-wrap items-center gap-3">
                    <!-- Category Filter -->
                    <div class="flex items-center">
                        <label class="text-sm text-gray-600 mr-2">{{ $t("筛选：") }}</label>
                        <themed-select v-model="selectedCategory" class="border-gray-300 rounded-md shadow-sm text-sm focus:border-indigo-300 focus:ring focus:ring-indigo-200 focus:ring-opacity-50">
                            <option value="all">{{ $t("全部分类") }}</option>
                            <option v-for="category in categories" :key="category" :value="category">{{ category }}</option>
                        </themed-select>
                    </div>

                    <!-- Auto Refresh Toggle -->
                    <div class="flex items-center">
                        <button @click="toggleAutoRefresh" :class="autoRefresh ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'" class="px-3 py-1.5 rounded-md text-sm font-medium flex items-center">
                            <font-awesome-icon :icon="autoRefresh ? 'sync' : 'pause'" :class="{'animate-spin': autoRefresh && loading}" class="mr-2" />
                            {{ $t("自动刷新") }} {{ autoRefresh ? $t("开启") : $t("关闭") }}
                        </button>
                    </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <!-- Alert Settings Button -->
                    <button @click="showAlertSettings = !showAlertSettings" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-md text-sm font-medium flex items-center transition-colors">
                        <font-awesome-icon icon="bell" class="mr-2" />
                        {{ $t("告警设置") }}
                    </button>

                    <!-- Test Alert Button -->
                    <button @click="sendTestAlert" :disabled="sendingTestAlert" class="px-4 py-2 bg-yellow-100 hover:bg-yellow-200 text-yellow-700 rounded-md text-sm font-medium flex items-center transition-colors disabled:opacity-50">
                        <font-awesome-icon :icon="sendingTestAlert ? 'spinner' : 'paper-plane'" :class="{'animate-spin': sendingTestAlert}" class="mr-2" />
                        {{ $t("测试告警") }}
                    </button>

                    <!-- Run Health Check Button -->
                    <button @click="testServices" :disabled="loading" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-md text-sm font-medium flex items-center transition-colors disabled:opacity-50">
                        <svg v-if="loading" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <font-awesome-icon v-else icon="play" class="mr-2" />
                        {{ $t("运行健康检查") }}
                    </button>
                </div>
            </div>

            <!-- Real-time Test Progress Panel -->
            <div v-if="loading && testProgress.is_running" class="mt-4 pt-4 border-t border-gray-200">
                <div class="bg-indigo-50 rounded-lg p-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center">
                            <div class="relative mr-3">
                                <svg class="animate-spin h-6 w-6 text-indigo-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-semibold text-indigo-900">{{ $t("健康检查进行中") }}</h4>
                                <p class="text-sm text-indigo-700">
                                    {{ $t("正在检查：") }}<span class="font-medium">{{ testProgress.current_service }}</span>
                                </p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-2xl font-bold text-indigo-600">{{ testProgress.progress }}%</span>
                            <p class="text-xs text-indigo-500">{{ testProgress.services_checked }} / {{ testProgress.services_total }} {{ $t("个服务") }}</p>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="w-full bg-indigo-200 rounded-full h-3 overflow-hidden">
                        <div class="bg-indigo-600 h-3 rounded-full transition-all duration-300 ease-out"
                             :style="{ width: testProgress.progress + '%' }">
                            <div class="h-full w-full bg-gradient-to-r from-indigo-600 via-indigo-500 to-indigo-600 animate-pulse"></div>
                        </div>
                    </div>

                    <!-- Service Categories Progress -->
                    <div class="mt-3 grid grid-cols-6 gap-2 text-xs">
                        <div class="text-center p-1 rounded" :class="testProgress.progress >= 25 ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-400'">
                            {{ $t("基础设施") }}
                        </div>
                        <div class="text-center p-1 rounded" :class="testProgress.progress >= 42 ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-400'">
                            {{ $t("交易") }}
                        </div>
                        <div class="text-center p-1 rounded" :class="testProgress.progress >= 70 ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-400'">
                            {{ $t("区块链") }}
                        </div>
                        <div class="text-center p-1 rounded" :class="testProgress.progress >= 81 ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-400'">
                            {{ $t("支付") }}
                        </div>
                        <div class="text-center p-1 rounded" :class="testProgress.progress >= 92 ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-400'">
                            {{ $t("安全") }}
                        </div>
                        <div class="text-center p-1 rounded" :class="testProgress.progress >= 100 ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-400'">
                            {{ $t("通知") }}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Alert Settings Panel -->
            <div v-if="showAlertSettings" class="mt-4 pt-4 border-t border-gray-200">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">
                    <font-awesome-icon icon="cog" class="mr-2" />
                    {{ $t("邮件告警配置") }}
                </h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t("启用告警") }}</label>
                        <themed-select v-model="alertForm.enabled" class="w-full border-gray-300 rounded-md shadow-sm text-sm">
                            <option :value="true">{{ $t("是 - 当服务离线时发送告警") }}</option>
                            <option :value="false">{{ $t("否 - 禁用告警邮件") }}</option>
                        </themed-select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t("冷却时间（分钟）") }}</label>
                        <input type="number" v-model="alertForm.cooldown" min="5" max="1440" class="w-full border-gray-300 rounded-md shadow-sm text-sm" placeholder="30" />
                        <p class="text-xs text-gray-500 mt-1">{{ $t("两次告警邮件之间的最短间隔时间") }}</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t("管理员邮箱") }}</label>
                        <input type="text" disabled :value="alertSettings.admin_email || $t(&quot;未配置&quot;)" class="w-full border-gray-300 rounded-md shadow-sm text-sm bg-gray-50" />
                        <p class="text-xs text-gray-500 mt-1">{{ $t("请在 设置 > 通知 中配置") }}</p>
                    </div>
                </div>
                <div class="mt-4 flex justify-end gap-2">
                    <button @click="showAlertSettings = false" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-md text-sm">
                        {{ $t("取消") }}
                    </button>
                    <button @click="saveAlertSettings" class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-md text-sm">
                        {{ $t("保存设置") }}
                    </button>
                </div>
                <div v-if="summary.last_alert_sent" class="mt-3 text-sm text-gray-500">
                    <font-awesome-icon icon="info-circle" class="mr-1" />
                    {{ $t("上次发送告警时间：") }}{{ formatTime(summary.last_alert_sent) }}
                </div>
            </div>
        </div>

        <!-- Services Grid by Category -->
        <div v-for="(categoryServices, categoryName) in servicesGrouped" :key="categoryName"
             v-show="selectedCategory === 'all' || selectedCategory === categoryName"
             class="mb-8">
            <div class="flex items-center mb-4">
                <div class="bg-indigo-100 p-2 rounded-lg mr-3">
                    <font-awesome-icon :icon="getCategoryIcon(categoryName)" class="text-indigo-600" />
                </div>
                <h2 class="text-xl font-bold text-gray-800">{{ categoryName }}</h2>
                <span class="ml-3 px-2 py-1 bg-gray-100 rounded-full text-xs text-gray-600">
                    {{ categoryServices.filter(s => s.status === 'online').length }}/{{ categoryServices.length }} {{ $t("在线") }}
                </span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
                <div v-for="service in categoryServices" :key="service.order"
                     :class="{
                         'border-green-200 bg-green-50': service.status === 'online',
                         'border-red-200 bg-red-50': service.status === 'offline',
                         'border-orange-200 bg-orange-50': service.status === 'maintenance',
                         'border-yellow-200 bg-yellow-50': service.status === 'degraded',
                         'border-gray-200 bg-gray-50': !service.status
                     }"
                     class="bg-white rounded-lg shadow-sm border-l-4 p-4 hover:shadow-md transition-shadow">
                    <div class="flex items-start justify-between">
                        <div class="flex items-start">
                            <div :class="{
                                'bg-green-100 text-green-600': service.status === 'online',
                                'bg-red-100 text-red-600': service.status === 'offline',
                                'bg-orange-100 text-orange-600': service.status === 'maintenance',
                                'bg-yellow-100 text-yellow-600': service.status === 'degraded',
                                'bg-gray-100 text-gray-400': !service.status
                            }" class="p-3 rounded-lg mr-3">
                                <font-awesome-icon :icon="service.icon" class="text-lg" />
                            </div>
                            <div>
                                <h3 class="font-semibold text-gray-800">{{ service.title }}</h3>
                                <p class="text-sm text-gray-500 mt-1">{{ service.description }}</p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <badge :type="getStatusBadgeType(service.status)">
                                {{ getStatusText(service.status) }}
                            </badge>
                            <badge :type="getPriorityBadgeType(service.priority)" class="text-xs">
                                {{ service.priority }}
                            </badge>
                        </div>
                        <span v-if="service.last_checked" class="text-xs text-gray-400">
                            {{ formatTime(service.last_checked) }}
                        </span>
                    </div>

                    <!-- Error Message -->
                    <div v-if="service.error && service.status === 'offline'" class="mt-3 p-2 bg-red-100 rounded text-xs text-red-700">
                        <font-awesome-icon icon="exclamation-triangle" class="mr-1" />
                        {{ service.error }}
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions for Stuck Withdrawals -->
        <div v-if="summary.stuck_withdrawals > 0" class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <font-awesome-icon icon="exclamation-triangle" class="text-yellow-600 text-xl mr-3" />
                    <div>
                        <h3 class="font-semibold text-yellow-800">{{ $t("检测到卡住的提现") }}</h3>
                        <p class="text-sm text-yellow-600">{{ summary.stuck_withdrawals }} {{ $t("笔提现处理时间已超过 1 小时") }}</p>
                    </div>
                </div>
                <Link :href="route('admin.reports.withdrawals')" class="px-4 py-2 bg-yellow-600 hover:bg-yellow-700 text-white rounded-md text-sm">
                    {{ $t("查看提现") }}
                </Link>
            </div>
        </div>

        <!-- Footer Info -->
        <div class="bg-gray-50 rounded-lg p-4 text-center text-sm text-gray-500">
            <p>
                <font-awesome-icon icon="shield-alt" class="mr-1" />
                {{ $t("系统监控持续追踪") }} {{ summary.total }} {{ $t("个服务，覆盖") }} {{ categories.length }} {{ $t("个分类。") }}
                <span v-if="alertSettings.enabled && alertSettings.admin_email">
                    {{ $t("当关键服务离线时，告警将发送到") }} <strong>{{ alertSettings.admin_email }}</strong>。
                </span>
                <span v-else class="text-yellow-600">
                    <font-awesome-icon icon="exclamation-circle" class="mr-1" />
                    {{ $t("邮件告警尚未配置。") }}
                </span>
            </p>
        </div>
    </div>
</app-layout>