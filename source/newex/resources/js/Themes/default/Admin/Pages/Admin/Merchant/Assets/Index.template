<app-layout>
    <Head>
        <title>{{ $t('商户币种') }}</title>
    </Head>

    <div class="p-6">
        <h1 class="text-2xl font-bold text-gray-800 mb-6">{{ $t('商户币种') }}</h1>

        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('币种') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('符号') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('确认数') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('手续费') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('商户状态') }}</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">{{ $t('操作') }}</th>
                    </tr>
                </thead>

                <tbody class="divide-y divide-gray-200">
                    <tr v-for="asset in assets" :key="asset.id" class="hover:bg-gray-50">
                        <td class="px-6 py-4">
                            <div class="font-medium">{{ asset.name }}</div>
                        </td>

                        <td class="px-6 py-4">
                            <span class="font-mono">{{ asset.symbol }}</span>
                        </td>

                        <td class="px-6 py-4">
                            {{ asset.merchant_confirmations || asset.min_deposit_confirmation }}
                        </td>

                        <td class="px-6 py-4">
                            {{ asset.merchant_fee_percent || 1 }}%
                        </td>

                        <td class="px-6 py-4">
                            <span :class="['px-2 py-1 rounded-full text-xs font-medium', asset.is_merchant ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800']">
                                {{ asset.is_merchant ? $t('启用') : $t('禁用') }}
                            </span>
                        </td>

                        <td class="px-6 py-4 text-right">
                            <button
                                @click="toggleAsset(asset)"
                                :class="['px-3 py-1 rounded text-sm', asset.is_merchant ? 'bg-red-100 text-red-700 hover:bg-red-200' : 'bg-green-100 text-green-700 hover:bg-green-200']">
                                {{ asset.is_merchant ? $t('禁用') : $t('启用') }}
                            </button>
                        </td>
                    </tr>
                </tbody>

            </table>
        </div>
    </div>
</app-layout>