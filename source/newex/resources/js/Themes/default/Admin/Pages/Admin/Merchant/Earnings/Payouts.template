<admin-layout>
    <Head>
        <title>{{ $t('商户付款管理') }}</title>
    </Head>

    <div class="container mx-auto px-4 py-6">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">{{ $t('商户付款') }}</h1>
            <Link :href="route('admin.merchant.dashboard')" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
                {{ $t('返回仪表盘') }}
            </Link>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 border-yellow-500">
                <p class="text-gray-500 text-sm">{{ $t('待处理') }}</p>
                <p class="text-2xl font-bold text-yellow-600">{{ formatCurrency(stats.pending_amount) }}</p>
                <p class="text-xs text-gray-400">{{ stats.pending_count }} {{ $t('请求') }}</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 border-blue-500">
                <p class="text-gray-500 text-sm">{{ $t('已批准') }}</p>
                <p class="text-2xl font-bold text-blue-600">{{ formatCurrency(stats.approved_amount) }}</p>
                <p class="text-xs text-gray-400">{{ stats.approved_count }} {{ $t('等待发送') }}</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 border-green-500">
                <p class="text-gray-500 text-sm">{{ $t('已完成') }}</p>
                <p class="text-2xl font-bold text-green-600">{{ formatCurrency(stats.completed_amount) }}</p>
                <p class="text-xs text-gray-400">{{ stats.completed_count }} {{ $t('付款') }}</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 border-orange-500">
                <p class="text-gray-500 text-sm">{{ $t('失败') }}</p>
                <p class="text-2xl font-bold text-orange-600">{{ formatCurrency(stats.failed_amount) }}</p>
                <p class="text-xs text-gray-400">{{ stats.failed_count }} {{ $t('需要处理') }}</p>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm border-l-4 border-purple-500">
                <p class="text-gray-500 text-sm">{{ $t('已收手续费') }}</p>
                <p class="text-2xl font-bold text-purple-600">{{ formatCurrency(stats.total_fees_collected) }}</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-xl shadow-sm p-4 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('商户') }}</label>
                    <themed-select v-model="localFilters.merchant_id" class="w-full border rounded-lg px-3 py-2">
                        <option value="">{{ $t('全部商户') }}</option>
                        <option v-for="m in merchants" :key="m.id" :value="m.id">{{ m.business_name }}</option>
                    </themed-select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('状态') }}</label>
                    <themed-select v-model="localFilters.status" class="w-full border rounded-lg px-3 py-2">
                        <option value="">{{ $t('全部状态') }}</option>
                        <option value="pending">{{ $t('待处理') }}</option>
                        <option value="approved">{{ $t('已批准') }}</option>
                        <option value="processing">{{ $t('处理中') }}</option>
                        <option value="completed">{{ $t('已完成') }}</option>
                        <option value="failed">{{ $t('失败') }}</option>
                        <option value="rejected">{{ $t('已拒绝') }}</option>
                    </themed-select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('开始日期') }}</label>
                    <input type="date" v-model="localFilters.date_from" class="w-full border rounded-lg px-3 py-2" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('结束日期') }}</label>
                    <input type="date" v-model="localFilters.date_to" class="w-full border rounded-lg px-3 py-2" />
                </div>
                <div class="flex items-end space-x-2">
                    <button @click="applyFilters" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                        {{ $t('筛选') }}
                    </button>
                    <button @click="clearFilters" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
                        {{ $t('清空') }}
                    </button>
                </div>
            </div>
        </div>

        <!-- Payouts Table -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('参考编号') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('商户') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('金额') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('币种 / 网络') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('地址') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('状态') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('日期') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('操作') }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        <tr v-for="payout in payouts.data" :key="payout.id" class="hover:bg-gray-50">
                            <td class="px-6 py-4">
                                <span class="font-mono text-sm font-medium">{{ payout.reference }}</span>
                            </td>
                            <td class="px-6 py-4">
                                <Link :href="route('admin.merchant.merchants.show', payout.merchant_id)" class="text-blue-600 hover:text-blue-700">
                                    {{ payout.merchant ? payout.merchant.business_name : '' }}
                                </Link>
                            </td>
                            <td class="px-6 py-4">
                                <div>
                                    <span class="font-medium">{{ formatCurrency(payout.amount_usd) }}</span>
                                    <span class="text-gray-400 text-sm block">{{ $t('净额') }}: {{ formatCurrency(payout.net_amount_usd) }}</span>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div v-if="payout.currency || payout.network">
                                    <div class="flex items-center space-x-1">
                                        <img v-if="payout.currency && payout.currency.icon" :src="payout.currency.icon" class="w-5 h-5 rounded-full" :alt="payout.currency.symbol" />
                                        <span class="font-medium text-sm">{{ payout.currency ? payout.currency.symbol : '-' }}</span>
                                    </div>
                                    <span class="text-gray-400 text-xs block">{{ payout.network ? payout.network.name : '-' }}</span>
                                </div>
                                <span v-else class="text-gray-400 text-sm">{{ $t('未选择') }}</span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-1">
                                    <span class="font-mono text-xs truncate max-w-[120px]" :title="payout.payout_address">
                                        {{ payout.payout_address.substring(0, 8) }}...{{ payout.payout_address.slice(-6) }}
                                    </span>
                                    <button @click="doCopy(payout.payout_address)" class="text-gray-400 hover:text-gray-600">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div>
                                    <span :class="['px-2 py-1 rounded-full text-xs font-medium', getStatusClass(payout.status)]">
                                        {{ payout.status }}
                                    </span>

                                    <!-- Rejection Reason -->
                                    <div v-if="payout.status === 'rejected' && payout.rejection_reason" class="mt-1">
                                        <p class="text-xs text-red-600 flex items-start">
                                            <svg class="w-3 h-3 mr-1 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                            </svg>
                                            <span class="truncate max-w-[150px]" :title="payout.rejection_reason">{{ payout.rejection_reason }}</span>
                                        </p>
                                    </div>

                                    <!-- Merchant Notes -->
                                    <div v-if="payout.merchant_notes" class="mt-1">
                                        <p class="text-xs text-gray-500 flex items-start">
                                            <svg class="w-3 h-3 mr-1 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M18 13V5a2 2 0 00-2-2H4a2 2 0 00-2 2v8a2 2 0 002 2h3l3 3 3-3h3a2 2 0 002-2zM5 7a1 1 0 011-1h8a1 1 0 110 2H6a1 1 0 01-1-1zm1 3a1 1 0 100 2h3a1 1 0 100-2H6z" clip-rule="evenodd"></path>
                                            </svg>
                                            <span class="truncate max-w-[150px]" :title="payout.merchant_notes">{{ payout.merchant_notes }}</span>
                                        </p>
                                    </div>

                                    <!-- Admin Notes (Internal) -->
                                    <div v-if="payout.admin_notes" class="mt-1">
                                        <p class="text-xs text-purple-600 flex items-start">
                                            <svg class="w-3 h-3 mr-1 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
                                            </svg>
                                            <span class="truncate max-w-[150px]" :title="payout.admin_notes">{{ payout.admin_notes }}</span>
                                        </p>
                                    </div>

                                    <!-- Error Message (Failed Payouts) -->
                                    <div v-if="payout.status === 'failed' && payout.error_message" class="mt-1">
                                        <p class="text-xs text-orange-600 flex items-start bg-orange-50 rounded p-1">
                                            <svg class="w-3 h-3 mr-1 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                            </svg>
                                            <span class="truncate max-w-[200px]" :title="payout.error_message">{{ payout.error_code }}: {{ payout.error_message }}</span>
                                        </p>
                                        <p v-if="payout.retry_count > 0" class="text-xs text-gray-400 mt-1">
                                            {{ $t('重试次数') }}: {{ payout.retry_count }}
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-gray-500 text-sm">{{ formatDate(payout.requested_at) }}</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-2 flex-wrap gap-1">
                                    <button v-if="payout.status === 'pending'" @click="openApproveModal(payout)" class="text-green-600 hover:text-green-700 text-sm font-medium">
                                        {{ $t('批准') }}
                                    </button>
                                    <button v-if="payout.status === 'pending'" @click="openRejectModal(payout)" class="text-red-600 hover:text-red-700 text-sm font-medium">
                                        {{ $t('拒绝') }}
                                    </button>
                                    <a :href="route('admin.merchant.payouts.show', payout.id)" class="text-gray-600 text-sm font-medium">{{ $t('Payout details') }}</a>
                                    <button v-if="payout.status === 'failed'" @click="retryPayout(payout)" :disabled="processing" class="text-orange-600 hover:text-orange-700 text-sm font-medium">
                                        {{ $t('重试') }}
                                    </button>
                                    <a v-if="payout.txn_hash" :href="payout.explorer_url" target="_blank" class="text-gray-600 hover:text-gray-700 text-sm">
                                        {{ $t('查看交易') }}
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <tr v-if="!payouts.data || payouts.data.length === 0">
                            <td colspan="8" class="px-6 py-8 text-center text-gray-500">{{ $t('未找到付款记录') }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div v-if="payouts.data && payouts.data.length > 0" class="px-6 py-4 border-t">
                <pagination :links="payouts.links" />
            </div>
        </div>
    </div>

    <!-- Approve Modal -->
    <div v-if="showApproveModal" class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen px-4">
            <div class="fixed inset-0 bg-black opacity-50" @click="closeModals"></div>
            <div class="relative bg-white rounded-xl shadow-xl max-w-md w-full p-6">
                <h3 class="text-xl font-semibold text-gray-800 mb-4">{{ $t('批准付款') }}</h3>
                <p class="text-gray-600 mb-4">
                    {{ $t('是否批准付款') }} <strong>{{ formatCurrency(selectedPayout ? selectedPayout.amount_usd : 0) }}</strong>
                    {{ $t('给') }} <strong>{{ selectedPayout && selectedPayout.merchant ? selectedPayout.merchant.business_name : '' }}</strong>?
                </p>

                <!-- Payout Details -->
                <div v-if="selectedPayout" class="bg-gray-50 rounded-lg p-3 mb-4 text-sm">
                    <div class="flex justify-between mb-1">
                        <span class="text-gray-500">{{ $t('净额') }}:</span>
                        <span class="font-medium">{{ formatCurrency(selectedPayout.net_amount_usd) }}</span>
                    </div>
                    <div class="flex justify-between mb-1">
                        <span class="text-gray-500">{{ $t('地址') }}:</span>
                        <span class="font-mono text-xs">{{ selectedPayout.payout_address ? selectedPayout.payout_address.substring(0, 12) + '...' : '-' }}</span>
                    </div>
                    <div v-if="selectedPayout.currency" class="flex justify-between">
                        <span class="text-gray-500">{{ $t('币种') }}:</span>
                        <span>{{ selectedPayout.currency ? selectedPayout.currency.symbol : '-' }} ({{ selectedPayout.network ? selectedPayout.network.name : '-' }})</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="flex items-center">
                        <input type="checkbox" v-model="sendImmediately" class="rounded border-gray-300 text-blue-600 shadow-sm focus:border-blue-300 focus:ring focus:ring-blue-200 focus:ring-opacity-50">
                        <span class="ml-2 text-sm text-gray-700">{{ $t('批准后立即发送加密货币') }}</span>
                    </label>
                    <p class="text-xs text-gray-500 mt-1 ml-6">{{ $t('如果不勾选，则该付款稍后需要手动处理。') }}</p>
                </div>

                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('备注（可选）') }}</label>
                    <textarea v-model="approveNotes" rows="2" class="w-full border rounded-lg px-3 py-2"></textarea>
                </div>
                <div class="flex justify-end space-x-2">
                    <button @click="closeModals" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
                        {{ $t('取消') }}
                    </button>
                    <button @click="approvePayout" :disabled="processing" class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 disabled:opacity-50">
                        {{ processing ? $t('处理中...') : (sendImmediately ? $t('批准并发送') : $t('仅批准')) }}
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Reject Modal -->
    <div v-if="showRejectModal" class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen px-4">
            <div class="fixed inset-0 bg-black opacity-50" @click="closeModals"></div>
            <div class="relative bg-white rounded-xl shadow-xl max-w-md w-full p-6">
                <h3 class="text-xl font-semibold text-gray-800 mb-4">{{ $t('拒绝付款') }}</h3>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('原因') }} *</label>
                    <textarea v-model="rejectReason" rows="2" class="w-full border rounded-lg px-3 py-2" required></textarea>
                </div>
                <div class="mb-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('内部备注（可选）') }}</label>
                    <textarea v-model="rejectNotes" rows="2" class="w-full border rounded-lg px-3 py-2"></textarea>
                </div>
                <div class="flex justify-end space-x-2">
                    <button @click="closeModals" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200">
                        {{ $t('取消') }}
                    </button>
                    <button @click="rejectPayout" :disabled="processing || !rejectReason" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 disabled:opacity-50">
                        {{ processing ? $t('处理中...') : $t('拒绝') }}
                    </button>
                </div>
            </div>
        </div>
    </div>

</admin-layout>
