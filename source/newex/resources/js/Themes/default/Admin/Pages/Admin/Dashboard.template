<app-layout>
    <div class="overflow-x-auto">
        <h1 class="mb-8 font-bold text-3xl">
            <Link class="text-indigo-400 hover:text-indigo-600" :href="route('admin.dashboard')">{{ $t("仪表盘") }}</Link>
        </h1>

        <operations-health :report="operationsHealth" />
        <div class="mb-6 bg-white rounded shadow-sm p-4">
            <div
                style="
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(220px, 260px));
                    gap: 14px;
                    align-items: end;
                "
            >
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t("开始时间") }}</label>
                    <input
                        v-model="form.start_date"
                        type="datetime-local"
                        step="1"
                        class="border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 rounded-md shadow-sm w-full"
                        @click="normalizeStartDateTime"
                        @change="normalizeStartDateTime"
                        @blur="normalizeStartDateTime"
                    />
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t("结束时间") }}</label>
                    <input
                        v-model="form.end_date"
                        type="datetime-local"
                        step="1"
                        class="border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 rounded-md shadow-sm w-full"
                        @click="normalizeEndDateTime"
                        @change="normalizeEndDateTime"
                        @blur="normalizeEndDateTime"
                    />
                </div>

                <div class="flex gap-2">
                    <button
                        type="button"
                        class="px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700"
                        @click="getList"
                    >
                        {{ $t("查询") }}
                    </button>

                    <button
                        type="button"
                        class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300"
                        @click="reset"
                    >
                        {{ $t("重置") }}
                    </button>
                </div>
            </div>
        </div>

        <div class="flex items-center text-gray-800 mb-10">
            <div class="w-full">
                <div class="grid grid-cols-12 gap-4">
                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <div class="relative" ref="groupDropdown">
                            <button
                                type="button"
                                class="w-full flex flex-row bg-white shadow-sm rounded p-4 cursor-pointer hover:shadow-md transition text-left"
                                @click="toggleGroupDropdown"
                            >
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-gray-100 text-gray-500">
                                    <font-awesome-icon size="2x" icon="users" />
                                </div>

                                <div class="flex flex-col flex-grow ml-4 min-w-0">
                                    <div class="text-lg font-bold text-gray-600 flex items-center justify-between">
                                        <span>{{ $t("组别") }}</span>
                                        <font-awesome-icon
                                            size="1x"
                                            class="text-gray-400 ml-2"
                                            :icon="groupDropdownOpen ? 'chevron-up' : 'chevron-down'"
                                        />
                                    </div>

                                    <div class="mt-1 font-bold text-lg text-gray-500 truncate">
                                        {{ activeGroupName }}
                                    </div>

                                    <div class="mt-1 text-xs text-gray-400">
                                        {{ $t("点击切换组长数据") }}
                                    </div>
                                </div>
                            </button>

                            <div
                                v-if="groupDropdownOpen"
                                class="absolute z-30 left-0 right-0 mt-2 bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden"
                            >
                                <button
                                    type="button"
                                    class="w-full px-4 py-3 text-left hover:bg-indigo-50 border-b border-gray-100"
                                    :class="{'bg-indigo-50': !form.team_user_id}"
                                    @click="selectGroup(null)"
                                >
                                    <div class="font-semibold text-gray-700">{{ $t("全部") }}</div>
                                    <div class="text-xs text-gray-400 mt-1">{{ $t("查看当前权限范围内全部数据") }}</div>
                                </button>

                                <div class="max-h-80 overflow-y-auto">
                                    <button
                                        v-for="group in groupLeaders"
                                        :key="group.id"
                                        type="button"
                                        class="w-full px-4 py-3 text-left hover:bg-indigo-50 border-b border-gray-100 last:border-b-0"
                                        :class="{'bg-indigo-50': Number(form.team_user_id) === Number(group.id)}"
                                        @click="selectGroup(group)"
                                    >
                                        <div class="font-semibold text-gray-700 truncate">
                                            {{ getGroupDisplayName(group) }}
                                        </div>

                                        <div class="text-xs text-gray-400 mt-1 truncate">
                                            {{ $t("ID:") }} {{ group.id }}
                                            <span v-if="group.leader_nickname"> {{ $t("/ 昵称：") }}{{ group.leader_nickname }}</span>
                                            <span v-if="!group.leader_nickname && group.account"> {{ $t("/ 账户：") }}{{ group.account }}</span>
                                        </div>

                                        <div class="text-xs text-indigo-400 mt-1" v-if="group.direct_count">
                                            {{ $t("直属人数：") }}{{ group.direct_count }}
                                        </div>
                                    </button>

                                    <div
                                        v-if="!groupLeaders || groupLeaders.length === 0"
                                        class="px-4 py-5 text-sm text-gray-400 text-center"
                                    >
                                        {{ $t("暂无可选择分组") }}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.users')">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-blue-100 text-blue-500">
                                    <font-awesome-icon size="2x" icon="user-plus" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("注册人数") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">{{ stats.users_d || 0 }}</div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.users', true, {dashboard_participants: 1})">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-indigo-100 text-indigo-500">
                                    <font-awesome-icon size="2x" icon="chart-line" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("做单人数") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">{{ stats.holdUserCount || 0 }}</div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.reports.deposits', true, {status: 'confirmed', first_only: 1})">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-yellow-100 text-yellow-500">
                                    <font-awesome-icon size="2x" icon="user-check" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("首充人数") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">{{ stats.scnum || 0 }}</div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.reports.deposits', true, {status: 'confirmed', first_only: 1})">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-yellow-100 text-yellow-500">
                                    <font-awesome-icon size="2x" icon="coins" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("首充金额") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">{{ stats.firstDepositAmount || 0 }}</div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.reports.deposits', true, {status: 'confirmed'})">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-green-100 text-green-500">
                                    <font-awesome-icon size="2x" icon="list-ol" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("入金笔数") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">
                                        {{ stats.depositCount || stats.deposit_count || stats.cryptoDepositCount || 0 }}
                                    </div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.reports.deposits', true, {status: 'confirmed'})">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-green-100 text-green-500">
                                    <font-awesome-icon size="2x" icon="arrow-down" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("入金金额") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">{{ stats.cryptoDeposits || 0 }}</div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.reports.withdrawals', true, {type: 'coin'})">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-red-100 text-red-500">
                                    <font-awesome-icon size="2x" icon="list-ol" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("出金笔数") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">
                                        {{ stats.withdrawalCount || stats.withdrawal_count || stats.cryptoWithdrawalCount || 0 }}
                                    </div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.reports.withdrawals', true, {type: 'coin'})">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-red-100 text-red-500">
                                    <font-awesome-icon size="2x" icon="arrow-up" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("出金金额") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">{{ stats.cryptoWithdrawals || 0 }}</div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.users', false)">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-blue-100 text-blue-500">
                                    <font-awesome-icon size="2x" icon="users" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("团队总人数") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">{{ stats.users || 0 }}</div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.reports.withdrawals', false, {type: 'coin'})">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-indigo-100 text-indigo-500">
                                    <font-awesome-icon size="2x" icon="balance-scale" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("存取差") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">{{ stats.ctc || 0 }}</div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>

                    <div class="col-span-12 sm:col-span-6 2xl:col-span-3">
                        <Link :href="reportLink('admin.reports.wallets', false)">
                            <div class="flex flex-row bg-white cursor-pointer shadow-sm rounded p-4">
                                <div class="flex items-center justify-center flex-shrink-0 h-16 w-16 rounded-xl bg-orange-100 text-orange-500">
                                    <font-awesome-icon size="2x" icon="wallet" />
                                </div>
                                <div class="flex flex-col flex-grow ml-4">
                                    <div class="text-lg font-bold text-gray-600">{{ $t("客户余额") }}</div>
                                    <div class="mt-1 font-bold text-lg text-gray-500">{{ stats.totalUsdBalance || 0 }}</div>
                                </div>
                                <div class="flex flex-col ml-4">
                                    <font-awesome-icon size="1x" class="text-gray-400" icon="external-link-alt" />
                                </div>
                            </div>
                        </Link>
                    </div>
                </div>
            </div>
        </div>
    </div>
</app-layout>
