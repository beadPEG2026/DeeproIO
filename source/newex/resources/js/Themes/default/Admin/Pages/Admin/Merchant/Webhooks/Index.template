<app-layout>
    <Head>
        <title>{{ $t('Webhook 管理') }}</title>
    </Head>

    <div class="p-6">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">{{ $t('Webhook 管理') }}</h1>
            <a :href="route('admin.merchant.webhooks.dead-letters')" class="px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700">
                {{ $t('死信队列') }}
            </a>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-5 gap-4 mb-6">
            <div class="bg-white rounded-xl p-4 shadow-sm">
                <div class="text-sm text-gray-500">{{ $t('总数') }}</div>
                <div class="text-2xl font-bold">{{ stats.total }}</div>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm">
                <div class="text-sm text-gray-500">{{ $t('待处理') }}</div>
                <div class="text-2xl font-bold text-yellow-600">{{ stats.pending }}</div>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm">
                <div class="text-sm text-gray-500">{{ $t('等待重试') }}</div>
                <div class="text-2xl font-bold text-orange-600">{{ stats.pending_retry }}</div>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm">
                <div class="text-sm text-gray-500">{{ $t('已送达') }}</div>
                <div class="text-2xl font-bold text-green-600">{{ stats.delivered }}</div>
            </div>
            <div class="bg-white rounded-xl p-4 shadow-sm">
                <div class="text-sm text-gray-500">{{ $t('失败') }}</div>
                <div class="text-2xl font-bold text-red-600">{{ stats.failed }}</div>
            </div>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-xl p-4 shadow-sm mb-6">
            <div class="flex flex-wrap gap-4 items-end">
                <div class="flex-1 min-w-[150px]">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('状态') }}</label>
                    <themed-select v-model="filter.status" class="w-full px-4 py-2 border rounded-lg">
                        <option v-for="opt in statusOptions" :key="opt.value" :value="opt.value">{{ opt.label }}</option>
                    </themed-select>
                </div>
                <div class="flex-1 min-w-[150px]">
                    <label class="block text-sm font-medium text-gray-700 mb-1">{{ $t('事件类型') }}</label>
                    <input v-model="filter.event_type" type="text" :placeholder="$t(&quot;e.g. invoice.paid&quot;)" class="w-full px-4 py-2 border rounded-lg" />
                </div>
                <div class="flex gap-2">
                    <button @click="applyFilters" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                        {{ $t('筛选') }}
                    </button>
                    <button @click="clearFilters" class="px-4 py-2 border rounded-lg hover:bg-gray-50">
                        {{ $t('清空') }}
                    </button>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('ID') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('商户') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('事件') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('状态') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('尝试次数') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('最后错误') }}</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">{{ $t('创建时间') }}</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">{{ $t('操作') }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <tr v-for="webhook in webhooks.data" :key="webhook.id" class="hover:bg-gray-50">
                        <td class="px-6 py-4">
                            <div class="text-xs font-mono text-gray-500">{{ webhook.id.substring(0, 8) }}...</div>
                        </td>
                        <td class="px-6 py-4">
                            <div class="font-medium">{{ webhook.merchant ? webhook.merchant.business_name : 'N/A' }}</div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-1 bg-gray-100 rounded text-sm">{{ webhook.event_type }}</span>
                        </td>
                        <td class="px-6 py-4">
                            <span :class="['px-2 py-1 rounded text-sm', getStatusClass(webhook.status)]">
                                {{ webhook.status }}
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <span :class="webhook.attempt_count >= webhook.max_attempts ? 'text-red-600 font-bold' : ''">
                                {{ webhook.attempt_count }}/{{ webhook.max_attempts }}
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm text-red-600 truncate max-w-xs" :title="webhook.last_failure_reason">
                                {{ webhook.last_failure_reason || '-' }}
                            </div>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-500">
                            {{ formatDate(webhook.created_at) }}
                        </td>
                        <td class="px-6 py-4 text-right">
                            <button
                                v-if="webhook.status !== 'delivered'"
                                @click="retryWebhook(webhook)"
                                :disabled="retryingId === webhook.id"
                                class="text-blue-600 hover:text-blue-800 disabled:opacity-50">
                                {{ retryingId === webhook.id ? $t('重试中...') : $t('重试') }}
                            </button>
                            <span v-else class="text-green-600">{{ $t('已送达') }}</span>
                        </td>
                    </tr>
                    <tr v-if="webhooks.data && webhooks.data.length === 0">
                        <td colspan="8" class="px-6 py-8 text-center text-gray-500">
                            {{ $t('未找到 Webhook 记录') }}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="mt-4 flex justify-center" v-if="webhooks.links">
            <nav class="flex space-x-2">
                <a v-for="link in webhooks.links" :key="link.label" :href="link.url" v-html="link.label"
                   :class="['px-3 py-2 rounded', link.active ? 'bg-blue-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100']"></a>
            </nav>
        </div>
    </div>
</app-layout>