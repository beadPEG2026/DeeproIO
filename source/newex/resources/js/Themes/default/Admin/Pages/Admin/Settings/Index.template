<app-layout>
    <h1 class="mb-8 font-bold text-3xl">
        {{ $t("Deepro 平台设置") }}
    </h1>

    <div class="tabs tabs-main">
        <div class="tabs-left">
            <div class="tabs-nav">
                <button type="button" @click="setSection('general')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'general'}">
                    <h4>{{ $t("网站设置") }}</h4>
                </button>
                <button type="button" @click="setSection('trade')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'trade'}">
                    <h4>{{ $t("交易") }}</h4>
                </button>
                <button type="button" @click="setSection('mail')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'mail'}">
                    <h4>{{ $t("邮件") }}</h4>
                </button>
                <button type="button" @click="setSection('notification')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'notification'}">
                    <h4>{{ $t("通知") }}</h4>
                </button>
                <button type="button" @click="setSection('ethereum')" class="tabs-nav__item" :class="{'tabs-nav__active':
                    section == 'ethereum' ||
                    section == 'bnb' ||
                    section == 'tron' ||
                    section == 'bitcoin' ||
                    section == 'polygon' || section == 'xlayer' ||
                    section == 'solana' ||
                    section == 'ripple' ||
                    section == 'ton' ||
                    section == 'customtoken'
                }">
                    <h4>{{ $t("网络") }}</h4>
                </button>
                <button type="button" @click="setSection('stripe')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'stripe'}">
                    <h4>{{ $t("Stripe") }}</h4>
                </button>
                <button type="button" @click="setSection('recaptcha')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'recaptcha'}">
                    <h4>{{ $t("Recaptcha") }}</h4>
                </button>
                <button type="button" @click="setSection('unlimit')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'unlimit'}">
                    <h4>Unlimit</h4>
                </button>
                <button type="button" @click="setSection('social')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'social'}">
                    <h4>{{ $t("社交") }}</h4>
                </button>
            </div>
        </div>
    </div>

    <div class="tabs tabs-main tabs-submain" v-if="
          section == 'ethereum' ||
          section == 'bnb' ||
          section == 'tron' ||
          section == 'bitcoin' ||
          section == 'polygon' || section == 'xlayer' ||
          section == 'solana' ||
          section == 'ripple' ||
          section == 'ton' ||
          section == 'customtoken'
    ">
        <div class="tabs-left">
            <div class="tabs-nav">
                <button type="button" @click="setSection('ethereum')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'ethereum'}">
                    <h4>{{ $t("Ethereum & ERC") }}</h4>
                </button>
                <button type="button" @click="setSection('bnb')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'bnb'}">
                    <h4>{{ $t("BNB & BEP") }}</h4>
                </button>
                <button type="button" @click="setSection('tron')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'tron'}">
                    <h4>{{ $t("TRON & TRC") }}</h4>
                </button>
                <button type="button" @click="setSection('bitcoin')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'bitcoin'}">
                    <h4>Bitcoin (BTC)</h4>
                </button>
                <button type="button" @click="setSection('polygon')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'polygon'}">
                    <h4>{{ $t("Polygon") }}</h4>
                </button>                <button type="button" @click="setSection('xlayer')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'xlayer'}">
                    <h4>{{ $t("X Layer") }}</h4>
                </button>
                <button type="button" @click="setSection('solana')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'solana'}">
                    <h4>{{ $t("Solana") }}</h4>
                </button>
                <button type="button" @click="setSection('ripple')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'ripple'}">
                    <h4>{{ $t("Ripple XRP") }}</h4>
                </button>

                <button type="button" @click="setSection('ton')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'ton'}">
                    <h4>TON</h4>
                </button>
                <button type="button" @click="setSection('customtoken')" class="tabs-nav__item" :class="{'tabs-nav__active': section == 'customtoken'}">
                    <h4>{{ $t("自定义区块链") }}</h4>
                </button>
            </div>
        </div>
    </div>

    <div v-if="Object.keys(validationErrors).length !== 0" class="pb-8 w-full">
        <div class="bg-red-400 border border-red-400 text-white px-4 py-3 rounded relative" role="alert">
            <strong class="font-bold">{{ $t("表单验证错误") }}</strong>
            <span class="block">
                <p v-for="error in validationErrors">
                    {{ error }}
                </p>
            </span>
        </div>
    </div>

    <div v-if="section == 'general'" class="bg-white rounded shadow overflow-hidden w-full">
        <form @submit.prevent="submit('general')">
            <div class="p-8 -mr-6 -mb-8 flex flex-wrap">

                <div class="pr-6 pb-8 w-full">
                    <div class="font-weight-bold text-xl border-b mb-2 pb-4 font-medium">{{ $t("常规设置") }}</div>
                </div>

                <text-input v-model="general.name" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;平台名称&quot;)" :placeholder="$t(&quot;Deepro&quot;)" />

                <empty-column></empty-column>

                <div class="pr-6 pb-8 w-full lg:w-1/2">
                    <label class="form-label block mr-2 mb-3">{{ $t("启用维护模式") }}</label>
                    <t-toggle v-model="general.maintenance_status" />
                </div>

                <div class="pr-6 pb-8 w-full lg:w-1/2">
                    <label class="form-label block mr-2 mb-3">{{ $t("启用KYC") }}</label>
                    <t-toggle v-model="general.kyc_status" />
                </div>

                <div class="pr-6 pb-8 w-full lg:w-1/2">
                    <label class="form-label block mr-2 mb-3">{{ $t("启用语言切换器") }}</label>
                    <t-toggle v-model="general.language_status" />
                </div>

                <div class="pr-6 pb-8 w-full lg:w-1/2">
                    <label class="form-label block mr-2 mb-3">{{ $t("启用深色模式") }}</label>
                    <t-toggle v-model="general.dark_mode_status" />
                </div>

                <div class="pr-6 pb-8 w-full lg:w-1/2">
                    <label class="form-label block mr-2 mb-3">{{ $t("注册时要求推荐码") }}</label>
                    <t-toggle v-model="general.registration_referral_required" />
                </div>

                <div class="pr-6 pb-8 w-full lg:w-1/2">
                    <label class="form-label block mr-2 mb-3">{{ $t("默认启用深色模式") }}</label>
                    <t-toggle v-model="general.default_dark_mode_status" />
                </div>

                <div id="file-uploader-form" class="pr-6 pb-8 w-full">
                    <div class="border-b mt-10 mb-2 pb-2">{{ $t("网站Logo：") }}</div>

                    <VueFileAgent
                        class="profile-pic-upload-block"
                        ref="fileUploadForm"
                        :multiple="false"
                        :deletable="false"
                        :meta="false"
                        :compact="true"
                        :accept="'image/*'"
                        :helpText="'将图片文件拖到这里'"
                        :errorText="{
                              type: '请选择图片',
                            }"
                        v-model="siteLogo"
                        @select="onSelect($event)"
                        @upload="onUpload($event)"
                    >
                        <template v-slot:before-outer>
                        </template >
                        <template v-slot:after-outer>
                            <div :title="$t(&quot;after-outer&quot;)">
                                <div class="mb-4">
                                    <small>{{ $t("允许的类型：") }}<strong>{{ $t("jpg, png.") }}</strong></small>
                                    <small>{{ $t("最大文件大小：") }}<strong>1MB</strong></small>
                                </div>
                                <div class="drop-help-text">
                                    <p class="text-success">{{ $t("释放文件即可上传！") }}</p>
                                </div>
                                <button type="button" class="flex justify-between items-center py-2 border-radius-xl px-4 bg-red-500 text-sm rounded text-gray-100 cursor-pointer hover:bg-red-600 hover:text-gray-100 focus:outline-none" :class="[uploaded ? 'btn-danger' : 'btn-secondary']" v-if="siteLogo" @click="removePic()">{{ $t("移除") }}</button>
                                <div class="clearfix"></div>
                            </div>
                        </template >
                    </VueFileAgent>
                </div>

                <text-input v-model="general.withdrawal_limit" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;24小时提现额度 KYC（美元）&quot;)" />

                <text-input v-model="general.withdrawal_limit_kyc" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;24小时提现额度 非KYC（美元）&quot;)" />

                <text-input v-model="general.swap_market" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;Swap 默认市场名称&quot;)" />
                <text-input v-model="general.default_trade_pair" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;默认交易对（例如：BTC-USDT）&quot;)" />
                <text-input v-model="general.default_futures_pair" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;默认合约交易对（例如：BTC-USDT）&quot;)" />
                
                <div class="pr-6 pb-8 w-full mt-4">
                    <div class="font-weight-bold text-lg border-b mb-2 pb-2 font-medium">{{ $t("APP 下载链接") }}</div>
                    <small class="text-gray-500">{{ $t("用于前端展示 Android / iOS APP 下载入口。") }}</small>
                </div>
                
                <text-input
                    v-model="general.android_download_url"
                    class="pr-6 pb-8 w-full lg:w-1/2"
                    label="Android 下载链接"
                    placeholder="例如：https://example.com/app.apk"
                />
                
                <text-input
                    v-model="general.ios_download_url"
                    class="pr-6 pb-8 w-full lg:w-1/2"
                    label="iOS 下载链接"
                    placeholder="例如：https://apps.apple.com/app/xxxx"
                />

            </div>
            <div class="px-8 py-4 bg-gray-100 border-t border-gray-200 flex items-center">
                <loading-button :loading="sending" class="btn-indigo ml-auto" type="submit">{{ $t("更新常规设置") }}</loading-button>
            </div>
        </form>
    </div>

    <div v-if="section == 'trade'" class="bg-white rounded shadow overflow-hidden w-full">
        <form @submit.prevent="submit('trade')">
            <div class="p-8 -mr-6 -mb-8 flex flex-wrap">

                <div class="pr-6 pb-8 w-full">
                    <div class="font-weight-bold text-xl border-b mb-2 pb-4 font-medium">{{ $t("交易设置") }}</div>
                </div>
                <div class="pr-6 pb-8 w-full lg:w-1/2">
                    <label class="form-label block mr-2 mb-3">{{ $t("禁用交易") }}</label>
                    <t-toggle v-model="trade.disable_trades" />
                </div>


                <text-input v-model="trade.transfer_commission_percent" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;交易账户 -&gt; 兑换账户 转账佣金 (%)&quot;)" />


                <div class="pr-6 pb-8 w-full">
                    <div class="font-weight-bold text-lg border-b mb-2 pb-2 font-medium">{{ $t("现货交易手续费") }}</div>
                </div>

                <text-input v-model="trade.maker_fee" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;现货 Maker 手续费 (%)&quot;)" />

                <text-input v-model="trade.taker_fee" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;现货 Taker 手续费 (%)&quot;)" />

                <div class="pr-6 pb-8 w-full"><b>{{ $t('交易所返佣') }}</b><p>15% / 10% / 8% / 6% / 4% / 3% / 2% / 2%</p><a :href="route('admin.referral-center')">{{ $t('邀请与返佣中心') }} →</a></div>

                <div class="pr-6 pb-8 w-full mt-4">
                    <div class="font-weight-bold text-lg border-b mb-2 pb-2 font-medium">{{ $t("合约交易手续费") }}</div>
                </div>

                <text-input v-model="trade.futures_maker_fee" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;合约 Maker 手续费 (%)&quot;)" />

                <text-input v-model="trade.futures_taker_fee" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;合约 Taker 手续费 (%)&quot;)" />


                <div class="pr-6 pb-8 w-full mt-4">
                    <div class="font-weight-bold text-lg border-b mb-2 pb-2 font-medium">{{ $t("期权交易") }}</div>
                </div>

                <select-input v-model="trade.options_result_mode" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;期权交易输出&quot;)">
                   <option value="default">{{ $t("基于市场价格") }}</option>
                   <option value="win">{{ $t("总是盈利") }}</option>
                   <option value="lose">{{ $t("总是亏损") }}</option>
               </select-input>

                <text-input v-model="trade.options_pnl" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;期权交易盈亏&quot;)" />
                <div class="pr-6 pb-8 w-full">
                    <div class="font-weight-bold text-lg border-b mb-2 pb-2 font-medium">{{ $t("自动转入量化账户收益") }}</div>
                </div>

                <text-input v-model="trade.lc30" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;量化账户活期30天日收益率(例 0.1%-0.3%)&quot;)" />

                <text-input v-model="trade.lc90" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;量化账户活期90天日收益率(例 0.1%-0.3%)&quot;)" />

                <text-input v-model="trade.lc180" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;量化账户活期180天日收益率(例 0.1%-0.3%)&quot;)" />
                <text-input v-model="trade.lc365" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;量化账户活期365天日收益率(例 0.1%-0.3%)&quot;)" />
                <text-input v-model="trade.lc_dq30" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;量化账户定期30天日收益率(例 0.1%-0.3%)&quot;)" />

                <text-input v-model="trade.lc_dq90" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;量化账户定期90天日收益率(例 0.1%-0.3%)&quot;)" />

                <text-input v-model="trade.lc_dq180" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;量化账户定期180天收益率(例 0.1%-0.3%)&quot;)" />
                <text-input v-model="trade.lc_dq365" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;量化账户定期365日天收益率(例 0.1%-0.3%)&quot;)" />
                <div class="pr-6 pb-8 w-full mt-4">
                    <div class="font-weight-bold text-lg border-b mb-2 pb-2 font-medium">{{ $t("VIP量化收益加成") }}</div>
                    <small class="text-gray-500">{{ $t("填写百分比数字，例如 10 表示基础正收益额外增加 10%。只对正收益加成，负收益不会放大亏损。") }}</small>
                </div>

                <text-input v-model="trade.lc_vip_1_boost_percent" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;VIP1 量化收益加成 (%)&quot;)" />
                <text-input v-model="trade.lc_vip_2_boost_percent" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;VIP2 量化收益加成 (%)&quot;)" />
                <text-input v-model="trade.lc_vip_3_boost_percent" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;VIP3 量化收益加成 (%)&quot;)" />
                <text-input v-model="trade.lc_vip_4_boost_percent" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;VIP4 量化收益加成 (%)&quot;)" />
                <text-input v-model="trade.lc_vip_5_boost_percent" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;VIP5 量化收益加成 (%)&quot;)" />
                <text-input v-model="trade.lc_vip_6_boost_percent" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;VIP6 量化收益加成 (%)&quot;)" />
                <text-input v-model="trade.lc_vip_7_boost_percent" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;VIP7 量化收益加成 (%)&quot;)" />
                <text-input v-model="trade.lc_vip_8_boost_percent" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;VIP8 量化收益加成 (%)&quot;)" />
            </div>
            <div class="px-8 py-4 bg-gray-100 border-t border-gray-200 flex items-center">
                <loading-button :loading="sending" class="btn-indigo ml-auto" type="submit">{{ $t("更新交易设置") }}</loading-button>
            </div>
        </form>
    </div>

    <div v-if="section == 'mail'" class="bg-white rounded shadow overflow-hidden w-full">
        <form @submit.prevent="submit('mail')">
            <div class="p-8 -mr-6 -mb-8 flex flex-wrap">

                <div class="pr-6 pb-8 w-full">
                    <div class="font-weight-bold text-xl border-b mb-2 pb-4 font-medium">{{ $t("邮件设置") }}</div>
                </div>

                <text-input v-model="mail.mail_from_name" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;发件人名称&quot;)" />
                <text-input v-model="mail.mail_from_address" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;发件人邮箱地址&quot;)" />

                <div class="pr-6 pb-8 w-full">
                    <div class="font-weight-bold text-lg border-b mb-2 pb-2 font-medium">{{ $t("Mailgun API") }}</div>
                </div>

                <div class="pr-6 pb-8 w-full lg:w-1/2">
                    <label class="form-label block mr-2 mb-3">{{ $t("使用 Mailgun API") }}</label>
                    <t-toggle v-model="mail.mailgun_enabled" />
                </div>

                <empty-column></empty-column>

                <template v-if="mail.mailgun_enabled">
                    <text-input v-model="mail.mailgun_domain" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;Mailgun 域名&quot;)" :placeholder="$t(&quot;mg.yourdomain.com&quot;)" />
                    <text-input v-model="mail.mailgun_secret" type="password" autocomplete="new-password" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;Mailgun API Key&quot;)" :placeholder="$t(&quot;key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx&quot;)" />
                    <select-input v-model="mail.mailgun_endpoint" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;Mailgun 端点（区域）&quot;)">
                        <option value="api.mailgun.net">{{ $t("美国区域 (api.mailgun.net)") }}</option>
                        <option value="api.eu.mailgun.net">{{ $t("欧洲区域 (api.eu.mailgun.net)") }}</option>
                    </select-input>
                </template>

                <div class="pr-6 pb-8 w-full">
                    <div class="font-weight-bold text-lg border-b mb-2 pb-2 font-medium">{{ $t("SMTP 设置") }}</div>
                    <small class="text-gray-500" v-if="mail.mailgun_enabled">{{ $t("启用 Mailgun API 后将忽略 SMTP 设置") }}</small>
                </div>

                <text-input v-model="mail.mail_mailer" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;类型（SMTP、API等）&quot;)" :disabled="mail.mailgun_enabled" />
                <text-input v-model="mail.mail_host" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;SMTP 主机&quot;)" :disabled="mail.mailgun_enabled" />
                <text-input v-model="mail.mail_port" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;SMTP 端口&quot;)" :disabled="mail.mailgun_enabled" />
                <text-input v-model="mail.mail_username" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;用户名&quot;)" :disabled="mail.mailgun_enabled" />
                <text-input v-model="mail.mail_password" type="password" autocomplete="new-password" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;密码&quot;)" :disabled="mail.mailgun_enabled" />
                <text-input v-model="mail.mail_encryption" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;加密方式（SSL、TLS等）&quot;)" :disabled="mail.mailgun_enabled" />

            </div>
            <div class="px-8 py-4 bg-gray-100 border-t border-gray-200 flex items-center">
                <loading-button :loading="sending" class="btn-indigo ml-auto" type="submit">{{ $t("更新邮件设置") }}</loading-button>
            </div>
        </form>
    </div>

    <div v-if="section == 'recaptcha'" class="bg-white rounded shadow overflow-hidden w-full">
        <form @submit.prevent="submit('recaptcha')">
            <div class="p-8 -mr-6 -mb-8 flex flex-wrap">

                <div class="pr-6 pb-8 w-full">
                    <div class="font-weight-bold text-xl border-b mb-2 pb-4 font-medium">{{ $t("Recaptcha 设置") }}</div>
                </div>

                <div class="pr-6 pb-8 w-full">
                    <label class="form-label block mr-2 mb-3">{{ $t("启用 Recaptcha") }}</label>
                    <t-toggle v-model="recaptcha.status" />
                </div>

                <text-input v-model="recaptcha.site_key" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;站点 Key&quot;)" />
                <text-input v-model="recaptcha.secret_key" type="password" autocomplete="new-password" class="pr-6 pb-8 w-full lg:w-1/2" :label="$t(&quot;密钥 Key&quot;)" />

