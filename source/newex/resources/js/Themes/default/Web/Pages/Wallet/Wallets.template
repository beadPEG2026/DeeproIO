<app-layout class="dp-account-page">

<!-- components title start -->
<div class="components-title">
    <h2>
        {{ $t('Funding Account') }}
    </h2>
</div>
<!-- components title end -->
<p v-if="!walletBalanceVisible" class="dp-wallet-state" role="status">{{$t(walletBalanceStatus==='loading'?'Loading balance…':walletBalanceStatus==='error'?'Balance could not be refreshed. Please retry.':'Refresh balance before continuing.')}} <button :disabled="walletBalanceStatus==='loading'" @click="refreshWalletBalances">{{$t('Retry')}}</button></p>

<!-- tabs components start -->
<div class="tabs-components tabs">
    <!-- tabs right start -->
    <div class="tabs-right">
        <div class="tabs-search tabs-balance cursor-pointer" v-tooltip.right-end="{ content: '按所选显示币种估算资产价值，实际持仓与结算币种不变。', classes: 'toolTip' }">
            <h3>
                {{ $t('Estimated Balance') }}
                <font-awesome-icon icon="info-circle" class="ml-1 cursor-pointer focus:outline-none" />
            </h3>

            <div v-if="displayTotalBalance">
                <p>
                    {{ displayAmount(toNumber(displayTotalBalance.totatUsdBalance)) }} {{ selectedDisplayCurrency.symbol }}
                </p>

                <small>{{ $t('≈') }} {{ displayTotalBalance.totalBtcBalance }} {{ $t('BTC') }}</small>
            </div>

            <div v-else>
                <p>
                    — {{ selectedDisplayCurrency.symbol }}
                </p>

                <small>{{ $t('≈') }} — {{ $t('BTC') }}</small>
            </div>
        </div>
    </div>
    <!-- tabs right end -->
</div>
<!-- tabs components end -->

<div>
    <div class="mb-4">
        <account-actions />
    </div>
</div>

<!-- tabs components start -->
<div class="tabs-components tabs">
    <!-- tabs left start -->
    <div class="tabs-left">
        <div class="tabs-nav dp-wallet-kinds" role="group" :aria-label="$t('Asset type')">
            <button v-for="tab in [{key:'coin',label:'Crypto'},{key:'stocks',label:'Stocks'},{key:'fiat',label:'Fiat'}]" :key="tab.key" type="button" class="dp-wallet-kind" :class="{'is-active':activeType===tab.key}" :aria-pressed="String(activeType===tab.key)" @click="activeType=tab.key">{{ $t(tab.label) }}</button>
        </div>
    </div>
    <!-- tabs left end -->

    <!-- tabs right start -->
    <div class="tabs-right">
        <div class="tabs-search">
            <input v-model="filter.search" type="text" :placeholder="$t('Search Asset')">

            <button class="tabs-search__icon">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect class="tabs-search__color" x="2" y="2" width="17" height="17" rx="8.5"/>
                    <line class="tabs-search__color" x1="16.2428" y1="17.5356" x2="20.5356" y2="21.8285"/>
                </svg>
            </button>
        </div>
    </div>
    <!-- tabs right end -->
</div>
<!-- tabs components end -->

<!-- table components start -->
<div class="table-components">

    <!-- tables start -->
    <table class="tables mob-table-wallets">

        <!-- thead start -->
        <thead class="table-sort">
            <tr>
                <th>
                    <div @click="setFilter('symbol')" class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Currency') }}</span>
                        <span class="table-sort__icon">
                            <icon-filter
                                :filter="filter"
                                field="symbol">
                            </icon-filter>
                        </span>
                    </div>
                </th>

                <th>
                    <div @click="setFilter('balance_in_wallet_usd')" class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Available') }}</span>
                        <span class="table-sort__icon">
                            <icon-filter
                                :filter="filter"
                                field="balance_in_wallet">
                            </icon-filter>
                        </span>
                    </div>
                </th>

                <th>
                    <div @click="setFilter('balance_in_withdraw_usd')" class="table-sort__value">
                        <span class="table-sort__title">{{ $t('In Withdraw') }}</span>
                        <span class="table-sort__icon">
                            <icon-filter
                                :filter="filter"
                                field="balance_in_withdraw">
                            </icon-filter>
                        </span>
                    </div>
                </th>

                <th>
                    <div @click="setFilter('balance_in_lc_usd')" class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Locked') }}</span>
                        <span class="table-sort__icon">
                            <icon-filter
                                :filter="filter"
                                field="balance_in_lc">
                            </icon-filter>
                        </span>
                    </div>
                </th>

                <th>
                    <div @click="setFilter('type')" class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Type') }}</span>
                        <span class="table-sort__icon">
                            <icon-filter
                                :filter="filter"
                                field="type">
                            </icon-filter>
                        </span>
                    </div>
                </th>

                <th>
                    <div class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Actions') }}</span>
                    </div>
                </th>
            </tr>
        </thead>
        <!-- thead end -->

        <!-- tbody start -->
        <tbody class="table-list">
            <tr v-for="wallet in wallets" :key="wallet.id || wallet.symbol">
                <td>
                    <div class="table-list__subtitle">{{ $t('Currency') }}</div>
                    <div class="table-list__value">
                        <div class="table-list__image"><currency-avatar :symbol="wallet.symbol" :src="wallet.logo" /></div>
                        <div class="table-list__title">
                            <span class="table-list__title-big">
                                {{ wallet.symbol }}
                            </span>
                            <span class="table-list__title-small">{{ wallet.currency }}</span>
                        </div>
                    </div>
                </td>

                <td>
                    <div class="table-list__subtitle">{{ $t('Available') }}</div>
                    <div class="table-list__value table-list__value-v2">
                        <div class="table-list__text">{{ wallet.display_balance_in_wallet }}</div>
                        <div class="table-list__text table-list__text-smaller">≈ {{ wallet.display_balance_in_wallet_usd }}$</div>
                    </div>
                </td>

                <td>
                    <div class="table-list__subtitle">{{ $t('In Withdraw') }}</div>
                    <div class="table-list__value table-list__value-v2">
                        <div class="table-list__text">{{ wallet.display_balance_in_withdraw }}</div>
                        <div class="table-list__text table-list__text-smaller">≈ {{ wallet.display_balance_in_withdraw_usd }}$</div>
                    </div>
                </td>

                <td>
                    <div class="table-list__subtitle">{{ $t('Locked') }}</div>
                    <div class="table-list__value table-list__value-v2">
                        <div class="table-list__text">{{ wallet.display_balance_in_lc }}</div>
                        <div class="table-list__text table-list__text-smaller">≈ {{ wallet.display_balance_in_lc_usd }}$</div>
                    </div>
                </td>

                <td>
                    <div class="table-list__subtitle">{{ $t('Type') }}</div>
                    <div class="table-list__value table-list__value-v2">
                        <div class="table-list__text">
                            {{ wallet.type == "coin" ? (wallet.is_token ? 'Token' : 'Coin') : 'Fiat' }}
                        </div>
                    </div>
                </td>

                <td>
                    <div class="table-list__subtitle">{{ $t('Actions') }}</div>
                    <div class="table-list__value">
                        <div class="table-list__link">
                            <Link v-if="canDeposit(wallet) && wallet.type == 'fiat'" :href="route('wallets.deposit.fiat', { symbol: wallet.symbol })">
                                {{ $t('Deposit') }}
                            </Link>

                            <Link v-else-if="canDeposit(wallet)" :href="route('wallets.deposit.crypto', { symbol: wallet.symbol })">
                                {{ $t('Deposit') }}
                            </Link>

                            <Link v-if="canWithdraw(wallet) && wallet.type == 'fiat'" :href="route('wallets.withdraw.fiat', { symbol: wallet.symbol })">
                                {{ $t('Withdraw') }}
                            </Link>

                            <Link v-else-if="canWithdraw(wallet)" :href="route('wallets.withdraw.crypto', { symbol: wallet.symbol })">
                                {{ $t('Withdraw') }}
                            </Link>
                        </div>
                    </div>
                </td>
            </tr>
        </tbody>
        <!-- tbody end -->

        <!-- tfoot start -->
        <tfoot class="table-result">
            <tr>
                <td colspan="100">
                    <div v-if="walletBalanceVisible && wallets.length == 0" class="table-result__notfound">
                        <span class="table-result__notfound-icon">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path class="table-result__notfound-color" d="M21 13V11C21 7.73081 21 6.09621 20.3272 4.86413C19.8219 3.93873 19.0613 3.17807 18.1359 2.67277C16.9038 2 15.2692 2 12 2V2C8.73081 2 7.09621 2 5.86413 2.67277C4.93873 3.17807 4.17807 3.93873 3.67277 4.86413C3 6.09621 3 7.73081 3 11V12.5C3 16.2433 3 18.1149 3.87311 19.4735C4.29935 20.1368 4.86322 20.7006 5.52648 21.1269C6.88505 22 8.7567 22 12.5 22V22H13" stroke="#222628"/>
                                <line class="table-result__notfound-color" x1="15.5" y1="13.5" x2="7.5" y2="13.5"/>
                                <line class="table-result__notfound-color" x1="15.5" y1="10.5" x2="7.5" y2="10.5"/>
                                <line class="table-result__notfound-color" x1="11.5" y1="7.5" x2="7.5" y2="7.5"/>
                                <rect class="table-result__notfound-color color-yellow" x="14.8335" y="14.8335" width="7.08333" height="7.08333" rx="3.54167"/>
                                <line class="table-result__notfound-color color-yellow" x1="21.1803" y1="21.3066" x2="22.5565" y2="22.6829"/>
                            </svg>
                        </span>

                        <span class="table-result__notfound-text">{{ $t('No wallets found.') }}</span>
                    </div>
                </td>
            </tr>
        </tfoot>
        <!-- tfoot end -->

    </table>
    <!-- tables end -->

</div>
<!-- table components end -->

</app-layout>
