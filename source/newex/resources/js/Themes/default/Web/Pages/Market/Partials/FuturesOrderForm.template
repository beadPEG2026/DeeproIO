<!-- MODULE ORDERFORM START -->
<div class="module module-orderform options-module-bordered" :class="{'module-orderform-opened': openForm}">
    <div @click="openForm = false" class="close-item">
        {{ $t('Close') }}
    </div>
    <div class="flex gap-8">
        <button @click="setTab('buy')" :class="{'button-tab-buy-active': activeTab == 'buy'}" class="module-orderform__buy-forms__button button-tab button-tab-buy">
            <span>
                {{ $t('Buy/') }}{{ $t('Long') }}
            </span>
        </button>

        <button @click="setTab('sell')" :class="{'button-tab-sell-active': activeTab == 'sell'}"  class="module-orderform__buy-forms__button button-tab button-tab-sell">
            <span>
                {{ $t('Sell/') }}{{ $t('Short') }}
            </span>
        </button>
    </div>

    <div class="button-clear"></div>

    <div class="module-container">
        <!-- module head start -->
        <div class="module-head">

            <div class="futures-xs" :class="{'futures-xs-sell': activeTab == 'sell', 'futures-xs-buy': activeTab == 'buy'}">
                <h4>
                    {{ $t('Current Leverage:') }} {{ leverage }}x
                    <span class="leverage-limit-label">
                        / {{ $t('Max Leverage') }} {{ leverageSlider.max }}x
                    </span>
                </h4>
            </div>
            <div v-if="Number(leverage) > 10" class="leverage-safety-warning">
                <div class="leverage-safety-warning__icon">⚠️</div>
                <div class="leverage-safety-warning__content">
                    <div class="leverage-safety-warning__title">
                        {{ $t('User Safety Reminder') }}
                    </div>
                    <div class="leverage-safety-warning__text">
                        {{ $t('Leverage above 10x carries significantly higher liquidation risk. Please confirm you understand the potential losses before placing an order.') }}
                    </div>
                </div>
            </div>
            <div class="tiny-slider">
                <vue-slider v-model="leverage" :tooltip-formatter="leverageSlider.formatter" :marks="leverageSlider.marks" :min="1" :max="leverageSlider.max" :adsorb="false" :hide-label="true" :tooltip-placement="'top'"></vue-slider>
            </div>
            <div class="module-orderform__title" :class="{'futures-tabs': true}">
                <div @click="setOrderType('market')" :class="{ 'module-orderform__active' : orderType == 'market' }" class="module-orderform__title-item">{{ $t('Market') }}</div>
                <div @click="setOrderType('limit')" :class="{ 'module-orderform__active' : orderType == 'limit' }" class="module-orderform__title-item">{{ $t('Limit') }}</div>
            </div>
        </div>
        <!-- module head end -->

        <!-- module body start -->
        <div class="module-body">

            <!-- module orderform container start -->
            <div class="module-orderform__container">

                <!-- module orderform buy start -->
                <div v-if="activeTab == 'buy'" class="module-orderform__buy">
                    <div class="module-orderform__buy-title">
                        <div class="module-orderform__buy-currency">
                            <span class="module-orderform__buy-icon">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect class="module-orderform__buy-color" x="2" y="4" width="20" height="16" rx="4"/>
                                    <line class="module-orderform__buy-color" x1="21.5" y1="9.5" x2="2.5" y2="9.5"/>
                                    <line class="module-orderform__buy-color" x1="19.5" y1="16.5" x2="16.5" y2="16.5"/>
                                </svg>
                            </span>
                            {{ quoteWallet ? getDisplayFuturesBalance(quoteWallet, market.quote_precision) : '-' }} {{ market.quote_currency}}
                        </div>
                    </div>

                    <div class="module-orderform__buy-forms">

                        <div v-if="orderType == 'market'" class="module-orderform__buy-forms__item" :class="{'form-disabled': true}">
                            <label class="module-orderform__buy-forms__item-left">{{ $t('Price') }}</label>
                            <input @keyup="(e) => clearInput(e, 'buy','price')"  @paste.prevent @drop.prevent :placeholder="$t('Market')" :disabled="true" type="text">
                            <label class="module-orderform__buy-forms__item-right">{{ market.quote_currency}}</label>
                        </div>
                        <div v-else class="module-orderform__buy-forms__item" :class="{'module-orderform__buy-forms__invalid': buyErrorField == 'price'}">
                            <label class="module-orderform__buy-forms__item-left">{{ $t('Price') }}</label>
                            <input @keyup="(e) => clearInput(e, 'buy','price')" @paste.prevent @drop.prevent v-model="bid.price" type="text">
                            <label class="module-orderform__buy-forms__item-right">{{ market.quote_currency}}</label>
                        </div>

                        <div class="module-orderform__buy-forms__item" :class="{'module-orderform__buy-forms__invalid': buyErrorField == 'quantity'}">
                            <label class="module-orderform__buy-forms__item-left"> {{ $t('Size') }}</label>
                            <input @keyup="(e) => clearInput(e, 'buy','quantity')" @paste.prevent @drop.prevent v-model="bid.quantity" type="text">
                            <label class="module-orderform__buy-forms__item-right">{{ market.quote_currency}}</label>
                        </div>

                        <vue-slider
                            @input="changeBuySlider"
                            @dragging="changeBuySlider"
                            @change="changeBuySlider"
                            v-model="buySlider.value"
                            :min="buySlider.min"
                            :max="buySlider.max"
                            :interval="buySlider.interval"
                            :disabled="buySlider.disabled"
                            :tooltip-formatter="formatSliderTooltip"
                            :adsorb="false"
                            :included="true"
                            :hide-label="true"
                            :tooltip-placement="'top'"
                        ></vue-slider>

                        <div class="mb-2" v-if="balanceBuyError">
                            <span class="text-sm color-sell info-badge-error">{{ $t('Insufficient balance')}}</span>
                        </div>

                        <!-- TP/SL Section -->
                        <div class="module-orderform__buy-forms__tp-sl">
                            <div class="module-orderform__buy-forms__tp-sl-checkbox">
                                <input type="checkbox" id="buy-tp-sl" v-model="bid.enable_tp_sl">
                                <label for="buy-tp-sl">{{ $t('TP/SL') }}</label>
                            </div>

                            <template v-if="bid.enable_tp_sl">
                                <div class="module-orderform__buy-forms__item" :class="{'module-orderform__buy-forms__invalid': buyErrorField == 'take_profit_price'}">
                                    <label class="module-orderform__buy-forms__item-left">{{ $t('Take Profit') }}</label>
                                    <input @keyup="(e) => clearInput(e, 'buy','take_profit_price')" @paste.prevent @drop.prevent v-model="bid.take_profit_price" type="text">
                                    <label class="module-orderform__buy-forms__item-right">{{ market.quote_currency}}</label>
                                </div>

                                <div class="module-orderform__buy-forms__item" :class="{'module-orderform__buy-forms__invalid': buyErrorField == 'stop_loss_price'}">
                                    <label class="module-orderform__buy-forms__item-left">{{ $t('Stop Loss') }}</label>
                                    <input @keyup="(e) => clearInput(e, 'buy','stop_loss_price')" @paste.prevent @drop.prevent v-model="bid.stop_loss_price" type="text">
                                    <label class="module-orderform__buy-forms__item-right">{{ market.quote_currency}}</label>
                                </div>
                            </template>
                        </div>

                        <button @click="placeBuyOrder()" :class="{ 'opacity-75': placingBuyOrder }" class="module-orderform__buy-forms__button">
                            <span>
                                <svg v-show="placingBuyOrder" class="inline animate-spin -ml-1 mr-3 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                {{ $t('Buy/') }}{{ $t('Long') }}
                            </span>
                        </button>
                    </div>

                </div>
                <!-- module orderform buy end -->

                <!-- module orderform sell start -->
                <div v-if="activeTab == 'sell'" class="module-orderform__sell">
                    <div class="module-orderform__sell-title">
                        <div class="module-orderform__sell-currency">
                            <span class="module-orderform__sell-icon">
                                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect class="module-orderform__sell-color" x="2" y="4" width="20" height="16" rx="4"/>
                                    <line class="module-orderform__sell-color" x1="21.5" y1="9.5" x2="2.5" y2="9.5"/>
                                    <line class="module-orderform__sell-color" x1="19.5" y1="16.5" x2="16.5" y2="16.5"/>
                                </svg>
                            </span>
                            {{ quoteWallet ? getDisplayFuturesBalance(quoteWallet, market.quote_precision) : '-' }} {{ market.quote_currency}}
                        </div>
                    </div>

                    <div class="module-orderform__sell-forms">
                        <div v-if="orderType == 'market'" class="module-orderform__sell-forms__item" :class="{'form-disabled': true}">
                            <label class="module-orderform__sell-forms__item-left">{{ $t('Price') }}</label>
                            <input @keyup="(e) => clearInput(e, 'ask','price')" @paste.prevent @drop.prevent :placeholder="$t('Market')" :disabled="true" type="text">
                            <label class="module-orderform__sell-forms__item-right">{{ market.quote_currency}}</label>
                        </div>
                        <div v-else class="module-orderform__sell-forms__item" :class="{'module-orderform__sell-forms__invalid': sellErrorField == 'price'}">
                            <label class="module-orderform__sell-forms__item-left">{{ $t('Price') }}</label>
                            <input @keyup="(e) => clearInput(e, 'ask','price')" @paste.prevent @drop.prevent v-model="ask.price" type="text">
                            <label class="module-orderform__sell-forms__item-right">{{ market.quote_currency}}</label>
                        </div>

                        <div class="module-orderform__sell-forms__item" :class="{'module-orderform__sell-forms__invalid': sellErrorField == 'quantity'}">
                            <label class="module-orderform__sell-forms__item-left">{{ $t('Size') }}</label>
                            <input @keyup="(e) => clearInput(e, 'ask','quantity')" @paste.prevent @drop.prevent type="text" v-model="ask.quantity">
                            <label class="module-orderform__sell-forms__item-right">{{ market.quote_currency}}</label>
                        </div>

                        <vue-slider
                            @input="changeSellSlider"
                            @dragging="changeSellSlider"
                            @change="changeSellSlider"
                            v-model="sellSlider.value"
                            :min="sellSlider.min"
                            :max="sellSlider.max"
                            :interval="sellSlider.interval"
                            :disabled="sellSlider.disabled"
                            :tooltip-formatter="formatSliderTooltip"
                            :adsorb="false"
                            :included="true"
                            :hide-label="true"
                            :tooltip-placement="'top'"
                        ></vue-slider>

                        <div class="mb-2" v-if="balanceSellError">
                            <span class="text-sm color-sell info-badge-error">{{ $t('Insufficient balance')}}</span>
                        </div>

                        <!-- TP/SL Section -->
                        <div class="module-orderform__sell-forms__tp-sl">
                            <div class="module-orderform__sell-forms__tp-sl-checkbox">
                                <input type="checkbox" id="sell-tp-sl" v-model="ask.enable_tp_sl">
                                <label for="sell-tp-sl">{{ $t('TP/SL') }}</label>
                            </div>

                            <template v-if="ask.enable_tp_sl">
                                <div class="module-orderform__sell-forms__item" :class="{'module-orderform__sell-forms__invalid': sellErrorField == 'take_profit_price'}">
                                    <label class="module-orderform__sell-forms__item-left">{{ $t('Take Profit') }}</label>
                                    <input @keyup="(e) => clearInput(e, 'sell','take_profit_price')" @paste.prevent @drop.prevent v-model="ask.take_profit_price" type="text">
                                    <label class="module-orderform__sell-forms__item-right">{{ market.quote_currency}}</label>
                                </div>

                                <div class="module-orderform__sell-forms__item" :class="{'module-orderform__sell-forms__invalid': sellErrorField == 'stop_loss_price'}">
                                    <label class="module-orderform__sell-forms__item-left">{{ $t('Stop Loss') }}</label>
                                    <input @keyup="(e) => clearInput(e, 'sell','stop_loss_price')" @paste.prevent @drop.prevent v-model="ask.stop_loss_price" type="text">
                                    <label class="module-orderform__sell-forms__item-right">{{ market.quote_currency}}</label>
                                </div>
                            </template>
                        </div>

                        <button @click="placeSellOrder()" :class="{ 'opacity-75': placingSellOrder }" class="module-orderform__sell-forms__button">
                            <span>
                                <svg v-show="placingSellOrder" class="inline animate-spin -ml-1 mr-3 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                                {{ $t('Sell/') }}{{ $t('Short') }}
                            </span>
                        </button>

                    </div>
                </div>
                <!-- module orderform sell end -->

            </div>
            <div v-if="errors" class="mt-5 text-sm text-red-500">
                {{ errors }}
            </div>
            <!-- module orderform container end -->

        </div>
        <!-- module body end -->
    </div>

    <!-- Leverage Quiz Modal Start -->
    <div
        v-if="showLeverageQuizModal"
        class="leverage-quiz-modal"
        @click.self="cancelLeverageQuiz"
    >
        <div class="leverage-quiz-dialog">
            <div class="leverage-quiz-header">
                <div>
                    <div class="leverage-quiz-title">
                        {{ $t('Futures Risk Quiz') }}
                    </div>
                    <div class="leverage-quiz-subtitle">
                        {{ $t('Answer all 10 questions correctly to enable futures trading on this device.') }}
                    </div>
                </div>
                <button
                    type="button"
                    class="leverage-quiz-close"
                    @click="cancelLeverageQuiz"
                >×</button>
            </div>

            <div class="leverage-quiz-body">
                <div class="leverage-quiz-warning">
                    <div class="leverage-quiz-warning-icon">⚠</div>
                    <div class="leverage-quiz-warning-text">
                        {{ $t('Before opening a futures position, please complete the risk quiz. After passing, this device will remember your result.') }}
                    </div>
                </div>

                <div class="leverage-quiz-progress" style="margin-bottom: 14px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 12px; margin-bottom: 8px;">
                        <span>
                            {{ $t('Question') }} {{ leverageQuizCurrentIndex + 1 }} / {{ leverageQuizQuestions.length }}
                        </span>
                        <span>
                            {{ $t('Correct answers') }} {{ leverageQuizCurrentIndex }} / {{ leverageQuizQuestions.length }}
                        </span>
                    </div>
                    <div style="height: 7px; border-radius: 999px; background: rgba(95, 84, 170, 0.16); overflow: hidden;">
                        <div
                            :style="{ width: leverageQuizProgressPercent + '%' }"
                            style="height: 100%; border-radius: 999px; background: linear-gradient(135deg, #5f54aa, #7b6cf0); transition: width .2s ease;"
                        ></div>
                    </div>
                </div>

                <template v-if="currentLeverageQuizQuestion">
                    <div class="leverage-quiz-question">
                        {{ $t(currentLeverageQuizQuestion.question) }}
                    </div>

                    <label
                        v-for="option in currentLeverageQuizQuestion.options"
                        :key="option.value"
                        class="leverage-quiz-option"
                        :class="{ 'is-selected': leverageQuizSelected === option.value }"
                    >
                        <input type="radio" v-model="leverageQuizSelected" :value="option.value">
                        <span>{{ $t(option.label) }}</span>
                    </label>
                </template>

                <div v-if="leverageQuizError" class="leverage-quiz-error">
                    {{ $t(leverageQuizError) }}
                </div>
            </div>

            <div class="leverage-quiz-footer">
                <button
                    type="button"
                    class="leverage-quiz-cancel"
                    @click="cancelLeverageQuiz"
                >
                    {{ $t('Cancel') }}
                </button>
                <button
                    type="button"
                    class="leverage-quiz-confirm"
                    @click="confirmLeverageQuiz"
                >
                    {{ leverageQuizCurrentIndex + 1 >= leverageQuizQuestions.length ? $t('Confirm and Continue') : $t('Next Question') }}
                </button>
            </div>
        </div>
    </div>
    <!-- Leverage Quiz Modal End -->
</div>