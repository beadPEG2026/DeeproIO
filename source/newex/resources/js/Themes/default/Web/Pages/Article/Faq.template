<app-layout><Head><title>{{ $t('Deepro Help Center') }}</title></Head><section class="deepro-help"><span class="deepro-eyebrow">DEEPRO SUPPORT</span><h1>{{ $t('Account, assets and trading') }}</h1><p>{{ $t('Find answers to common questions about using Deepro.') }}</p><nav class="dp-help-categories"><button v-for="[key,label] in [['all','All'],['account','Account'],['assets','Assets'],['trading','Trade'],['umi','UMI Ecosystem']]" :key="key" :aria-pressed="category===key" @click="category=key">{{ $t(label) }}</button></nav><div class="deepro-help-list"><details v-for="(item,index) in filtered" :key="index" :open="index === 0"><summary>{{ text(item.question) }}</summary><p>{{ text(item.answer) }}</p></details></div><div class="deepro-help-footer"><h3>{{ $t('Need more help?') }}</h3><Link :href="route('support')">{{ $t('Open support center') }} ↗</Link></div></section></app-layout>
