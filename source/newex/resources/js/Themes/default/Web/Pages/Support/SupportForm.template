<app-layout><Head><title>{{ $t('Support') }}</title></Head>
<section class="dp-support-hub"><header><span class="dp-support-icon" aria-hidden="true"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 14v-3a8 8 0 0 1 16 0v3M20 17v1a3 3 0 0 1-3 3h-3"/><rect x="2" y="11" width="5" height="8" rx="2"/><rect x="17" y="11" width="5" height="8" rx="2"/></svg></span><h1>{{ $t('Deepro Support Center') }}</h1><p>{{ text(channels.hours) }}</p><small v-if="channels.languages">{{ channels.languages }}</small></header>
<nav :aria-label="$t('Support channels')"><template v-for="channel in availableChannels">
<button v-if="channel==='chat'" :key="channel" ref="chatButton" @click="openOnlineSupport"><span class="dp-channel-icon">☏</span><span><b>{{ $t('Online Customer Service') }}</b><small>{{ $t('Start a conversation') }}</small></span><em>›</em></button>
<div v-else-if="channel==='tickets'" :key="channel" class="dp-support-ticket-entry"><Link :href="route('support.tickets')"><span class="dp-channel-icon">▤</span><span><b>{{ $t('My tickets') }}</b><small>{{ $t('Track requests and replies here.') }}</small></span><em>›</em></Link><button @click="openTicketForm">{{ $t('Submit a Request') }} ＋</button></div>
<a v-else-if="channel==='email'" :key="channel" :href="'mailto:'+channels.email"><span class="dp-channel-icon">✉</span><span><b>{{ $t('Email support') }}</b><small>{{ channels.email }}</small></span><em>›</em></a>
<Link v-else-if="channel==='help'" :key="channel" :href="route('faq')"><span class="dp-channel-icon">?</span><span><b>{{ $t('Help Center') }}</b><small>{{ $t('Account, assets and trading') }}</small></span><em>›</em></Link>
</template></nav><p v-if="channels.availability==='offline'" class="dp-support-hours">{{ $t('Chat is offline. Submit a ticket for follow-up.') }}</p></section>
<section v-if="showTicketForm" ref="ticketForm" class="support-page dp-support-form"><div class="support-page__card"><button type="button" class="dp-support-close-form" @click="showTicketForm=false">{{ $t('Close') }} ×</button><h2>{{ $t('Submit Support Request') }}</h2><p v-if="successNotice" role="status">{{ successNotice }}</p><p v-if="errors.throttle" role="alert">{{ errors.throttle }}</p>
                        <form @submit.prevent="submit" class="support-page__form">
                            <!-- Subject Field -->
                            <div class="support-page__field">
                                <label class="support-page__label">
                                    <span class="support-page__label-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </span>
                                    {{ $t('Subject') }}
                                    <span class="support-page__required">*</span>
                                </label>
                                <input
                                    type="text"
                                    v-model="form.title"
                                    class="support-page__input"
                                    :class="{ 'support-page__input--error': errors.title }"
                                    :placeholder="$t('Brief description of your issue')"
                                />
                                <span v-if="errors.title" class="support-page__error">{{ errors.title }}</span>
                            </div>

                            <!-- Message Field -->
                            <div class="support-page__field">
                                <label class="support-page__label">
                                    <span class="support-page__label-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                        </svg>
                                    </span>
                                    {{ $t('Message') }}
                                    <span class="support-page__required">*</span>
                                </label>
                                <textarea
                                    v-model="form.body"
                                    class="support-page__textarea"
                                    :class="{ 'support-page__textarea--error': errors.body }"
                                    :placeholder="$t('Please provide as much detail as possible about your issue...')"
                                    rows="6"
                                ></textarea>
                                <span v-if="errors.body" class="support-page__error">{{ errors.body }}</span>
                            </div>

                            <div class="form-components__block mb-10">
                                <label class="flex support-page__label">
                                    <span class="mr-2 support-page__label-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
                                        </svg>
                                    </span>
                                    {{ $t('Attachment') }}
                                    <span class="support-page__optional">({{ $t('Optional') }})</span>
                                </label>
                                <div class="mb-10 form-components__block-item block-list">
                                    <div id="file-uploader-form" class="file-uploader-form-kyc">
                                        <private-attachment v-model="form.file_id" :disabled="sending || attachmentBusy" @busy="attachmentBusy=$event" />
                                    </div>
                                    <div class="text-red-600 mb-3" v-if="errors.file_id">
                                        {{ errors.file_id }}
                                    </div>
                                </div>
                            </div>

                            <!-- Recaptcha -->
                            <div class="support-page__field" v-if="$page.props.captcha">
                                <vue-recaptcha
                                    ref="recaptcha"
                                    @verify="onVerify"
                                    class="support-page__recaptcha"
                                    :sitekey="$page.props.captcha_key"
                                    :loadRecaptchaScript="true">
                                </vue-recaptcha>
                                <span v-if="errors['g-recaptcha-response']" class="support-page__error">
                                    {{ $t('Please complete Recaptcha') }}
                                </span>
                            </div>

                            <!-- Submit Button for authenticated users -->
                            <div v-if="$page.props.user" class="support-page__actions">
                                <button type="submit" class="support-page__submit" :class="{ 'support-page__submit--loading': sending }" :disabled="sending || attachmentBusy">
                                    <svg v-if="sending" class="support-page__spinner" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 714 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                    <svg v-else xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="22" y1="2" x2="11" y2="13"></line>
                                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                                    </svg>
                                    <span>{{ sending ? $t('Submitting...') : $t('Submit Request') }}</span>
                                </button>
                            </div>

                            <!-- Login Button for guests -->
                            <div v-else class="support-page__actions">
                                <Link :href="route('login')" class="support-page__submit">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                        <polyline points="10 17 15 12 10 7"></polyline>
                                        <line x1="15" y1="12" x2="3" y2="12"></line>
                                    </svg>
                                    <span>{{ $t('Login to Submit') }}</span>
                                </Link>
                            </div>
                        </form>
</div></section>
<div v-if="showOnlineSupportModal" class="online-support-modal-overlay" @click.self="closeOnlineSupport">
 <div class="online-support-modal dp-chat-connection" role="dialog" aria-modal="true" :aria-label="$t('Online Customer Service')">
  <div class="online-support-modal__header"><b>{{ $t('Online Customer Service') }}</b><button type="button" ref="closeChat" class="online-support-modal__close" :aria-label="$t('Close')" @click="closeOnlineSupport">×</button></div>
  <div class="dp-chat-status" role="status"><p>{{ $t(chatWait?'Chat is taking longer to load':'Loading...') }}</p><button v-if="chatWait" type="button" @click="openOnlineSupport">{{ $t('Retry') }}</button></div>
  <div class="dp-chat-fallback"><a :href="tawkDirectChatUrl" target="_blank" rel="noopener noreferrer">{{ $t('Open chat in a new window') }} ↗</a><button type="button" @click="openTicketForm">{{ $t('Submit a Request') }}</button></div>
 </div>
</div>
</app-layout>
