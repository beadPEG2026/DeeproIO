<!-- MODULE ORDEROPEN START -->
<div class="module module-orderopen">
    <div class="module-container">

        <!-- module body start -->
        <div class="module-body">

            <!-- module orderopen table start -->
            <div class="module-orderopen__table">

                <div class="module-orderopen__table-title table-title">
                    <div class="table-title__name">{{ $t('Market') }}</div>
                    <div class="table-title__name">{{ $t('Type') }}</div>
                    <div class="table-title__name">{{ $t('Executed Price') }}</div>
                    <div class="table-title__name">{{ $t('Fee') }}</div>
                    <div class="table-title__name">{{ $t('Amount') }}</div>
                    <div class="table-title__name">{{ $t('Date') }}</div>
                </div>

                <div
                    v-if="orders"
                    v-for="order in orders"
                    :key="order.id || order.created_at"
                    class="module-orderopen__table-list table-list cursor-pointer"
                    @click="openOrderDetail(order)"
                >
                    <div class="table-list__item">
                        <div class="table-list__item-value">
                            <span class="table-list__subtitle">{{ $t('Market') }}</span>
                            {{ getMarketName(order) }}
                        </div>

                        <div :class="getOrderSideClass(order)" class="table-list__item-value">
                            <span class="table-list__subtitle">{{ $t('Type') }}</span>
                            {{ getDisplayType(order) }}
                        </div>

                        <div class="table-list__item-value">
                            <span class="table-list__subtitle">{{ $t('Price') }}</span>
                            {{ getExecutedPrice(order) }}
                        </div>

                        <div class="table-list__item-value">
                            <span class="table-list__subtitle">{{ $t('Fee') }}</span>
                            {{ getTotalFeeText(order) }}
                        </div>

                        <div class="table-list__item-value">
                            <span class="table-list__subtitle">{{ $t('Amount') }}</span>
                            {{ getExecutedBaseText(order) }}
                        </div>

                        <div class="table-list__item-value table-list__item-date">
                            <span class="table-list__subtitle">{{ $t('Date') }}</span>
                            {{ localDateTime(order.created_at) }}
                        </div>
                    </div>
                </div>
            </div>
            <!-- module orderopen table end -->

            <!-- module orderopen login start -->
            <div v-if="!$page.props.user" class="module-orderopen__login">
                <div class="module-orderopen__login-text">
                    <Link :href="route('login')">{{ $t('Log In') }}</Link>
                    {{ $t('or') }}
                    <Link :href="route('register')">{{ $t('Register Now') }}</Link>
                    {{ $t('to trade') }}
                </div>
            </div>
            <!-- module orderopen login end -->

            <!-- module orderopen notfont start -->
            <div v-if="$page.props.user && orders && orders.length == 0" class="module-orderopen__notfont">
                <span class="module-orderopen__notfont-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path class="module-orderopen__notfont-icon__color" d="M21 13V11C21 7.73081 21 6.09621 20.3272 4.86413C19.8219 3.93873 19.0613 3.17807 18.1359 2.67277C16.9038 2 15.2692 2 12 2V2C8.73081 2 7.09621 2 5.86413 2.67277C4.93873 3.17807 4.17807 3.93873 3.67277 4.86413C3 6.09621 3 7.73081 3 11V12.5C3 16.2433 3 18.1149 3.87311 19.4735C4.29935 20.1368 4.86322 20.7006 5.52648 21.1269C6.88505 22 8.7567 22 12.5 22V22H13" stroke="#222628"/>
                        <line class="module-orderopen__notfont-icon__color" x1="15.5" y1="13.5" x2="7.5" y2="13.5"/>
                        <line class="module-orderopen__notfont-icon__color" x1="15.5" y1="10.5" x2="7.5" y2="10.5"/>
                        <line class="module-orderopen__notfont-icon__color" x1="11.5" y1="7.5" x2="7.5" y2="7.5"/>
                        <rect class="module-orderopen__notfont-icon__color color-yellow" x="14.8335" y="14.8335" width="7.08333" height="7.08333" rx="3.54167"/>
                        <line class="module-orderopen__notfont-icon__color color-yellow" x1="21.1803" y1="21.3066" x2="22.5565" y2="22.6829"/>
                    </svg>
                </span>
                <span class="module-orderopen__notfont-text">
                    {{ $t('No Trades Found.') }}
                </span>
            </div>
            <!-- module orderopen notfont end -->

        </div>
        <!-- module body end -->
    </div>

    <!-- order detail modal start -->
    <div
        v-if="showOrderDetailModal && selectedOrder"
        class="fixed inset-0 flex items-center justify-center px-4"
        style="z-index: 99999;"
    >
        <div
            class="absolute inset-0"
            style="background: rgba(0, 0, 0, 0.72);"
            @click="closeOrderDetail"
        ></div>

        <div
            class="relative w-full max-w-2xl rounded-2xl overflow-hidden"
            style="background: #080b12; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 24px 80px rgba(0,0,0,0.45); max-height: 90vh; overflow-y: auto;"
            @click.stop
        >
            <div class="flex items-center justify-between px-6 py-5" style="border-bottom: 1px solid rgba(255,255,255,0.08);">
                <button
                    type="button"
                    class="text-white"
                    style="font-size: 28px; line-height: 1;"
                    @click="closeOrderDetail"
                >
                    ‹
                </button>

                <h3 class="text-white font-bold text-xl">
                    {{ $t('Order Details') }}
                </h3>

                <div style="width: 24px;"></div>
            </div>

            <div class="px-6 py-6">
                <div class="flex items-center justify-between mb-7">
                    <div>
                        <div class="text-white font-bold text-2xl mb-2">
                            {{ getMarketName(selectedOrder) }}
                        </div>

                        <div class="flex items-center gap-2">
                            <span
                                class="px-2 py-1 rounded text-xs font-bold"
                                :class="getOrderSideClass(selectedOrder)"
                                style="background: rgba(255,255,255,0.08);"
                            >
                                {{ getOrderSide(selectedOrder) }}
                            </span>

                            <span
                                class="px-2 py-1 rounded text-xs text-white"
                                style="background: rgba(255,255,255,0.10);"
                            >
                                {{ getOrderTypeShort(selectedOrder) }}
                            </span>
                        </div>
                    </div>

                    <div class="text-right">
                        <div class="components-label mt-2 label-green">
                            {{ $t('Filled') }}
                        </div>
                    </div>
                </div>

                <div style="display: grid; gap: 16px;">
                    <div class="flex items-center justify-between">
                        <span style="color: #8d93a6;">{{ $t('Order Status') }}</span>
                        <span style="color: #ffffff;">{{ $t('Filled') }}</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span style="color: #8d93a6;">{{ $t('Order Type') }}</span>
                        <span style="color: #ffffff;">{{ getOrderType(selectedOrder) }}</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span style="color: #8d93a6;">{{ $t('Order Quantity') }}</span>
                        <span style="color: #ffffff;">{{ getOrderQuantity(selectedOrder) }}</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span style="color: #8d93a6;">{{ $t('Order Price') }}</span>
                        <span style="color: #ffffff;">{{ getOrderPrice(selectedOrder) }}</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span style="color: #8d93a6;">{{ $t('Filled Amount') }}</span>
                        <span style="color: #ffffff;">{{ getExecutedBaseText(selectedOrder) }}</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span style="color: #8d93a6;">{{ $t('Average Price') }}</span>
                        <span style="color: #ffffff;">{{ getExecutedPrice(selectedOrder) }}</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span style="color: #8d93a6;">{{ $t('Order Value') }}</span>
                        <span style="color: #ffffff;">{{ getOrderValue(selectedOrder) }}</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span style="color: #8d93a6;">{{ $t('Fee') }}</span>
                        <span style="color: #ffffff;">{{ getTotalFeeText(selectedOrder) }}</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span style="color: #8d93a6;">{{ $t('Order Time') }}</span>
                        <span style="color: #ffffff;">{{ localDateTime(selectedOrder.created_at) }}</span>
                    </div>

                    <div class="flex items-center justify-between">
                        <span style="color: #8d93a6;">{{ $t('Order ID') }}</span>
                        <span style="color: #ffffff;" class="cursor-pointer" @click="doCopy(getOrderId(selectedOrder))">
                            {{ getOrderId(selectedOrder) }}
                            <span style="opacity: 0.55; margin-left: 6px;">⧉</span>
                        </span>
                    </div>
                </div>

                <div style="height: 1px; background: rgba(255,255,255,0.10); margin: 28px 0;"></div>

                <h4 class="text-white font-bold text-lg mb-5">
                    {{ $t('Trade Details') }}
                </h4>

                <div style="padding-bottom: 16px;">
                    <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px;">
                        <div>
                            <div style="color: #8d93a6; font-size: 13px;">{{ $t('Quantity') }}</div>
                            <div class="mt-1" style="color: #ffffff;">
                                {{ getDisplayDetail(selectedOrder).quantityText }}
                                <template v-if="getDisplayDetail(selectedOrder).quantitySymbol">
                                    {{ getDisplayDetail(selectedOrder).quantitySymbol }}
                                </template>
                            </div>
                        </div>

                        <div>
                            <div style="color: #8d93a6; font-size: 13px;">{{ $t('Price') }}</div>
                            <div class="mt-1" style="color: #ffffff;">
                                {{ getDisplayDetail(selectedOrder).priceText }}
                                <template v-if="getDisplayDetail(selectedOrder).priceSymbol">
                                    {{ getDisplayDetail(selectedOrder).priceSymbol }}
                                </template>
                            </div>
                        </div>

                        <div>
                            <div style="color: #8d93a6; font-size: 13px;">{{ $t('Fee') }}</div>
                            <div class="mt-1" style="color: #ffffff;">
                                {{ getDisplayDetail(selectedOrder).feeText }}
                                <template v-if="getDisplayDetail(selectedOrder).feeSymbol">
                                    {{ getDisplayDetail(selectedOrder).feeSymbol }}
                                </template>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3" style="color: #8d93a6;">
                        {{ getDisplayDetail(selectedOrder).time }}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- order detail modal end -->
</div>
<!-- MODULE ORDEROPEN END -->