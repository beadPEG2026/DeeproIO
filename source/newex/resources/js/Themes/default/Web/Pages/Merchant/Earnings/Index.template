<app-layout>
    <Head>
        <title>{{ $t('Earnings') }}</title>
    </Head>

    <merchant-top-menu :label="$t('Earnings')"></merchant-top-menu>

    <div class="container mx-auto py-6 merchant-container">
        <!-- Balance Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-100 text-sm">{{ $t('Available Balance') }}</p>
                        <p class="text-3xl font-bold">{{ formatCurrency(stats.available_balance) }}</p>
                    </div>
                    <div class="w-12 h-12  rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
                <div class="mt-4">
                    <Link :href="route('merchant.payouts')" class="text-sm  hover:/30 px-4 py-2 rounded-lg inline-block">
                        {{ $t('Request Payout') }}
                    </Link>
                </div>
            </div>

            <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-yellow-100 text-sm">{{ $t('Pending Balance') }}</p>
                        <p class="text-3xl font-bold">{{ formatCurrency(stats.pending_balance) }}</p>
                    </div>
                    <div class="w-12 h-12  rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
                <p class="mt-4 text-sm text-yellow-100">{{ $t('Pending payout requests') }}</p>
            </div>

            <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-xl p-6 text-white">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-100 text-sm">{{ $t('Total Earnings') }}</p>
                        <p class="text-3xl font-bold">{{ formatCurrency(stats.total_earnings) }}</p>
                    </div>
                    <div class="w-12 h-12  rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                        </svg>
                    </div>
                </div>
                <p class="mt-4 text-sm text-blue-100">{{ $t('Total paid out') }}: {{ formatCurrency(stats.total_paid_out) }}</p>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class=" rounded-xl p-4 shadow-sm">
                <p class=" text-sm">{{ $t("Today's Earnings") }}</p>
                <p class="text-2xl font-bold ">{{ formatCurrency(stats.today_earnings) }}</p>
            </div>
            <div class=" rounded-xl p-4 shadow-sm">
                <p class=" text-sm">{{ $t('This Week') }}</p>
                <p class="text-2xl font-bold ">{{ formatCurrency(stats.this_week_earnings) }}</p>
            </div>
            <div class=" rounded-xl p-4 shadow-sm">
                <p class=" text-sm">{{ $t('This Month') }}</p>
                <p class="text-2xl font-bold ">{{ formatCurrency(stats.this_month_earnings) }}</p>
            </div>
            <div class=" rounded-xl p-4 shadow-sm">
                <p class=" text-sm">{{ $t('Total Volume') }}</p>
                <p class="text-2xl font-bold ">{{ formatCurrency(stats.total_volume) }}</p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Fees Summary -->
            <div class=" rounded-xl shadow-sm p-6 rounded-card">
                <h3 class="text-lg font-semibold  mb-4">{{ $t('Fees Summary') }}</h3>
                <div class="space-y-4">
                    <div class="flex justify-between items-center pb-3 border-b">
                        <span class="">{{ $t('Total Volume') }}</span>
                        <span class="font-semibold ">{{ formatCurrency(stats.total_volume) }}</span>
                    </div>
                    <div class="flex justify-between items-center pb-3 border-b">
                        <span class="">{{ $t('Platform Fees') }}</span>
                        <span class="font-semibold text-red-600">-{{ formatCurrency(stats.total_fees) }}</span>
                    </div>
                    <div class="flex justify-between items-center pb-3 border-b">
                        <span class="">{{ $t('Net Earnings') }}</span>
                        <span class="font-semibold text-green-600">{{ formatCurrency(stats.total_earnings) }}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="">{{ $t('Fee Rate') }}</span>
                        <span class="font-semibold ">{{ merchant.fee_percent }}%</span>
                    </div>
                </div>
            </div>

            <!-- Invoice Stats -->
            <div class=" rounded-xl shadow-sm p-6 rounded-card">
                <h3 class="text-lg font-semibold  mb-4">{{ $t('Invoice Statistics') }}</h3>
                <div class="space-y-4">
                    <div class="flex justify-between items-center pb-3 border-b">
                        <span class="">{{ $t('Total Invoices') }}</span>
                        <span class="font-semibold ">{{ stats.total_invoices }}</span>
                    </div>
                    <div class="flex justify-between items-center pb-3 border-b">
                        <span class="">{{ $t('Paid Invoices') }}</span>
                        <span class="font-semibold text-green-600">{{ stats.paid_invoices }}</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="">{{ $t('Conversion Rate') }}</span>
                        <span class="font-semibold text-blue-600">{{ conversionRate }}%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Transactions -->
        <div class=" rounded-xl shadow-sm mt-6">
            <div class="p-6 border-b flex justify-between items-center">
                <h3 class="text-lg font-semibold ">{{ $t('Recent Transactions') }}</h3>
                <Link :href="route('merchant.deposits')" class="text-blue-600 hover:text-blue-700 text-sm">
                    {{ $t('View All') }}
                </Link>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full merchant-table">
                    <thead class="">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Invoice') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Amount') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Fee') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Net') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Date') }}</th>
                        </tr>
                    </thead>
                    <tbody class="">
                        <tr v-for="tx in recentTransactions" :key="tx.id" class="hover:">
                            <td class="px-6 py-4">
                                <Link :href="route('merchant.invoices.show', tx.id)" class="text-blue-600 hover:text-blue-700 font-mono text-sm">
                                    {{ tx.reference }}
                                </Link>
                            </td>
                            <td class="px-6 py-4 font-medium">{{ formatCurrency(tx.amount_usd) }}</td>
                            <td class="px-6 py-4 text-red-600">-{{ formatCurrency(tx.fee_amount_usd) }}</td>
                            <td class="px-6 py-4 text-green-600 font-medium">{{ formatCurrency(tx.amount_usd - tx.fee_amount_usd) }}</td>
                            <td class="px-6 py-4  text-sm">{{ formatDate(tx.paid_at) }}</td>
                        </tr>
                        <tr v-if="!recentTransactions || recentTransactions.length === 0">
                            <td colspan="5" class="px-6 py-8 text-center ">{{ $t('No transactions yet') }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</app-layout>
