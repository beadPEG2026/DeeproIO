<div class="min-h-screen bg-gray-100 flex items-center justify-center p-4">
    <div class=" rounded-2xl shadow-xl w-full max-w-md overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-blue-600 to-blue-700 text-white p-6">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center space-x-3">
                    <img v-if="merchant.logo_url" :src="merchant.logo_url" class="w-10 h-10 rounded-full" />
                    <div v-else class="w-10 h-10 rounded-full  flex items-center justify-center">
                        <span class="text-xl font-bold">{{ merchant.name.charAt(0) }}</span>
                    </div>
                    <span class="font-semibold">{{ merchant.name }}</span>
                </div>
            </div>
            <div class="text-center">
                <div class="text-sm opacity-80">{{ $t('Amount to Pay') }}</div>
                <div class="text-4xl font-bold mt-1">{{ invoice.amount_usd_display }}</div>
                <div v-if="invoice.description" class="text-sm opacity-80 mt-2">{{ invoice.description }}</div>
            </div>
        </div>

        <!-- Currency Selection -->
        <div v-if="isAwaitingSelection" class="p-6">
            <h3 class="text-lg font-semibold text-center mb-4">{{ $t('Select Payment Method') }}</h3>

            <div v-if="error" class="mb-4 p-3 bg-red-50 text-red-600 rounded-lg text-sm">
                {{ error }}
            </div>

            <div class="space-y-3 max-h-96 overflow-y-auto">
                <div v-if="!loading"
                    v-for="(currency, index) in availableCurrencies"
                    :key="currency.symbol + '_' + currency.network_id"
                    @click="selectCurrency(currency)"
                    class="flex items-center justify-between p-4 border rounded-xl cursor-pointer hover:border-blue-500 hover:bg-blue-50 transition-all"
                    :class="{'border-blue-500 bg-blue-50': selectedCurrency && selectedCurrency.symbol === currency.symbol && selectedCurrency.network_id === currency.network_id}"
                >
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center">
                            <img :src="currency.icon_url" />
                        </div>
                        <div>
                            <div class="font-semibold ">{{ currency.name }}</div>
                            <div class="text-sm "><network-icon :network-id="currency.network_id" :name="currency.network_name"/>{{ currency.network_name }}</div>
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="font-semibold ">≈ {{ currency.estimated_amount }}</div>
                        <div class="text-sm ">{{ currency.symbol }}</div>
                    </div>
                </div>
                <div v-if="loading">
                    <div class="flex justify-center items-center py-6">
                        <div
                            class="w-12 h-12 border-4 border-gray-300 border-t-blue-600 rounded-full"
                            style="animation: spin 1s linear infinite"
                        ></div>
                    </div>
                </div>
            </div>

            <div v-if="selecting" class="mt-4 flex justify-center">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600"></div>
            </div>
        </div>

        <!-- Payment Details -->
        <div v-else-if="isAwaitingPayment" class="p-6">
            <div class="text-center mb-6">
                <div class="text-sm  mb-2">{{ $t('Send exactly') }}</div>
                <div class="flex items-center justify-center space-x-2">
                    <span class="text-3xl font-bold ">{{ paymentDetails.amount_crypto }}</span>
                    <span class="text-xl ">{{ paymentDetails.currency }}</span>
                </div>
                <!--<div class="text-sm  mt-1">{{ paymentDetails.currency.symbol }}</div>-->
            </div>

            <!-- QR Code -->
            <div v-if="showQrCode && qrCodeData" class="flex justify-center mb-6">
                <div class="p-4  border rounded-xl">
                    <qr-code :size="180" :text="qrCodeData"></qr-code>
                </div>
            </div>

            <!-- Address -->
            <div class="mb-4">
                <label class="block text-sm  mb-2">{{ $t('Deposit Address') }}</label>
                <div class="flex items-center space-x-2">
                    <input
                        type="text"
                        :value="paymentDetails.address"
                        readonly
                        class="flex-1 p-3  border rounded-lg text-sm font-mono"
                    />
                    <button
                        @click="doCopy(paymentDetails.address)"
                        class="p-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                    >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Memo (if required) -->
            <div v-if="paymentDetails.memo" class="mb-4">
                <label class="block text-sm  mb-2">{{ $t('Memo / Tag') }} <span class="text-red-500">*</span></label>
                <div class="flex items-center space-x-2">
                    <input
                        type="text"
                        :value="paymentDetails.memo"
                        readonly
                        class="flex-1 p-3  border rounded-lg text-sm font-mono"
                    />
                    <button
                        @click="doCopy(paymentDetails.memo)"
                        class="p-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                    >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                        </svg>
                    </button>
                </div>
                <p class="mt-1 text-xs text-red-500">{{ $t('Important: Include the memo or your payment may be lost') }}</p>
            </div>

            <!-- Timer -->
            <div v-if="hasPaymentExpiry" class="flex items-center justify-between p-3 bg-yellow-50 border border-yellow-200 rounded-lg mb-4">
                <div class="flex items-center space-x-2">
                    <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="text-sm text-yellow-800">{{ $t('Time remaining') }}</span>
                </div>
                <span class="font-mono font-bold text-yellow-800">{{ formattedPaymentExpiry }}</span>
            </div>
            <!-- Loading timer placeholder -->
            <div v-else class="flex items-center justify-between p-3  border border-gray-200 rounded-lg mb-4">
                <div class="flex items-center space-x-2">
                    <div class="animate-spin rounded-full h-5 w-5 border-b-2 border-gray-400"></div>
                    <span class="text-sm ">{{ $t('Loading...') }}</span>
                </div>
            </div>

            <!-- Detecting/Confirming Status -->
            <div v-if="isDetecting || isConfirming" class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
                <div class="flex items-center space-x-3">
                    <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-blue-600"></div>
                    <div>
                        <div class="font-semibold text-blue-800">
                            {{ isDetecting ? $t('Payment Detected') : $t('Confirming Payment') }}
                        </div>
                        <div class="text-sm text-blue-600">
                            {{ confirmations }} / {{ requiredConfirmations }} {{ $t('confirmations') }}
                        </div>
                    </div>
                </div>
                <div class="mt-3 h-2 bg-blue-200 rounded-full overflow-hidden">
                    <div class="h-full bg-blue-600 transition-all duration-500" :style="{width: confirmationProgress + '%'}"></div>
                </div>
            </div>
        </div>

        <!-- Success State -->
        <div v-else-if="isPaid" class="p-6 text-center">
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <h3 class="text-2xl font-bold  mb-2">{{ $t('Payment Successful') }}</h3>
            <p class=" mb-6">{{ $t('Your payment has been confirmed') }}</p>
            <a
                v-if="invoice.redirect_url"
                :href="invoice.redirect_url"
                class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
            >
                {{ $t('Return to Merchant') }}
            </a>
        </div>

        <!-- Expired State -->
        <div v-else-if="isExpired" class="p-6 text-center">
            <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-10 h-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
            </div>
            <h3 class="text-2xl font-bold  mb-2">{{ $t('Invoice Expired') }}</h3>
            <p class=" mb-6">{{ $t('This payment request has expired') }}</p>
            <button
                v-if="invoice.cancel_url"
                @click="handleCancel"
                class="px-6 py-3 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors"
            >
                {{ $t('Go Back') }}
            </button>
        </div>

        <!-- Footer -->
        <div class="px-6 py-4  border-t text-center">
            <p class="text-xs ">
                {{ $t('Secured by') }} <span class="font-semibold">{{ $page.props.siteName }}</span>
            </p>
        </div>
    </div>
</div>
