<!-- MODULE ORDEROPEN START -->
<div class="module module-orderopen">
    <div class="module-container">

        <!-- module head start -->
        <div class="module-head">
            <div class="module-orderopen__navigation">
                <div @click="setActiveTab('positions')" :class="{ 'module-orderopen__navigation-active': activeTab == 'positions' }" class="module-orderopen__navigation-title">
                    <h4>
                        {{ $t('Open Positions') }}
                        <span v-if="positionsCount > 0" class="tab-count">({{ positionsCount }})</span>
                    </h4>
                </div>
	                <div @click="setActiveTab('orders')" :class="{ 'module-orderopen__navigation-active': activeTab == 'orders' }" class="module-orderopen__navigation-title">
	                    <h4>
	                        {{ $t('Open Orders') }}
	                        <span v-if="limitOrdersCount > 0" class="tab-count">({{ limitOrdersCount }})</span>
	                    </h4>
	                </div>
	                <div @click="$emit('trade-records')" class="module-orderopen__navigation-title">
	                    <h4>{{ $t('Trade Records') }}</h4>
	                </div>
	            </div>
	        </div>
        <!-- module head start -->

        <!-- module body start -->
        <div class="module-body">

            <!-- module orderopen table start -->
            <div class="module-orderopen__table">

                <!-- Open Positions Table -->
                <template v-if="activeTab == 'positions'">
                    <div class="module-orderopen__table-title table-title">
                        <div class="table-title__name">{{ $t('Pair') }}</div>
                        <div class="table-title__name">{{ $t('Side') }}</div>
                        <div class="table-title__name">{{ $t('Enter Price') }}</div>
                        <div class="table-title__name">{{ $t('Quantity') }}</div>
                        <div class="table-title__name">{{ $t('Liquidation') }}</div>
                        <div class="table-title__name">{{ $t('Leverage') }}</div>
                        <div class="table-title__name">{{ $t('TP') }}</div>
                        <div class="table-title__name">{{ $t('SL') }}</div>
                        <div class="table-title__name">{{ $t('PNL') }}</div>
                        <div class="table-title__name"></div>
                    </div>

                    <div v-if="futuresPositions" v-for="order in futuresPositions" class="module-orderopen__table-list table-list">
                        <div class="table-list__item">
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Pair') }}</span>
                                {{ order.market ? order.market : market.name }}
                            </div>
                            <div :class="{'color-sell' : !order.is_long, 'color-buy': order.is_long}" class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Side') }}</span>
                                {{ order.is_long ? 'Long' : 'Short'}}
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Enter Price') }}</span>
                                {{ order.price }} {{ order.quoteSymbol }}
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Quantity') }}</span>
                                {{ order.balance }} {{ order.quoteSymbol }}
                            </div>

                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Liquidation') }}</span>
                                {{ order.liquidation_price }} {{ order.quoteSymbol }}
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Leverage') }}</span>
                                {{ order.leverage }}x
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('TP') }}</span>
                                <span v-if="order.take_profit_price && order.take_profit_price > 0" class="color-buy">
                                    {{ order.take_profit_price }} {{ order.quoteSymbol }}
                                </span>
                                <span v-else class="opacity-50">-</span>
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('SL') }}</span>
                                <span v-if="order.stop_loss_price && order.stop_loss_price > 0" class="color-sell">
                                    {{ order.stop_loss_price }} {{ order.quoteSymbol }}
                                </span>
                                <span v-else class="opacity-50">-</span>
                            </div>
                            <div class="table-list__item-value" :class="{'color-sell' : !isLivePnlProfitable(order), 'color-buy': isLivePnlProfitable(order)}">
                                <span class="table-list__subtitle">{{ $t('PNL') }}</span>
                                {{ formatLivePnlAmount(order) }} {{ order.quoteSymbol }} <br>({{ formatLivePnl(order) }}%)
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle"></span>
                                <button @click="cancelOrder(order)"  class="table-list__item-button btn-warning">{{ $t('Close Position') }}</button>
                            </div>
                        </div>
                    </div>
                </template>

                <!-- Open Orders Table (Limit Orders) -->
                <template v-if="activeTab == 'orders'">
                    <div class="module-orderopen__table-title table-title">
                        <div class="table-title__name">{{ $t('Pair') }}</div>
                        <div class="table-title__name">{{ $t('Side') }}</div>
                        <div class="table-title__name">{{ $t('Price') }}</div>
                        <div class="table-title__name">{{ $t('Size') }}</div>
                        <div class="table-title__name">{{ $t('Leverage') }}</div>
                        <div class="table-title__name">{{ $t('TP') }}</div>
                        <div class="table-title__name">{{ $t('SL') }}</div>
                        <div class="table-title__name">{{ $t('Type') }}</div>
                        <div class="table-title__name"></div>
                    </div>

                    <div v-if="futuresLimitOrders" v-for="order in futuresLimitOrders" class="module-orderopen__table-list table-list">
                        <div class="table-list__item">
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Pair') }}</span>
                                {{ order.market ? order.market : market.name }}
                            </div>
                            <div :class="{'color-sell' : !order.is_long, 'color-buy': order.is_long}" class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Side') }}</span>
                                {{ order.is_long ? 'Long' : 'Short'}}
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Price') }}</span>
                                {{ order.price }} {{ order.quoteSymbol }}
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Size') }}</span>
                                {{ order.balance }} {{ order.quoteSymbol }}
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Leverage') }}</span>
                                {{ order.leverage }}x
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('TP') }}</span>
                                <span v-if="order.take_profit_price && order.take_profit_price > 0" class="color-buy">
                                    {{ order.take_profit_price }} {{ order.quoteSymbol }}
                                </span>
                                <span v-else class="opacity-50">-</span>
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('SL') }}</span>
                                <span v-if="order.stop_loss_price && order.stop_loss_price > 0" class="color-sell">
                                    {{ order.stop_loss_price }} {{ order.quoteSymbol }}
                                </span>
                                <span v-else class="opacity-50">-</span>
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle">{{ $t('Type') }}</span>
                                {{ $t('Limit') }}
                            </div>
                            <div class="table-list__item-value">
                                <span class="table-list__subtitle"></span>
                                <button @click="cancelOrder(order)"  class="table-list__item-button btn-warning">{{ $t('Cancel') }}</button>
                            </div>
                        </div>
                    </div>
                </template>

            </div>
            <!-- module orderopen table end -->

            <!-- module orderopen login start -->
            <div v-if="!$page.props.user" class="module-orderopen__login">
                <div class="module-orderopen__login-text">
                    <Link :href="route('login')">{{ $t('Log In') }}</Link>
                    {{ $t('or') }}
                    <Link :href="route('register')">{{ $t('Register Now') }}</Link>
                    {{ $t('to trade') }}
                </div>
            </div>
            <!-- module orderopen login end -->

            <!-- module orderopen notfont start -->
            <div v-if="$page.props.user && activeTab == 'positions' && futuresPositions && futuresPositions.length == 0" class="module-orderopen__notfont">
                <span class="module-orderopen__notfont-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path class="module-orderopen__notfont-icon__color" d="M21 13V11C21 7.73081 21 6.09621 20.3272 4.86413C19.8219 3.93873 19.0613 3.17807 18.1359 2.67277C16.9038 2 15.2692 2 12 2V2C8.73081 2 7.09621 2 5.86413 2.67277C4.93873 3.17807 4.17807 3.93873 3.67277 4.86413C3 6.09621 3 7.73081 3 11V12.5C3 16.2433 3 18.1149 3.87311 19.4735C4.29935 20.1368 4.86322 20.7006 5.52648 21.1269C6.88505 22 8.7567 22 12.5 22V22H13" stroke="#222628"/>
                        <line class="module-orderopen__notfont-icon__color" x1="15.5" y1="13.5" x2="7.5" y2="13.5"/>
                        <line class="module-orderopen__notfont-icon__color" x1="15.5" y1="10.5" x2="7.5" y2="10.5"/>
                        <line class="module-orderopen__notfont-icon__color" x1="11.5" y1="7.5" x2="7.5" y2="7.5"/>
                        <rect class="module-orderopen__notfont-icon__color color-yellow" x="14.8335" y="14.8335" width="7.08333" height="7.08333" rx="3.54167"/>
                        <line class="module-orderopen__notfont-icon__color color-yellow" x1="21.1803" y1="21.3066" x2="22.5565" y2="22.6829"/>
                    </svg>
                </span>
                <span class="module-orderopen__notfont-text">
                    {{ $t('No Positions Found.') }}
                </span>
            </div>
            <div v-if="$page.props.user && activeTab == 'orders' && futuresLimitOrders && futuresLimitOrders.length == 0" class="module-orderopen__notfont">
                <span class="module-orderopen__notfont-icon">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path class="module-orderopen__notfont-icon__color" d="M21 13V11C21 7.73081 21 6.09621 20.3272 4.86413C19.8219 3.93873 19.0613 3.17807 18.1359 2.67277C16.9038 2 15.2692 2 12 2V2C8.73081 2 7.09621 2 5.86413 2.67277C4.93873 3.17807 4.17807 3.93873 3.67277 4.86413C3 6.09621 3 7.73081 3 11V12.5C3 16.2433 3 18.1149 3.87311 19.4735C4.29935 20.1368 4.86322 20.7006 5.52648 21.1269C6.88505 22 8.7567 22 12.5 22V22H13" stroke="#222628"/>
                        <line class="module-orderopen__notfont-icon__color" x1="15.5" y1="13.5" x2="7.5" y2="13.5"/>
                        <line class="module-orderopen__notfont-icon__color" x1="15.5" y1="10.5" x2="7.5" y2="10.5"/>
                        <line class="module-orderopen__notfont-icon__color" x1="11.5" y1="7.5" x2="7.5" y2="7.5"/>
                        <rect class="module-orderopen__notfont-icon__color color-yellow" x="14.8335" y="14.8335" width="7.08333" height="7.08333" rx="3.54167"/>
                        <line class="module-orderopen__notfont-icon__color color-yellow" x1="21.1803" y1="21.3066" x2="22.5565" y2="22.6829"/>
                    </svg>
                </span>
                <span class="module-orderopen__notfont-text">
                    {{ $t('No Orders Found.') }}
                </span>
            </div>
            <!-- module orderopen notfont end -->

        </div>
        <!-- module body end -->
    </div>
</div>
<!-- MODULE ORDEROPEN END -->
