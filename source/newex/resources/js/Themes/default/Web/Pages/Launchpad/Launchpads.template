<app-layout>
    <Head>
        <title>{{ $t('Launchpads') }}</title>
        <meta name="description" content="">
    </Head>

    <div class="launchpad-page">
        <!-- Header Section -->
        <div class="launchpad-page__header">
            <div class="launchpad-page__header-content">
                <h1>{{ $t('Launchpad') }}</h1>
                <p>{{ $t('Discover and participate in token launches') }}</p>
            </div>
            <div class="launchpad-page__header-stats">
                <div class="launchpad-page__stat">
                    <span class="launchpad-page__stat-value">{{ launchpads.data ? launchpads.data.length : 0 }}</span>
                    <span class="launchpad-page__stat-label">{{ $t('Total Projects') }}</span>
                </div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="launchpad-page__tabs">
            <button @click="setSort('all')" class="launchpad-page__tab" :class="{'launchpad-page__tab--active': sort == 'all'}">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7"></rect>
                    <rect x="14" y="3" width="7" height="7"></rect>
                    <rect x="14" y="14" width="7" height="7"></rect>
                    <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                {{ $t('All') }}
            </button>
            <button @click="setSort('open')" class="launchpad-page__tab" :class="{'launchpad-page__tab--active': sort == 'open'}">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
                {{ $t('Active') }}
            </button>
            <button @click="setSort('upcoming')" class="launchpad-page__tab" :class="{'launchpad-page__tab--active': sort == 'upcoming'}">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                </svg>
                {{ $t('Upcoming') }}
            </button>
            <button @click="setSort('closed')" class="launchpad-page__tab" :class="{'launchpad-page__tab--active': sort == 'closed'}">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                    <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                {{ $t('Completed') }}
            </button>
        </div>

        <!-- Launchpad Cards Grid -->
        <div class="launchpad-page__grid">
            <div v-for="launchpad in launchpads.data" :key="launchpad.id" @click="setLaunchpad(launchpad)" class="launchpad-card">
                <div class="launchpad-card__header">
                    <div class="launchpad-card__coin">
                        <img :src="launchpad.currency_logo" :alt="launchpad.currency_symbol" class="launchpad-card__logo" />
                        <div class="launchpad-card__coin-info">
                            <span class="launchpad-card__symbol">{{ launchpad.currency_symbol }}</span>
                            <span class="launchpad-card__name">{{ launchpad.name }}</span>
                        </div>
                    </div>
                    <div class="launchpad-card__status" :class="{
                        'launchpad-card__status--active': launchpad.status == 'open',
                        'launchpad-card__status--upcoming': launchpad.status == 'pending',
                        'launchpad-card__status--closed': launchpad.status == 'closed'
                    }">
                        <template v-if="launchpad.status == 'open'">{{ $t('Active') }}</template>
                        <template v-if="launchpad.status == 'pending'">{{ $t('Upcoming') }}</template>
                        <template v-if="launchpad.status == 'closed'">{{ $t('Closed') }}</template>
                    </div>
                </div>

                <div class="launchpad-card__body">
                    <!-- Progress Bar -->
                    <div class="launchpad-card__progress">
                        <div class="launchpad-card__progress-header">
                            <span>{{ $t('Progress') }}</span>
                            <span class="launchpad-card__progress-percent">{{ launchpad.filled }}%</span>
                        </div>
                        <div class="launchpad-card__progress-bar">
                            <div class="launchpad-card__progress-fill" :style="{ width: launchpad.filled + '%' }"></div>
                        </div>
                        <div class="launchpad-card__progress-values">
                            <span>{{ launchpad.raised_amount || 0 }}</span>
                            <span>{{ launchpad.hard_cap }}</span>
                        </div>
                    </div>

                    <!-- Details Grid -->
                    <div class="launchpad-card__details">
                        <div class="launchpad-card__detail">
                            <span class="launchpad-card__detail-label">{{ $t('Sale Price') }}</span>
                            <span class="launchpad-card__detail-value">{{ launchpad.rate }}</span>
                        </div>
                        <div class="launchpad-card__detail">
                            <span class="launchpad-card__detail-label">{{ $t('Soft Cap') }}</span>
                            <span class="launchpad-card__detail-value">{{ launchpad.soft_cap }}</span>
                        </div>
                        <div class="launchpad-card__detail">
                            <span class="launchpad-card__detail-label">{{ $t('Hard Cap') }}</span>
                            <span class="launchpad-card__detail-value">{{ launchpad.hard_cap }}</span>
                        </div>
                        <div class="launchpad-card__detail">
                            <span class="launchpad-card__detail-label">{{ $t('Period') }}</span>
                            <span class="launchpad-card__detail-value launchpad-card__detail-value--small">{{ launchpad.start_time }}<br>{{ launchpad.end_time }}</span>
                        </div>
                    </div>
                </div>

                <div class="launchpad-card__footer">
                    <button v-if="launchpad.status == 'open'" class="launchpad-card__btn launchpad-card__btn--primary">
                        {{ $t('Participate') }}
                    </button>
                    <button v-else-if="launchpad.status == 'pending'" class="launchpad-card__btn launchpad-card__btn--upcoming">
                        {{ $t('Coming Soon') }}
                    </button>
                    <button v-else class="launchpad-card__btn launchpad-card__btn--closed">
                        {{ $t('View Details') }}
                    </button>
                </div>
            </div>

            <!-- Empty State -->
            <div v-if="launchpads.data && launchpads.data.length == 0" class="launchpad-page__empty">
                <div class="launchpad-page__empty-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
                        <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
                        <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
                        <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
                    </svg>
                </div>
                <h3>{{ $t('No Launchpads Found') }}</h3>
                <p>{{ $t('Check back later for new token launches.') }}</p>
            </div>
        </div>
    </div>
</app-layout>
