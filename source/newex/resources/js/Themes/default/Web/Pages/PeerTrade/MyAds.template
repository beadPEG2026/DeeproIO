                            <div class="table-div-body-column-container">
                                <div class="div-items-center mb-1 font-500">{{ ad.amount }} {{ ad.coin.symbol }}</div>
                                <div class="div-items-center mb-1 font-500">
                                    {{ ad.completed_quantity }} {{ ad.coin.symbol }}
                                </div>
                                <div class="">{{ ad.min_amount }}-{{ ad.max_amount }} {{ ad.fiat.symbol }}</div>
