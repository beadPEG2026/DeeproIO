                                    {{ ad.updated_at }}
                                </div>
                                <div class="div-items-center mb-1">
                                    {{ ad.created_at }}
                                </div>
                            </div>
                        </div>
                        <div style="width: 18%" class="table-div-body-column">
                            <div class="table-div-body-column-container">
                                <div class="div-items-center font-500 mb-1">
                                    <div class="color-buy" v-if="ad.status == 'active'">{{ $t('Published') }}</div>
                                    <div class="color-gray" v-if="ad.status == 'draft'">{{ $t('Offline') }}</div>
                                    <div class="color-gray" v-if="ad.status == 'closed'">{{ $t('Archived') }}</div>
                                    <div class="color-gray flex" v-if="ad.status == 'hidden'">
                                        <div>
                                            {{ $t('Hidden by System') }}
                                        </div>
                                        <div v-tooltip.right-end="{ content: $t(ad.hidden_reason == 'less_min_amount'? 'Ad is hidden due to insufficient available amount. Please top-up funds to display Ad.': ''), classes: 'toolTip' }">
                                            <font-awesome-icon icon="info-circle" class="ml-1 cursor-pointer focus:outline-none" />
                                        </div>
                                    </div>
                                </div>
                            </div>
