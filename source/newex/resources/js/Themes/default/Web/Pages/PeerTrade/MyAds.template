<app-layout>

    <Head>
        <title>{{ $t('My P2P Ads')}}</title>
        <meta name="description" content="">
    </Head>

<top-menu :label="$t('My Ads')"></top-menu>

<div class="components-filter components-filter-mob">
    <div class="flex flex-wrap">
            <div class="w-full flex justify-between flex-col-mob flex-col-desktop">
                <div class="components-filter__item">
                    <label>{{ $t('Currency:') }}</label>
                    <t-rich-user-select
                        :options="currencies.data"
                        v-model="form.coin"
                        :placeholder="$t('Select coin')"
                        value-attribute="id"
                        text-attribute="name"
                        :clearable="true"
                    >
                        <template
                            slot="label"
                            slot-scope="{ className, option, query }"
                        >
                            <div class="flex">
                                <div class="flex flex-col">
                                    <span>{{ option.text }}</span>
                                </div>
                            </div>
                        </template>
                    </t-rich-user-select>
                </div>
                <div class="components-filter__item">
                    <label>{{ $t('Fiat Currency:') }}</label>
                    <t-rich-user-select
                        :options="fiatCurrencies.data"
                        v-model="form.fiat"
                        :placeholder="$t('Select fiat')"
                        value-attribute="id"
                        text-attribute="name"
                        :clearable="true"

                    >
                        <template
                            slot="label"
                            slot-scope="{ className, option, query }"
                        >
                            <div class="flex">
                                <div class="flex flex-col">
                                    <span>{{ option.text }}</span>
                                </div>
                            </div>
                        </template>
                    </t-rich-user-select>
                </div>
                <div class="w-full lg:w-1/2 components-filter__item8">
                    <label>{{ $t('Status')}}</label>
                    <t-rich-user-select
                        :options="statuses"
                        v-model="form.status"
                        value-attribute="id"
                        text-attribute="name"
                        :clearable="false"
                        :hideSearchBox="true"
                    >
                    </t-rich-user-select>
                </div>

                <div class="w-full lg:w-1/2 components-filter__item8">
                    <label>{{ $t('Type')}}</label>
                    <t-rich-user-select
                        :options="types"
                        v-model="form.type"
                        value-attribute="id"
                        text-attribute="name"
                        :clearable="false"
                        :hideSearchBox="true"
                    >
                    </t-rich-user-select>
                </div>

                <div class="w-full lg:w-1/2 components-filter__item components-filter__picker">
                    <label class="form-label d-block">{{ $t('Date:') }}</label>
                    <t-datepicker
                        :range="true"
                        :placeholder="$t('Select Period')"
                        v-model="form.date"
                        dateFormat="Y-m-d"
                        userFormat="Y-m-d"
                    />
                </div>

                <div class="w-full lg:w-1/2 components-filter__item">
                    <text-user-input :placeholder="$t('Search Ad ID')" v-model="form.ad_id" :label="$t('Ad ID')" />
                </div>
            </div>
        </div>
</div>

<!-- table components start -->
<div class="table-components">

    <!-- tables start -->
    <div class="table-div table-div-desktop">
        <!-- thead start -->
        <div class="table-div-head">
            <div style="width: 18%" class="table-div-head-column">
                <div class="table-sort__value">
                    <span class="">
                        <div>{{ $t('Ad Number') }}</div>
                        <div>{{ $t('Type') }}</div>
                        <div>{{ $t('Asset/Fiat') }}</div>
                    </span>
                </div>
            </div>
            <div style="width: 18%" class="table-div-head-column">
                <div class="table-sort__value">
                    <span class="">
                        <div>{{ $t('Total Amount') }}</div>
                        <div>{{ $t('Completed Trade QTY.') }}</div>
                        <div>{{ $t('Order Limit') }}</div>
                    </span>
                </div>
            </div>
            <div style="width: 18%" class="table-div-head-column">
                <div class="table-sort__value">
                    <span class="">
                        <div>{{ $t('Price') }}</div>
                    </span>
                </div>
            </div>
            <div style="width: 18%" class="table-div-head-column">
                <div class="table-sort__value">
                    <span class="">
                        <div>{{ $t('Payment Method') }}</div>
                    </span>
                </div>
            </div>
            <div style="width: 18%" class="table-div-head-column">
                <div class="table-sort__value">
                    <span class="">
                        <div>{{ $t('Last Updated') }}</div>
                        <div>{{ $t('Create Time') }}</div>
                    </span>
                </div>
            </div>
            <div style="width: 18%" class="table-div-head-column">
                <div class="table-sort__value">
                    <span class="">
                        <div>{{ $t('Status') }}</div>
                    </span>
                </div>
            </div>
            <div style="width: 18%" class="table-div-head-column">
                <div class="table-sort__value">
                    <span class="">
                        <div>{{ $t('Actions') }}</div>
                    </span>
                </div>
            </div>
        </div>
        <!-- thead end -->
        <!-- tbody start -->
        <div class="table-div-body">
                <div class="table-div-body-rows" v-for="(ad, key) in ads.data">
                    <div class="table-div-body-rows-inner">
                        <div style="width: 18%" class="table-div-body-column">

                            <div class="table-div-body-column-container">
                                <div class="mb-1 div-items-center flex">
                                    <div :class="{'font-500 color-buy': ad.type == 'buy', 'font-500 color-sell': ad.type == 'sell'}">{{ ad.type == 'buy' ? 'Buy' : 'Sell' }}</div><div class="">{{ ad.coin.symbol }} / {{ ad.fiat.symbol }}</div>
                                </div>
                                <div class=" flex">
                                    {{ ad.short_id }}
                                    <div @click="doCopy(ad.id)" class="copy-icon">
                                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <rect class="list-text__icon-color" x="1" y="2" width="17" height="16" rx="2"/>
