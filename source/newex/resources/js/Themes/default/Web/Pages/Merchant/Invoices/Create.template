<app-layout>
    <Head>
        <title>{{ $t('Create Invoice') }}</title>
    </Head>

    <merchant-top-menu :label="$t('Create Invoice')"></merchant-top-menu>

    <div class="container mx-auto py-6 merchant-container">
        <div class="max-w-2xl mx-auto">
            <!-- Header -->
            <div class="mb-6">
                <h1 class="text-2xl font-bold ">{{ $t('Create Invoice') }}</h1>
                <p class=" mt-1">{{ $t('Generate a new payment request') }}</p>
            </div>

            <!-- Restriction Notice -->
            <div v-if="!canOperate && operationRestriction" class="mb-6 rounded-xl p-4 border-l-4"
                :class="{
                    'bg-yellow-50 border-yellow-500': operationRestriction.type === 'pending',
                    'bg-red-50 border-red-500': operationRestriction.type === 'suspended' || operationRestriction.type === 'rejected',
                    'bg-orange-50 border-orange-500': operationRestriction.type === 'unverified' || operationRestriction.type === 'inactive'
                }">
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <svg v-if="operationRestriction.type === 'pending'" class="h-6 w-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <svg v-else-if="operationRestriction.type === 'suspended' || operationRestriction.type === 'rejected'" class="h-6 w-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                        <svg v-else class="h-6 w-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-semibold"
                            :class="{
                                'text-yellow-800': operationRestriction.type === 'pending',
                                'text-red-800': operationRestriction.type === 'suspended' || operationRestriction.type === 'rejected',
                                'text-orange-800': operationRestriction.type === 'unverified' || operationRestriction.type === 'inactive'
                            }">
                            {{ $t(operationRestriction.title) }}
                        </h3>
                        <p class="mt-1 text-sm"
                            :class="{
                                'text-yellow-700': operationRestriction.type === 'pending',
                                'text-red-700': operationRestriction.type === 'suspended' || operationRestriction.type === 'rejected',
                                'text-orange-700': operationRestriction.type === 'unverified' || operationRestriction.type === 'inactive'
                            }">
                            {{ $t(operationRestriction.message) }}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Form -->
            <div class=" rounded-xl shadow-sm p-6 rounded-card" :class="{ 'opacity-60 pointer-events-none': !canOperate }">
                <form @submit.prevent="createInvoice">
                    <!-- Amount -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium  mb-2">{{ $t('Amount (USD)') }} *</label>
                        <div class="relative">
                            <span class="absolute left-3 top-1/2 transform -translate-y-1/2 ">$</span>
                            <input
                                v-model="form.amount"
                                type="number"
                                step="0.01"
                                :min="limits.min_amount_usd"
                                :max="limits.max_amount_usd"
                                class="w-full pl-8 pr-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 merchant-input"
                                :class="{'border-red-500': errors.amount}"
                                :placeholder="$t('Enter amount')"
                                required
                            />
                        </div>
                        <p v-if="errors.amount" class="mt-1 text-sm text-red-500">{{ errors.amount[0] }}</p>
                        <p class="mt-1 text-sm ">
                            {{ $t('Min') }}: {{ limits.min_amount_usd }} {{ $t("USD |") }} {{ $t('Max') }}: {{ limits.max_amount_usd }} USD
                        </p>
                    </div>

                    <!-- Description -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium  mb-2">{{ $t('Description') }}</label>
                        <textarea
                            v-model="form.description"
                            rows="3"
                            class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input focus:border-blue-500"
                            :placeholder="$t('What is this payment for?')"
                        ></textarea>
                    </div>

                    <!-- Customer Info -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Customer Email') }}</label>
                            <input
                                v-model="form.customer_email"
                                type="email"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input focus:border-blue-500"
                                :placeholder="$t('customer@example.com')"
                            />
                        </div>
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Customer Name') }}</label>
                            <input
                                v-model="form.customer_name"
                                type="text"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input focus:border-blue-500"
                                :placeholder="$t('John Doe')"
                            />
                        </div>
                    </div>

                    <!-- External ID -->
                    <div class="mb-6">
                        <label class="block text-sm font-medium  mb-2">{{ $t('External ID') }}</label>
                        <input
                            v-model="form.external_id"
                            type="text"
                            class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input focus:border-blue-500"
                            :placeholder="$t('Your order ID or reference')"
                        />
                        <p class="mt-1 text-sm ">{{ $t('Use this to link the invoice to your system') }}</p>
                    </div>

                    <!-- Redirect URLs -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Success Redirect URL') }}</label>
                            <input
                                v-model="form.redirect_url"
                                type="url"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input focus:border-blue-500"
                                placeholder="https://yoursite.com/success"
                            />
                        </div>
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Cancel Redirect URL') }}</label>
                            <input
                                v-model="form.cancel_url"
                                type="url"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input focus:border-blue-500"
                                placeholder="https://yoursite.com/cancel"
                            />
                        </div>
                    </div>

                    <!-- Submit -->
                    <div class="flex items-center justify-end space-x-4">
                        <button
                            type="button"
                            @click="goToInvoices"
                            class="px-6 py-3 border border-gray-300  rounded-lg hover: transition-colors"
                        >
                            {{ $t('Cancel') }}
                        </button>
                        <button
                            type="submit"
                            :disabled="!canSubmit"
                            class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center space-x-2"
                        >
                            <span v-if="sending" class="animate-spin rounded-full h-4 w-4 border-b-2 border-white"></span>
                            <span>{{ $t('Create Invoice') }}</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div v-if="showSuccessModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
        <div class=" rounded-xl w-full max-w-md p-6 merchant-modal shadow-md">
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                </div>
                <h3 class="text-xl font-bold ">{{ $t('Invoice Created!') }}</h3>
            </div>

            <div class="mb-6">
                <label class="block text-sm  mb-2">{{ $t('Checkout URL') }}</label>
                <div class="flex items-center space-x-2">
                    <input
                        type="text"
                        :value="createdInvoice.checkout_url"
                        readonly
                        class="flex-1 px-3 py-2  border rounded-lg text-sm merchant-input"
                    />
                    <button
                        @click="doCopy(createdInvoice.checkout_url)"
                        class="p-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700"
                    >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                        </svg>
                    </button>
                </div>
            </div>

            <div class="flex flex-col space-y-3">
                <button
                    @click="openCheckout"
                    class="w-full px-4 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                >
                    {{ $t('Open Checkout Page') }}
                </button>
                <button
                    @click="createAnother"
                    class="w-full px-4 py-3 border border-gray-300  rounded-lg hover: transition-colors"
                >
                    {{ $t('Create Another Invoice') }}
                </button>
                <button
                    @click="goToInvoices"
                    class="w-full px-4 py-3  hover: transition-colors"
                >
                    {{ $t('Go to Invoices') }}
                </button>
            </div>
        </div>
    </div>
</app-layout>
