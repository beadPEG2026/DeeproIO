                            <template v-if="lending.status == 'closed'">{{ $t('Closed') }}</template>
                            <template v-if="lending.status == 'liquidated'">{{ $t('Liquidated') }}</template>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="table-list__subtitle">{{ $t('Actions') }}</div>
                    <div class="table-list__value">
                        <div class="table-list__link">

                            <template v-if="lending.status == 'active'">
                                <a @click.prevent="openRepayModal(lending, false)" v-if="lending.status == 'active'" href="#!">{{ $t('Repay') }}</a>
                                <a class="mr-2" @click.prevent="openRepayModal(lending, true)" v-if="lending.status == 'active'" href="#!">{{ $t('Add Collateral') }}</a>

                            </template>
                            <a @click.prevent="openRepayHistory(lending)" href="#!">{{ $t('Repayment History') }}</a>
                        </div>
                    </div>
                </td>
            </tr>
            </tbody>
            <!-- tbody end -->
            <!-- tfood start -->
            <tfoot class="table-result">
            <tr>
                <td colspan="100">
                    <div v-if="lendings.data && lendings.data.length == 0" class="table-result__notfound">
