                </th>
                <th>
                    <div class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Max Amount') }}</span>
                    </div>
                </th>
                <th>
                    <div class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Status') }}</span>
                    </div>
                </th>
                <th>
                    <div class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Actions') }}</span>
                    </div>
                </th>
            </tr>
            </thead>
            <!-- thead end -->
            <!-- tbody start -->
            <tbody class="table-list table-list-v2">
            <tr @click="openModal(lending)" v-for="lending in lendings.data" :key="lending.id"  class="table-list__cursor">
                <td>
                    <div class="table-list__subtitle">{{ $t('Coin') }}</div>
                    <div class="table-list__value">
                        <div class="table-list__image">
                            <img :src="lending.currency_logo" />
                        </div>
                        <div class="table-list__title">
                            <span class="table-list__title-big">{{ lending.currency_symbol }}</span>
                            <span class="table-list__title-small">{{ lending.currency }}</span>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="table-list__subtitle">{{ $t('Min amount') }}</div>
                    <div class="table-list__value">
                        <div class="table-list__title title-icon">
                            <div class="title-icon__name">{{ lending.min_amount }} {{ lending.currency_symbol }}</div>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="table-list__subtitle">{{ $t('Max amount') }}</div>
                    <div class="table-list__value">
                        <div class="table-list__title title-icon">
                            <div class="title-icon__name">{{ lending.max_amount }} {{ lending.currency_symbol }}</div>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="table-list__subtitle">{{ $t('Status') }}</div>
                    <div class="table-list__value">
                        <div class="components-label" :class="{'label-green': lending.status == 'active', 'label-orange': lending.status == 'sold'}">
                            <template v-if="lending.status == 'active'">{{ 'Active' }}</template>
                            <template v-if="lending.status == 'closed'">{{ $t('Closed') }}</template>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="table-list__subtitle">{{ $t('Actions') }}</div>
                    <div class="table-list__value">
                        <div class="table-list__link">
                            <a href="javascript:void(0)">{{ $t('Borrow') }}</a>
                        </div>
                    </div>
                </td>
            </tr>
            </tbody>
            <!-- tbody end -->

            <!-- tfood start -->
            <tfoot class="table-result">
            <tr>
                <td colspan="100">
                    <div v-if="lendings.data && lendings.data.length == 0" class="table-result__notfound">
                        <span class="table-result__notfound-icon">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path class="table-result__notfound-color" d="M21 13V11C21 7.73081 21 6.09621 20.3272 4.86413C19.8219 3.93873 19.0613 3.17807 18.1359 2.67277C16.9038 2 15.2692 2 12 2V2C8.73081 2 7.09621 2 5.86413 2.67277C4.93873 3.17807 4.17807 3.93873 3.67277 4.86413C3 6.09621 3 7.73081 3 11V12.5C3 16.2433 3 18.1149 3.87311 19.4735C4.29935 20.1368 4.86322 20.7006 5.52648 21.1269C6.88505 22 8.7567 22 12.5 22V22H13" stroke="#222628"/>
                                <line class="table-result__notfound-color" x1="15.5" y1="13.5" x2="7.5" y2="13.5"/>
                                <line class="table-result__notfound-color" x1="15.5" y1="10.5" x2="7.5" y2="10.5"/>
                                <line class="table-result__notfound-color" x1="11.5" y1="7.5" x2="7.5" y2="7.5"/>
