                </td>
                <td>
                    <div class="table-list__subtitle">{{ $t('Borrowed') }}</div>
                    <div class="table-list__value">
                        <div class="table-list__title title-icon">
                            <div class="title-icon__name">{{ lending.amount }} {{ lending.currency_symbol }}</div>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="table-list__subtitle">{{ $t('Current LTV') }}</div>
                    <div class="table-list__value">
                        <div class="table-list__title title-icon">
                            <div class="title-icon__name">
                                <template v-if="lending.status == 'active'">
                                    {{ lending.ltv }}%
                                </template>
                                <template v-else>
                                    {{ $t('N/A') }}
                                </template>

                            </div>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="table-list__subtitle">{{ $t('Remaining') }}</div>
                    <div class="table-list__value">
                        <div class="table-list__title title-icon">
                            <div class="title-icon__name">{{ lending.remaining_amount }} {{ lending.currency_symbol }}</div>
