    <!-- Show User  Modal -->
    <jet-dialog-modal :show="showLendingModal" @close="closeModal">
        <template #title>
            <div class="flex justify-between">
                <div>
                    {{ $t('Borrow') }}
                </div>
                <div @click="closeModal" class="cursor-pointer">
                    ✖
                </div>
            </div>

        </template>
        <template #content>
            <div v-if="lendingModal">
                <div class="modal-forms" id="main-modal-form">
                    <div id="swap-container" class="lending-container">
                        <div class="">
                            <div class="">
                                <div class="">
                                    <div class="components-filter__item">
                                        <label>{{ $t('Loan type:') }}</label>
                                        <t-rich-user-select
                                            :options="borrowTypes"
                                            v-model="form.type"
                                            :placeholder="$t('Select type')"
                                            value-attribute="id"
                                            text-attribute="name"
                                            :clearable="false"
                                            :hideSearchBox="true"
                                        >
                                            <template
                                                slot="label"
                                                slot-scope="{ className, option, query }"
                                            >
                                                <div class="flex">
                                                    <div class="flex flex-col">
                                                        <span>{{ option.text }}</span>
                                                    </div>
                                                </div>
                                            </template>
                                        </t-rich-user-select>
                                    </div>

                                    <div class="components-filter__item mt-6 dropdown-extended">
                                        <label>{{ $t('I want to borrow') }} {{ lendingModal.currency_symbol }}</label>
                                        <div class="swap-container-elements rounded filter-select w-full flex text-left mt-2 justify-between items-center px-3 py-2 transition duration-100 ease-in-out focus:border-gray-200 focus:ring-2 focus:ring-gray-200 focus:outline-none focus:ring-opacity-10 disabled:opacity-50 disabled:cursor-not-allowed bg-white border-gray-200">
                                            <div class="relative-right">
                                                <input placeholder="0.00" type="text" v-model="form.amount" @keyup="(e) => clearInput(e)" @keypress="(e) => handleInput(e)" @paste.prevent @drop.prevent   class="filter-select w-full flex text-left mt-1 justify-between items-center px-3 py-2 transition duration-100 ease-in-out focus:border-gray-200 focus:ring-2 focus:ring-gray-200 focus:outline-none focus:ring-opacity-10 disabled:opacity-50 disabled:cursor-not-allowed bg-white border-gray-200" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="components-filter__item mt-6 dropdown-extended">
                                        <label>{{ $t('Collateral') }}</label>
                                        <div class="swap-container-elements rounded filter-select w-full flex text-left mt-2 justify-between items-center px-3 py-2 transition duration-100 ease-in-out focus:border-gray-200 focus:ring-2 focus:ring-gray-200 focus:outline-none focus:ring-opacity-10 disabled:opacity-50 disabled:cursor-not-allowed bg-white border-gray-200">
                                            <div class="relative-right">
                                                <input readonly placeholder="" type="text" v-model="calculatedModel.amount" @keyup="(e) => clearInput(e)" @keypress="(e) => handleInput(e)" @paste.prevent @drop.prevent   class="filter-select w-full flex text-left mt-1 justify-between items-center px-3 py-2 transition duration-100 ease-in-out focus:border-gray-200 focus:ring-2 focus:ring-gray-200 focus:outline-none focus:ring-opacity-10 disabled:opacity-50 disabled:cursor-not-allowed bg-white border-gray-200" />
                                            </div>
                                            <t-rich-user-select
                                                v-model="form.collateral_id"
                                                :options="currencies"
                                                v-on:change="setupInitialData"
                                                :placeholder="$t('Select coin')"
                                                value-attribute="id"
                                                text-attribute="name"
                                                :clearable="false"
                                                :hideSearchBox="true"
                                            >
                                                <template
                                                    slot="label"
                                                    slot-scope="{ className, option, query }"
                                                >
                                                    <div class="flex">
                                                        <div class="flex flex-col">
                                                            <div class="swap-label flex items-stretch">
                                                                <img :src="option.text.logo" width="28" />
                                                                <span class="pt-1 ml-5">{{ option.text.name }}</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </template>
                                                <template
                                                    slot="option"
                                                    slot-scope="{ className, option, query }"
                                                >
                                                    <div class="flex">
                                                        <div class="flex flex-col">
                                                            <div class="flex items-stretch pt-2 pb-2 pl-2">
                                                                <img :src="option.text.logo" width="28" />
                                                                <span class="pt-1 ml-5">{{ option.text.name }}</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </template>
                                            </t-rich-user-select>
                                        </div>
                                    </div>
                                    <div class="components-filter__item block-info mt-6">
                                        <div>{{ $t('Annualized Interest Rate:') }}</div>
                                        <div v-if="form.type == 'flexible'">
                                            {{ lendingModal.annual_rate_flexible }}%
                                        </div>
                                        <div v-if="form.type == 'weekly'">
                                            {{ lendingModal.annual_rate_weekly }}%
                                        </div>
                                        <div v-if="form.type == 'monthly'">
                                            {{ lendingModal.annual_rate_monthly }}%
                                        </div>
                                    </div>
                                    <div class="components-filter__item block-info mt-2">
                                        <div>{{ $t('Estimated Hourly Interest:') }}</div>
                                        <div v-if="form.type == 'flexible'">
                                            {{ lendingModal.hourly_rate_flexible }}%
                                        </div>
                                        <div v-if="form.type == 'weekly'">
                                            {{ lendingModal.hourly_rate_weekly }}%
                                        </div>
                                        <div v-if="form.type == 'monthly'">
                                            {{ lendingModal.hourly_rate_monthly }}%
                                        </div>
                                    </div>
                                    <div class="components-filter__item block-info mt-2">
                                        <div>{{ $t('Initial LTV:') }}</div>
                                        <div v-if="!collateral">-</div>
                                        <div v-else>
                                            <template v-if="form.type == 'flexible'">{{ collateral.flex_initial_ltv }}%</template>
                                            <template v-if="form.type == 'weekly'">{{ collateral.weekly_initial_ltv }}%</template>
                                            <template v-if="form.type == 'monthly'">{{ collateral.monthly_initial_ltv }}%</template>
                                        </div>
                                    </div>
                                    <div class="components-filter__item block-info mt-2">
                                        <div>{{ $t('Liquidation LTV:') }}</div>
                                        <div v-if="!collateral">-</div>
                                        <div v-else>
                                            <template v-if="form.type == 'flexible'">{{ collateral.flex_liquidation_ltv }}%</template>
                                            <template v-if="form.type == 'weekly'">{{ collateral.weekly_liquidation_ltv }}%</template>
                                            <template v-if="form.type == 'monthly'">{{ collateral.monthly_liquidation_ltv }}%</template>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <template #footer>
            <div id="main-modal-footer">
                <jet-secondary-button @click.native="borrow()">
                    {{ $t('Start Borrowing') }}
                </jet-secondary-button>
            </div>
        </template>
    </jet-dialog-modal>

    <jet-dialog-modal :show="showRepayModal" @close="closeRepayModal">
        <template #title>
            <div class="flex justify-between">
                <div>
                    {{ isCollateral ? $t('Add Collateral') : $t('Repay') }}
                </div>
                <div @click="closeRepayModal" class="cursor-pointer">
                    ✖
                </div>
            </div>
        </template>
        <template #content>
            <div v-if="lendingModal">
                <div class="modal-forms" id="main-modal-form">
                    <div id="swap-container" class="lending-container">
                        <div class="">
                            <div class="">
                                <div class="">

                                    <div class="components-filter__item mt-6 dropdown-extended">
                                        <label>
                                            <template v-if="isCollateral">
                                                {{ $t('Collateral') }} {{ lendingModal.collateral_symbol }}
                                            </template>
                                            <template v-else>
                                                {{ $t('Repayment Amount') }} {{ lendingModal.currency_symbol }}
                                            </template>
                                        </label>
                                        <div class="swap-container-elements rounded filter-select w-full flex text-left mt-2 justify-between items-center px-3 py-2 transition duration-100 ease-in-out focus:border-gray-200 focus:ring-2 focus:ring-gray-200 focus:outline-none focus:ring-opacity-10 disabled:opacity-50 disabled:cursor-not-allowed bg-white border-gray-200">
