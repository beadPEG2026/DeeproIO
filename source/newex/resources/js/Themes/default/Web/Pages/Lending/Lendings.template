                </th>
                <th>
                    <div class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Borrowed') }}</span>
                    </div>
                </th>
                <th>
                    <div class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Current LTV') }}</span>
