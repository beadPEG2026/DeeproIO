        <div class="tabs-left">
            <div class="tabs-nav">
                <div @click="setSort('all')" class="tabs-nav__item" :class="{'tabs-nav__active': sort == 'all'}">
                    <h4>{{ $t('Available coins') }}</h4>
                </div>
                <div @click="setSort('my')" class="tabs-nav__item" :class="{'tabs-nav__active': sort == 'my'}">
                    <h4>{{ $t('My Lending') }}</h4>
                </div>
            </div>
        </div>
        <!-- tabs left end -->
    </div>
    <!-- tabs components end -->
    <!-- table components start -->
    <div v-if="sort == 'all'" class="table-components">
        <!-- tables start -->
        <table class="tables mob-table-lendings-available">
            <!-- thead start -->
            <thead class="table-sort">
            <tr>
                <th>
                    <div class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Coin') }}</span>
                    </div>
                </th>
                <th>
                    <div class="table-sort__value">
                        <span class="table-sort__title">{{ $t('Min Amount') }}</span>
