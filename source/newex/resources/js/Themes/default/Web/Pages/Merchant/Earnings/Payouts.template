<app-layout>
    <Head>
        <title>{{ $t('Payouts') }}</title>
    </Head>

    <merchant-top-menu :label="$t('Payouts')"></merchant-top-menu>

    <div class="container mx-auto py-6 merchant-container">
        <!-- Restriction Notice -->
        <div v-if="!canOperate && operationRestriction" class="mb-6 rounded-xl p-4 border-l-4"
            :class="{
                'bg-yellow-50 border-yellow-500': operationRestriction.type === 'pending',
                'bg-red-50 border-red-500': operationRestriction.type === 'suspended' || operationRestriction.type === 'rejected',
                'bg-orange-50 border-orange-500': operationRestriction.type === 'unverified' || operationRestriction.type === 'inactive'
            }">
            <div class="flex items-start">
                <div class="flex-shrink-0">
                    <svg v-if="operationRestriction.type === 'pending'" class="h-6 w-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <svg v-else-if="operationRestriction.type === 'suspended' || operationRestriction.type === 'rejected'" class="h-6 w-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                    <svg v-else class="h-6 w-6 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
                <div class="ml-3">
                    <h3 class="text-sm font-semibold"
                        :class="{
                            'text-yellow-800': operationRestriction.type === 'pending',
                            'text-red-800': operationRestriction.type === 'suspended' || operationRestriction.type === 'rejected',
                            'text-orange-800': operationRestriction.type === 'unverified' || operationRestriction.type === 'inactive'
                        }">
                        {{ $t(operationRestriction.title) }}
                    </h3>
                    <p class="mt-1 text-sm"
                        :class="{
                            'text-yellow-700': operationRestriction.type === 'pending',
                            'text-red-700': operationRestriction.type === 'suspended' || operationRestriction.type === 'rejected',
                            'text-orange-700': operationRestriction.type === 'unverified' || operationRestriction.type === 'inactive'
                        }">
                        {{ $t(operationRestriction.message) }}
                    </p>
                </div>
            </div>
        </div>

        <!-- Balance & Request Payout -->
        <div class="bg-gradient-to-r from-green-500 to-green-600 rounded-xl p-6 text-white mb-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <p class="text-green-100 text-sm">{{ $t('Available for Payout') }}</p>
                    <p class="text-4xl font-bold">{{ formatCurrency(merchant.available_balance_usd) }}</p>
                    <p class="text-green-100 text-sm mt-2">{{ $t('Minimum payout') }}: {{ formatCurrency(merchant.min_payout_amount_usd) }}</p>
                </div>
                <button
                    @click="openPayoutModal"
                    :disabled="!canOperate || parseFloat(merchant.available_balance_usd) < parseFloat(merchant.min_payout_amount_usd)"
                    class="mt-4 md:mt-0 px-6 py-3 bg-white text-green-600 rounded-lg font-semibold hover:bg-green-50 disabled:opacity-50 disabled:cursor-not-allowed"
                >

                    {{ $t('Request Payout') }}
                </button>
            </div>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class=" rounded-xl p-4 shadow-sm">
                <p class=" text-sm">{{ $t('Total Completed') }}</p>
                <p class="text-2xl font-bold text-green-600">{{ formatCurrency(stats.total_completed) }}</p>
                <p class="text-xs ">{{ stats.completed_count }} {{ $t('payouts') }}</p>
            </div>
            <div class=" rounded-xl p-4 shadow-sm">
                <p class=" text-sm">{{ $t('Pending') }}</p>
                <p class="text-2xl font-bold text-yellow-600">{{ formatCurrency(stats.total_pending) }}</p>
                <p class="text-xs ">{{ stats.pending_count }} {{ $t('requests') }}</p>
            </div>
            <div class=" rounded-xl p-4 shadow-sm">
                <p class=" text-sm">{{ $t('Total Fees Paid') }}</p>
                <p class="text-2xl font-bold text-red-600">{{ formatCurrency(stats.total_fees_paid) }}</p>
            </div>
            <div class=" rounded-xl p-4 shadow-sm">
                <p class=" text-sm">{{ $t('Total Payouts') }}</p>
                <p class="text-2xl font-bold ">{{ stats.payout_count }}</p>
            </div>
        </div>

        <!-- Filters -->
        <div class="components-filter">
            <div class="components-filter__row">
                <div class="components-filter__item">
                    <label>{{ $t('Status:') }}</label>
                    <t-rich-user-select
                        :options="statusOptions"
                        v-model="localFilters.status"
                        :placeholder="$t('Select status')"
                        value-attribute="id"
                        text-attribute="name"
                        :clearable="true"
                    >
                        <template slot="label" slot-scope="{ className, option, query }">
                            <div class="flex">
                                <div class="flex flex-col">
                                    <span>{{ option.text }}</span>
                                </div>
                            </div>
                        </template>
                    </t-rich-user-select>
                </div>

                <div class="components-filter__item">
                    <label>{{ $t('From Date:') }}</label>
                    <input type="date" v-model="localFilters.date_from" class="components-filter__input" />
                </div>

                <div class="components-filter__item">
                    <label>{{ $t('To Date:') }}</label>
                    <input type="date" v-model="localFilters.date_to" class="components-filter__input" />
                </div>

                <div class="components-filter__item">
                    <t-button-green @click.stop="applyFilters" class="components-filter__button mt-8 py-2 px-6" :class="{ 'opacity-75': sending }">
                        <span class="components-filter__icon">
                            <svg v-show="sending" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            {{ $t('Search') }}
                        </span>
                    </t-button-green>
                </div>

                <div class="components-filter__item">
                    <button @click="clearFilters" class="components-filter__button mt-8 py-2 px-6 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">
                        {{ $t('Clear') }}
                    </button>
                </div>
            </div>
        </div>

        <!-- Payouts Table -->
        <div class=" rounded-xl shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full merchant-table">
                    <thead class="">
                        <tr>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Reference') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Amount') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Fee') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Net Amount') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Status') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Date') }}</th>
                            <th class="px-6 py-3 text-left text-xs font-medium  uppercase">{{ $t('Actions') }}</th>
                        </tr>
                    </thead>
                    <tbody class="">
                        <tr v-for="payout in payouts.data" :key="payout.id" class="hover:">
                            <td class="px-6 py-4">
                                <span class="font-mono text-sm font-medium">{{ payout.reference }}</span>
                            </td>
                            <td class="px-6 py-4 font-medium">{{ formatCurrency(payout.amount_usd) }}</td>
                            <td class="px-6 py-4 text-red-600">-{{ formatCurrency(payout.fee_usd) }}</td>
                            <td class="px-6 py-4 text-green-600 font-medium">{{ formatCurrency(payout.net_amount_usd) }}</td>
                            <td class="px-6 py-4">
                                <div>
                                    <span :class="['px-2 py-1 rounded-full text-xs font-medium', getStatusClass(payout.status)]">
                                        {{ payout.status }}
                                    </span>
                                    <!-- Rejection Reason -->
                                    <div v-if="payout.status === 'rejected' && payout.rejection_reason" class="mt-2">
                                        <p class="text-xs text-red-600 flex items-start">
                                            <svg class="w-4 h-4 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                                            </svg>
                                            <span>{{ payout.rejection_reason }}</span>
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4  text-sm">{{ formatDate(payout.requested_at) }}</td>
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-2">
                                    <button
                                        v-if="payout.status === 'pending'"
                                        @click="cancelPayout(payout.id)"
                                        class="text-red-600 hover:text-red-700 text-sm"
                                    >
                                        {{ $t('Cancel') }}
                                    </button>
                                    <a
                                        v-if="payout.txn_hash && payout.explorer_url"
                                        :href="payout.explorer_url"
                                        target="_blank"
                                        class="text-blue-600 hover:text-blue-700 text-sm"
                                    >
                                        {{ $t('View TX') }}
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <tr v-if="!payouts.data || payouts.data.length === 0">
                            <td colspan="7" class="px-6 py-8 text-center ">{{ $t('No payouts found') }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div v-if="payouts.data && payouts.data.length > 0" class="py-4 px-4">
                <pagination :links="payouts.links" />
            </div>
        </div>
    </div>

    <!-- Payout Request Modal -->
    <div v-if="showPayoutModal" class="fixed inset-0 z-50 overflow-y-auto">
        <div class="flex items-center justify-center min-h-screen px-4">
            <div class="fixed inset-0 bg-black opacity-50" @click="closePayoutModal"></div>

            <div class="relative  rounded-xl shadow-xl max-w-md w-full p-6 merchant-modal">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-xl font-semibold ">{{ $t('Request Payout') }}</h3>
                    <button @click="closePayoutModal" class=" hover:">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </button>
                </div>

                <form @submit.prevent="submitPayout" class="space-y-4">
                    <!-- Amount -->
                    <div>
                        <label class="block text-sm font-medium  mb-1">{{ $t('Amount (USD)') }}</label>
                        <div class="relative">
                            <input
                                v-model="form.amount"
                                type="number"
                                step="0.01"
                                :min="minPayout"
                                :max="maxPayout"
                                class="w-full border rounded-lg px-3 py-2 pr-16 merchant-input"
                                :class="{'border-red-500': errors.amount}"
                                :placeholder="`Min: $${minPayout}`"
                            />
                            <button
                                type="button"
                                @click="setMaxAmount"
                                class="absolute right-2 top-2 -translate-y-1/2 text-xs bg-gray-100 hover:bg-gray-200 px-2 py-1 rounded"
                            >
                                MAX
                            </button>
                        </div>
                        <p v-if="errors.amount" class="text-red-500 text-xs mt-1">{{ errors.amount[0] }}</p>
                        <p class=" text-xs mt-1">{{ $t('Available') }}: {{ formatCurrency(maxPayout) }}</p>
                    </div>

                    <!-- Currency Selection -->
                    <div>
                        <label class="block text-sm font-medium  mb-1">{{ $t('Currency') }} *</label>
                        <themed-select
                            v-model="form.currency_id"
                            class="w-full border rounded-lg px-3 py-2 merchant-input"
                            :class="{'border-red-500': errors.currency_id}"
                            @change="form.network_id = ''"
                        >
                            <option value="">{{ $t('Select currency') }}</option>
                            <option v-for="currency in currencies" :key="currency.id" :value="currency.id">
                                {{ currency.symbol }} - {{ currency.name }}
                            </option>
                        </themed-select>
                        <p v-if="errors.currency_id" class="text-red-500 text-xs mt-1">{{ errors.currency_id[0] }}</p>
                    </div>

                    <!-- Network Selection -->
                    <div v-if="form.currency_id && selectedCurrency">
                        <label class="block text-sm font-medium  mb-1">{{ $t('Network') }} *</label>
                        <themed-select network
                            v-model="form.network_id"
                            class="w-full border rounded-lg px-3 py-2 merchant-input"
                            :class="{'border-red-500': errors.network_id}"
                        >
                            <option value="">{{ $t('Select network') }}</option>
                            <option v-for="network in availableNetworks" :key="network.id" :value="network.id">
                                {{ network.name }} ({{ network.slug }})
                            </option>
                        </themed-select>
                        <p v-if="errors.network_id" class="text-red-500 text-xs mt-1">{{ errors.network_id[0] }}</p>
                    </div>

                    <!-- Payout Address -->
                    <div>
                        <label class="block text-sm font-medium  mb-1">{{ $t('Payout Address') }} *</label>
                        <input
                            v-model="form.payout_address"
                            type="text"
                            class="w-full border rounded-lg px-3 py-2 merchant-input"
                            :class="{'border-red-500': errors.payout_address}"
                            :placeholder="$t('Enter wallet address')"
                        />
                        <p v-if="errors.payout_address" class="text-red-500 text-xs mt-1">{{ errors.payout_address[0] }}</p>
                        <p v-if="form.network_id && selectedCurrency" class="text-xs mt-1 text-gray-500">
                            {{ $t('Make sure the address is valid for') }} {{ selectedCurrency.symbol }} {{ $t('on the selected network') }}
                        </p>
                    </div>

                    <!-- Memo (optional) -->
                    <div>
                        <label class="block text-sm font-medium  mb-1">{{ $t('Memo / Tag (if required)') }}</label>
                        <input
                            v-model="form.payout_memo"
                            type="text"
                            class="w-full border rounded-lg px-3 py-2 merchant-input"
                            :placeholder="$t('Optional - required for some networks like XRP, TON')"
                        />
                    </div>

                    <!-- Notes -->
                    <div>
                        <label class="block text-sm font-medium  mb-1">{{ $t('Notes') }}</label>
                        <textarea
                            v-model="form.notes"
                            rows="2"
                            class="w-full border rounded-lg px-3 py-2 merchant-input"
                            :placeholder="$t('Optional notes for this payout')"
                        ></textarea>
                    </div>

                    <!-- Fee Summary -->
                    <div class=" rounded-lg p-4 space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="">{{ $t('Payout Amount') }}</span>
                            <span class="font-medium">{{ formatCurrency(form.amount || 0) }}</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="">{{ $t('Processing Fee (0.5%)') }}</span>
                            <span class="text-red-600">-{{ formatCurrency(payoutFee) }}</span>
                        </div>
                        <div class="flex justify-between text-sm font-semibold border-t pt-2">
                            <span>{{ $t('You will receive') }}</span>
                            <span class="text-green-600">{{ formatCurrency(netPayout) }}</span>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        :disabled="submitting || !form.amount || !form.payout_address || !form.currency_id || !form.network_id"
                        class="w-full px-4 py-3 bg-green-600 text-white rounded-lg font-semibold hover:bg-green-700 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center"
                    >
                        <span v-if="submitting" class="animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></span>
                        {{ submitting ? $t('Submitting...') : $t('Submit Payout Request') }}
                    </button>
                </form>
            </div>
        </div>
    </div>
</app-layout>
