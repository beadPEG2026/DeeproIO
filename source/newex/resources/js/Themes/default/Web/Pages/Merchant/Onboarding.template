<app-layout>
    <Head>
        <title>{{ pageTitle }}</title>
    </Head>
    <div class="container mx-auto px-4 py-12">
        <div class="max-w-2xl mx-auto">
            <!-- Rejection Banner -->
            <div v-if="isResubmission && rejectionReason" class="mb-8 bg-red-50 border border-red-200 rounded-xl p-6">
                <div class="flex items-start space-x-4">
                    <div class="flex-shrink-0">
                        <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                    </div>
                    <div class="flex-1">
                        <h3 class="text-lg font-semibold text-red-800 mb-2">{{ $t('Previous Application Rejected') }}</h3>
                        <p class="text-red-700 mb-3">{{ rejectionReason }}</p>
                        <p class="text-sm text-red-600">{{ $t('Please update your application and resubmit.') }} {{ $t('This is submission') }} #{{ submissionCount + 1 }}.</p>
                    </div>
                </div>
            </div>

            <div class="text-center mb-8">
                <h1 class="text-3xl font-bold  mb-4">
                    {{ isResubmission ? $t('Update Your Application') : $t('Start Accepting Crypto Payments') }}
                </h1>
                <p class="">
                    {{ isResubmission
                        ? $t('Please review the rejection reason above and update your application accordingly')
                        : $t('Apply to become a merchant and start receiving cryptocurrency payments from customers worldwide')
                    }}
                </p>
            </div>

            <div class=" rounded-xl shadow-sm p-8">
                <form @submit.prevent="submitApplication">
                    <div class="space-y-6">
                        <!-- Business Name -->
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Business Name') }} *</label>
                            <input
                                v-model="form.business_name"
                                type="text"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input"
                                :class="{'border-red-500': errors.business_name}"
                                required
                            />
                            <p v-if="errors.business_name" class="mt-1 text-sm text-red-500">{{ errors.business_name[0] }}</p>
                        </div>

                        <!-- Business Email -->
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Business Email') }} *</label>
                            <input
                                v-model="form.business_email"
                                type="email"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input"
                                :class="{'border-red-500': errors.business_email}"
                                required
                            />
                            <p v-if="errors.business_email" class="mt-1 text-sm text-red-500">{{ errors.business_email[0] }}</p>
                        </div>

                        <!-- Website -->
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Website URL') }}</label>
                            <input
                                v-model="form.website_url"
                                type="url"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input"
                                placeholder="https://yourwebsite.com"
                            />
                        </div>

                        <!-- Description -->
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Business Description') }}</label>
                            <textarea
                                v-model="form.description"
                                rows="4"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input"
                                :placeholder="$t('Tell us about your business and how you plan to use crypto payments')"
                            ></textarea>
                        </div>

                        <!-- Terms -->
                        <div class="flex items-start space-x-3">
                            <input
                                v-model="form.agree_terms"
                                type="checkbox"
                                id="agree_terms"
                                class="mt-1"
                                required
                            />
                            <label for="agree_terms" class="text-sm ">
                                {{ $t('I agree to the') }}
                                <a href="#" class="text-blue-600 hover:text-blue-700">{{ $t('Terms of Service') }}</a>
                                {{ $t('and') }}
                                <a href="#" class="text-blue-600 hover:text-blue-700">{{ $t('Merchant Agreement') }}</a>
                            </label>
                        </div>

                        <!-- Submit -->
                        <button
                            type="submit"
                            :disabled="sending || !form.agree_terms"
                            class="w-full px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center space-x-2"
                        >
                            <span v-if="sending" class="animate-spin rounded-full h-5 w-5 border-b-2 border-white"></span>
                            <span>{{ submitButtonText }}</span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Features -->
            <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="text-center">
                    <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-4">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                        </svg>
                    </div>
                    <h3 class="font-semibold  mb-2">{{ $t('Secure Payments') }}</h3>
                    <p class="text-sm ">{{ $t('Industry-leading security for all transactions') }}</p>
                </div>
                <div class="text-center">
                    <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mx-auto mb-4">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h3 class="font-semibold  mb-2">{{ $t('Instant Settlement') }}</h3>
                    <p class="text-sm ">{{ $t('Receive payments directly to your wallet') }}</p>
                </div>
                <div class="text-center">
                    <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-4">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="font-semibold  mb-2">{{ $t('Global Reach') }}</h3>
                    <p class="text-sm ">{{ $t('Accept payments from anywhere in the world') }}</p>
                </div>
            </div>
        </div>
    </div>
</app-layout>
