<app-layout>
    <Head>
        <title>{{ $t('Settings') }}</title>
    </Head>

    <merchant-top-menu :label="$t('Settings')"></merchant-top-menu>

    <div class="container mx-auto py-6 merchant-container">
        <div class="max-w-3xl mx-auto">
            <!-- Header -->
            <div class="mb-6">
                <h1 class="text-2xl font-bold ">{{ $t('Settings') }}</h1>
                <p class=" mt-1">{{ $t('Manage your merchant account settings') }}</p>
            </div>

            <!-- Business Info -->
            <div class=" rounded-xl shadow-sm p-6 rounded-card mb-6">
                <h3 class="text-lg font-semibold  mb-4">{{ $t('Business Information') }}</h3>
                <form @submit.prevent="saveSettings">
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Business Name') }}</label>
                            <input
                                v-model="form.business_name"
                                type="text"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input"
                            />
                        </div>
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Business Email') }}</label>
                            <input
                                v-model="form.business_email"
                                type="email"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input"
                            />
                        </div>
                        <div>
                            <label class="block text-sm font-medium  mb-2">{{ $t('Website URL') }}</label>
                            <input
                                v-model="form.website_url"
                                type="url"
                                class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input"
                            />
                        </div>
                    </div>
                    <div class="mt-6">
                        <button
                            type="submit"
                            :disabled="saving"
                            class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50"
                        >
                            {{ saving ? $t('Saving...') : $t('Save Changes') }}
                        </button>
                    </div>
                </form>
            </div>

            <!-- Webhook Settings -->
            <div class=" rounded-xl shadow-sm p-6 rounded-card mb-6">
                <h3 class="text-lg font-semibold  mb-4">{{ $t('Webhook Settings') }}</h3>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium  mb-2">{{ $t('Default Webhook URL') }}</label>
                        <input
                            v-model="form.default_webhook_url"
                            type="url"
                            class="w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 merchant-input"
                            placeholder="https://yoursite.com/webhooks/crypto"
                        />
                        <p class="mt-1 text-sm ">{{ $t('Webhook notifications will be sent to this URL') }}</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium  mb-2">{{ $t('Webhook Secret') }}</label>
                        <div class="flex items-center space-x-3">
                            <input
                                :type="showWebhookSecret ? 'text' : 'password'"
                                :value="merchant.webhook_secret"
                                readonly
                                class="flex-1 px-4 py-3  border rounded-lg font-mono text-sm merchant-input"
                            />
                            <button
                                type="button"
                                @click="showWebhookSecret = !showWebhookSecret"
                                class="p-3 border rounded-lg hover:"
                            >
                                <svg v-if="!showWebhookSecret" class="w-5 h-5 " fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                                </svg>
                                <svg v-else class="w-5 h-5 " fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>
                                </svg>
                            </button>
                            <button
                                type="button"
                                @click="doCopy(merchant.webhook_secret)"
                                class="p-3 border rounded-lg hover:"
                            >
                                <svg class="w-5 h-5 " fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                                </svg>
                            </button>
                        </div>
                        <div class="mt-3">
                            <button
                                type="button"
                                @click="rotateWebhookSecret"
                                :disabled="rotatingSecret"
                                class="text-sm text-red-600 hover:text-red-700"
                            >
                                {{ rotatingSecret ? $t('Rotating...') : $t('Rotate Webhook Secret') }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Account Limits -->
            <div class=" rounded-xl shadow-sm p-6 rounded-card">
                <h3 class="text-lg font-semibold  mb-4">{{ $t('Account Limits') }}</h3>
                <dl class="grid grid-cols-2 gap-6">
                    <div>
                        <dt class="text-sm ">{{ $t('Daily Volume Limit') }}</dt>
                        <dd class="text-xl font-semibold ">${{ merchant.daily_volume_limit_usd.toLocaleString() }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm ">{{ $t('Single Invoice Limit') }}</dt>
                        <dd class="text-xl font-semibold ">${{ merchant.single_invoice_limit_usd.toLocaleString() }}</dd>
                    </div>
                    <div>
                        <dt class="text-sm ">{{ $t('Fee Rate') }}</dt>
                        <dd class="text-xl font-semibold ">{{ merchant.fee_percent }}%</dd>
                    </div>
                    <div>
                        <dt class="text-sm ">{{ $t('Verification Status') }}</dt>
                        <dd>
                            <span :class="['px-3 py-1 rounded-full text-sm font-medium', merchant.verification_status === 'verified' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800']">
                                {{ merchant.verification_status }}
                            </span>
                        </dd>
                    </div>
                </dl>
                <p class="mt-6 text-sm ">{{ $t('Contact support to request limit increases.') }}</p>
            </div>
        </div>
    </div>
</app-layout>
