                        <div class="table-div-body-column-container">
                            <div class="left">
                                <span class="opacity-80">{{ $t('Status')}}</span>
                            </div>
                            <div class="right flex">
                                <template v-if="order.status == 'payment_pending'">
                                    {{ $t('Pending Payment') }}

                                    <div class="flex-icon-orange">
                                        {{ $t('1') }}
                                    </div>
                                </template>
                                <template v-else-if="order.status == 'appealed_by_counterparty'">
                                    {{ $t('Appeal In Progress') }}

                                    <div class="flex-icon-orange">
                                        {{ $t('1') }}
                                    </div>
                                </template>
                                <template v-else-if="order.status == 'confirm_transfer'">
                                    {{ $t('Pending Release') }}

                                    <div class="flex-icon-orange">
                                        {{ $t('1') }}
                                    </div>
                                </template>
                                <template v-else-if="order.status == 'cancelled_by_owner'">
                                    {{ $t('Cancelled By Owner') }}
                                </template>
                                <template v-else-if="order.status == 'cancelled_by_system'">
                                    {{ $t('Cancelled by System') }}
                                </template>
                                <template v-else-if="order.status == 'cancelled_by_counterparty'">
                                    {{ $t('Cancelled by Counterparty') }}
                                </template>
                                <template v-else-if="order.status == 'completed'">
                                    {{ $t('Completed')}}
                                </template>
                            </div>
                        </div>

                        <div class="table-div-body-column-container">
                            <div class="left">
                                <span class="opacity-80">{{ $t('Created Time:')}}</span>
                            </div>
                            <div class="right">
                                <div class="grayed-text">{{ order.created_at }}</div>
                            </div>
                        </div>

                        <div class="table-div-body-column-container">
                            <div class="left">
                                <span class="opacity-80">{{ $t('Actions')}}</span>
                            </div>
                            <div class="right">
                                <div class="div-items-center font-500 mb-1">
                                    <Link as="div" :href="route('p2p.my-order', order.id)" class="action-link">{{ $t('View')}}</Link>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
