                        <div class="flex-grow flex sm:items-center items-start flex-col sm:flex-row w-full-mob" :class="{'pl-6': order.status == 'payment_pending'}">
                            <div class="flex-grow  mt-6 sm:mt-0 mt-mob-no w-full-mob">
                                <template v-if="order.status == 'payment_pending'">
                                    <h2 class="">{{ $t('Notify Seller') }}</h2>
                                </template>


                                <div class="flex w-full p2p-headline-info">
                                    <div class="w-full">

                                        <template v-if="order.status == 'payment_pending'">
                                            <div class="text-headline">{{ $t("After transferring the funds, click on the 'Transferred, notify seller' button.")}}</div>
                                        </template>

                                        <div class="flex lg:w-1/2 gap-2 w-full-mob flex-col-mob">

                                            <template v-if="order.status == 'payment_pending'">

                                                <div class="lg:w-1/2 w-full">
                                                    <t-button-green @click.stop="confirmTransfer()" class="components-filter__button mt-8 py-2 px-6">{{ $t('Transferred, notify seller')}}</t-button-green>
                                                </div>

                                                <div class="lg:w-1/2 w-full">
                                                    <t-button-green @click.stop="showCancelPopup()" class="components-filter__button components-filter__button-cancel mt-8 py-2 px-6">{{ $t('Cancel Order')}}</t-button-green>
                                                </div>

                                            </template>

                                            <template v-if="order.status == 'confirm_transfer'">

                                                <div class="lg:w-1/2 w-full">
                                                    <t-button-green @click.stop="showAppealPopup()" class="components-filter__button mt-8 py-2 px-6" :class="{'button-disabled': !order.appeal_available}">

                                                        <template v-if="order.appeal_available">
                                                            {{ $t('Appeal') }}
                                                        </template>
                                                        <template v-else>
                                                            {{ $t('Appeal after:')}}
                                                            <Countdown :key="refreshKey" :end-time="endTimeCalc(order.appeal_available_after)">
                                                            <span slot="process" slot-scope="{ timeObj }">
                                                                <template v-if="timeObj.h > 0">
                                                                    {{ `${timeObj.h}:${timeObj.m}:${timeObj.s}` }}
                                                                </template>
                                                                <template v-else>
                                                                    {{ `${timeObj.m}:${timeObj.s}` }}
                                                                </template>
                                                            </span><span slot="finish">00:00</span>
                                                            </Countdown>
                                                        </template>
                                                    </t-button-green>
                                                </div>

                                                <div class="lg:w-1/2 w-full">
                                                    <t-button-green @click.stop="showCancelPopup()" class="components-filter__button components-filter__button-cancel mt-8 py-2 px-6">{{ $t('Cancel Order')}}</t-button-green>
                                                </div>

                                            </template>

                                            <template v-if="order.status == 'cancel' || order.status == 'cancelled_by_owner' || order.status == 'cancelled_by_system' || order.status == 'cancelled_by_counterparty' || order.status == 'completed'">
                                                <div v-if="$page.props.user.referral_code == order.user.referral_code" class="lg:w-1/2 w-full">
                                                    <Link :href="route('p2p.profile', order.seller.referral_code)">
                                                    <t-button-green class="components-filter__button mt-2 py-2 px-6">{{ $t('Reorder')}}</t-button-green>
                                                    </Link>
                                                </div>
                                            </template>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </template>
