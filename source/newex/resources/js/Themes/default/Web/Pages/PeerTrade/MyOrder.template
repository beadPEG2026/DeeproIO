                                    <span>{{ $t('Appeal History:') }}</span>
                                    <div class="ml-1">
                                        <Link class="action-link" :href="route('p2p.my-appeal', order.id)">
                                            {{ $t('View records')}}
                                        </Link>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex relative pb-5 w-full">
