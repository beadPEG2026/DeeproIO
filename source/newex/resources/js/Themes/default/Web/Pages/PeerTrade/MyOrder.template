                            <path fill-rule="evenodd" clip-rule="evenodd" d="M10.9393 12L6.9696 15.9697L8.03026 17.0304L12 13.0607L15.9697 17.0304L17.0304 15.9697L13.0607 12L17.0303 8.03039L15.9696 6.96973L12 10.9393L8.03038 6.96973L6.96972 8.03039L10.9393 12Z" />
                        </svg>{{ $t('Account will be restricted if fake payment proof is provided.') }}</li>
                    </ul>
                </div>
                <div id="file-uploader-form" class="file-uploader-form-modal">
                    <VueFileAgent
                        class="profile-pic-upload-block"
                        ref="fileUploadForm"
                        :multiple="true"
                        :deletable="true"
                        :meta="false"
                        :maxFiles="5"
                        :accept="'image/*,video/*,.pdf'"
                        :helpText="'Drag an image file here'"
                        :errorText="{type: 'Please select an image'}"
                        v-model="fileRecords"
                        @select="onSelect($event)"
                        @upload="onUpload($event)"
                        @beforedelete="onDelete($event)"
                    >

                    </VueFileAgent>
                </div>
                <div class="text-red-600 mb-3" v-if="appealErrors">
                    {{ appealErrors }}
                </div>
            </div>


        </div>
    </template>

    <template #footer>

        <jet-button class="ml-2" @click.native="appealOrder">
            {{ $t('Send Appeal') }}
        </jet-button>
    </template>
</jet-dialog-modal>

<jet-dialog-modal :max-width="'4xl'" :show="showFeedbackOrder" @close="showFeedbackOrder = null">
    <template #title>
        {{ $t('Feedback')}}
    </template>
    <template #content>
        <div class="p2p-order-feedback-modal">

            <div class="p2p-order-feedback-headline">{{ $t('How was your trading experience?')}}</div>

            <div class="p2p-order-feedback-actions">
                <button @click="leaveFeedback(true)" class="btn-large mr-2" :class="{'btn-large-green': showFeedbackType}">
                    <div class="mr-2"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="bn-svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M8 9.723l3.444-3.391V3.01h.888a3.106 3.106 0 013.106 3.105v1.673H21v6.425a4.778 4.778 0 01-4.778 4.778H8V9.723zm-2-.038H3v9.306h3V9.685z" fill="currentColor"></path></svg></div>
                    <div class="btnLink2 no-underline">{{ $t('Positive')}}</div>
                </button>
                <button @click="leaveFeedback(false)" class="btn-large" :class="{'btn-large-red': !showFeedbackType}">
                    <div class="mr-2"><svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class="bn-svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M8 14.268l3.444 3.392v3.321h.888a3.106 3.106 0 003.106-3.105v-1.673H21V9.778A4.778 4.778 0 0016.222 5H8v9.268zm-2 .039H3V5h3v9.306z" fill="currentColor"></path></svg></div>
                    <div class="btnLink2 no-underline">{{ $t('Negative')}}</div>
                </button>
            </div>
            <div class="p2p-order-feedback-body">
                <textarea v-model="feedbackForm.content"></textarea>

                <div class="form-components__block">
                    <div class="block-checkbox__group">
                        <jet-checkbox id="p2p-popup-feedback-anonymous" :value="1" v-model="feedbackForm.is_anonymous"/>
                        <label for="p2p-popup-feedback-anonymous" class="form-components__block-label">
                            <div>{{ $t('Anonymous') }}</div>
                            <small>
                                <template v-if="feedbackForm.is_anonymous">
                                    {{ $t('Your comment will be displayed anonymously')}}
                                </template>
                                <template v-else>
                                    {{ $t('By selecting this, your comment will be displayed anonymously')}}
                                </template>
                            </small>
                        </label>
                    </div>
                </div>
            </div>

        </div>
    </template>

    <template #footer>

        <jet-button class="ml-2" @click.native="submitFeedback">
            {{ $t('Leave comments') }}
        </jet-button>
    </template>
</jet-dialog-modal>

<jet-dialog-modal :show="showMethods" @close="closeMethods">
    <template #title>
        {{ $t('Select Payment Methods')}}
    </template>
    <template #content>
        <div class="payment-method-wrapper-modal">

            <div class="checkbox-select-group" v-if="paymentMethods" v-for="method in paymentMethods">
                <label class="" @click="confirmMethod(method)">
                    <div class="flex items-center justify-between p2p-payment-method-card-mini-head">
                            <span class="ml-2 text-sm text-gray-600 flex">
                                <div class="payment-method-label blue"></div>
                                <div class="payment-method-title">{{ method.name }}</div>
                            </span>
                    </div>
                    <div class="p2p-payment-method-card p2p-payment-method-card-mini">
                        <div v-for="fields in method.fields" class="p2p-payment-method-card-element ">
                            <div class="p2p-payment-method-card-left headline-text">{{ $t(fields.field)}}</div>
                            <div class="p2p-payment-method-card-right">
                                {{ fields.content }}
                            </div>
                        </div>
                    </div>
                </label>
            </div>
        </div>
    </template>
</jet-dialog-modal>
</app-layout>
