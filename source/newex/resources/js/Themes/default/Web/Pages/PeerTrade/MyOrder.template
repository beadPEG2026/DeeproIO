                                    <template v-if="order.status == 'payment_pending'">
                                        {{ $t('Order Created, Pay the Seller within') }}

                                            <Countdown :end-time="endTimeCalc(order.cancel_order_after)">
                                                            <span slot="process" slot-scope="{ timeObj }">
                                                                <template v-if="timeObj.h > 0">
                                                                    {{ `${timeObj.h}:${timeObj.m}:${timeObj.s}` }}
                                                                </template>
                                                                <template v-else>
                                                                    {{ `${timeObj.m}:${timeObj.s}` }}
                                                                </template>
                                                            </span><span slot="finish">00:00</span>
                                            </Countdown>

                                    </template>
                                    <template v-if="order.status == 'confirm_transfer'">
                                        {{ $t('The coins will be released in') }}
                                        <Countdown :key="refreshKey" :end-time="endTimeCalc(order.appeal_available_after)">
                                            <span slot="process" slot-scope="{ timeObj }">
                                                <template v-if="timeObj.h > 0">
                                                    {{ `${timeObj.h}:${timeObj.m}:${timeObj.s}` }}
                                                </template>
                                                <template v-else>
                                                    {{ `${timeObj.m}:${timeObj.s}` }}
                                                </template>
                                            </span><span slot="finish">00:00</span>
                                        </Countdown>
                                    </template>
                                    <template v-if="order.status == 'completed'">
                                        {{ $t('Order Completed') }}
                                    </template>
                                    <template v-if="order.cancelledBySystem">
                                        {{ $t('The Order Has Been Cancelled By System') }}
                                    </template>
                                    <template v-if="order.status == 'cancelled_by_counterparty'">
                                        <template v-if="order.cancelledByOwner">
                                            {{ $t('You Have Canceled the Order') }}
                                        </template>
                                        <template v-else>
                                            {{ $t('The Order Has Been Cancelled By Counterparty') }}
                                        </template>
                                    </template>
                                    <template v-if="order.status == 'appealed_by_counterparty'">
                                        {{ $t('Appeal in progress.') }} <Link class="action-link" :href="route('p2p.my-appeal', order.id)">{{ $t('View') }}</Link>
                                    </template>
                                    <template v-if="order.status == 'cancelled_by_owner'">
                                        <template v-if="order.cancelledByOwner">
                                            {{ $t('You Have Canceled the Order') }}
                                        </template>
                                        <template v-else>
                                            {{ $t('The Order Has Been Cancelled By Counterparty') }}
                                        </template>
                                    </template>
                                    <template v-if="order.status == 'cancelled_by_system'">
                                        {{ $t('The Order Has Been Cancelled By System') }}
                                    </template>
                                </div>
                                <div class="order-info-container-subtitle flex">
                                    <span>{{ $t('Order Number:') }}</span>
                                    <div class="ml-1">{{ order.id }}</div>
                                    <div @click="doCopy(order.id)" class="copy-icon">
                                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <rect class="list-text__icon-color" x="1" y="2" width="17" height="16" rx="2"/>
