                                    <div class="w-full mt-5">
                                        <div class="text-headline">{{ $t('Time Created')}}</div>
                                        <div class="text-bottom">{{ order.created_at }}</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex relative pb-5 "  :class="{'pt-10 pt-5': order.status == 'payment_pending'}">
