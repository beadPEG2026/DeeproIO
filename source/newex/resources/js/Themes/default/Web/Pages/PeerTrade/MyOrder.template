                                        <div class="text-bottom">{{ order.price }} {{ order.quoteSymbol }}</div>
                                    </div>
                                    <div class="w-full mt-5">
                                        <div class="text-headline">{{ $t('Crypto Amount')}}</div>
                                        <div class="text-bottom">{{ order.amount }} {{ order.baseSymbol }}</div>
                                    </div>

                                    <div class="w-full mt-5">
                                        <div class="text-headline">{{ $t('Processing Fee')}}</div>
                                        <div class="text-bottom">{{ order.fee_taker }} {{ order.baseSymbol }}</div>
