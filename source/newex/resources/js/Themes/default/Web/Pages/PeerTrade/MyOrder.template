                            <div class="flex-grow  mt-6 sm:mt-0 mt-mob-no w-full-mob">
                                <h2 v-if="order.status == 'payment_pending' || order.status == 'confirm_transfer'">{{ $t('Order Created') }}</h2>

                                <div class="flex w-full p2p-headline-info p2p-payment-method-card flex-col" :class="{'no-mt': order.status !== 'payment_pending' || order.status == 'confirm_transfer'}">
