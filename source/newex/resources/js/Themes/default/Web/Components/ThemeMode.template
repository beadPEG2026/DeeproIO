<div class="dp-theme-toggle"><span class="dp-theme-toggle__label">{{ $t(isDarkTheme ? 'Dark' : 'Light') }}</span><button type="button" :aria-label="$t(isDarkTheme ? 'Switch to light theme' : 'Switch to dark theme')" :aria-pressed="isDarkTheme" :disabled="saving" :aria-busy="saving" @click="setThemeMode(isDarkTheme ? 'light' : 'dark')" class="dp-theme-switch"></button><span v-if="saving" role="status">{{ $i18n.locale.startsWith('zh') ? '保存中…' : 'Saving…' }}</span></div>
